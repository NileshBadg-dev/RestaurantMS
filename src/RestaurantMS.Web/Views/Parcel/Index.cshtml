@model RestaurantMS.Web.Models.ParcelListViewModel
@{
    ViewData["Title"] = Localizer["Parcel_Title"].Value;
}

<div class="parcel-page d-flex flex-column gap-3">
    <!-- Header with KPI Badges -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-box-seam text-saffron me-2"></i> @Localizer["Parcel_Title"]</h2>
                <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                    <span class="text-saffron"><strong class="badge bg-warning-subtle text-dark">@Model.TotalPreparing Preparing</strong></span>
                    <span class="text-teal"><strong class="badge bg-teal-subtle text-teal">@Model.TotalReady Ready for Pickup</strong></span>
                    <span class="text-muted"><strong class="badge bg-secondary-subtle text-dark">@Model.TotalDeliveredToday Handed Over</strong></span>
                    <span>&bull;</span>
                    <span class="fw-bold text-plum font-monospace">Today's Sales: ₹@Model.TotalParcelSalesToday.ToString("N0")</span>
                </div>
            </div>

            <a asp-action="Create" class="btn btn-plum px-3 py-2 fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> New Parcel <span class="badge bg-saffron text-dark ms-1">F4</span>
            </a>
        </div>
    </div>

    <!-- Active Parcels Grid -->
    <div class="row g-3">
        @foreach (var parcel in Model.ActiveParcels)
        {
            var isReady = parcel.Status.Equals("Ready", StringComparison.OrdinalIgnoreCase);
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-header @(isReady ? "bg-teal-subtle text-teal" : "bg-warning-subtle text-dark") py-3 px-3 d-flex justify-content-between align-items-center rounded-top">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(isReady ? "bg-teal" : "bg-saffron") text-white font-monospace fs-6">@parcel.TokenNo</span>
                            <span class="fw-bold text-ink">@parcel.CustomerName</span>
                        </div>
                        <span class="badge bg-white text-dark border">
                            <i class="bi bi-clock me-1"></i>@parcel.OrderedTime
                        </span>
                    </div>

                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="mb-3">
                            <div class="text-muted small mb-2"><i class="bi bi-telephone me-1"></i>@parcel.CustomerMobile</div>
                            <div class="small fw-semibold text-ink mb-1">Items:</div>
                            <div class="small text-muted bg-light p-2 rounded">@parcel.ItemsSummary</div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <div>
                                <span class="small text-muted">Bill:</span>
                                <span class="fw-bold text-plum font-monospace fs-6">₹@parcel.Amount.ToString("N2")</span>
                            </div>

                            @if (isReady)
                            {
                                <button type="button" class="btn btn-sm btn-teal text-white fw-bold px-3 py-2" onclick="alert('Parcel @parcel.TokenNo handed over to customer!')">
                                    <i class="bi bi-check-lg me-1"></i> Deliver
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-teal fw-semibold px-3 py-2" onclick="alert('Marked Ready!')">
                                    <i class="bi bi-bell me-1"></i> Mark Ready
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
