@model RestaurantMS.Web.Models.CreateParcelViewModel
@{
    ViewData["Title"] = Localizer["Parcel_Create_Title"].Value;
}

<div class="parcel-create-page" style="max-width: 900px; margin: 0 auto;">
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h3 class="h4 fw-bold text-ink mb-1"><i class="bi bi-box-seam text-saffron me-2"></i> @Localizer["Parcel_Create_Title"]</h3>
                <div class="text-muted small">Enter customer details and pack items for takeaway / delivery</div>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Parcels
            </a>
        </div>

        <form asp-action="Create" method="post" id="createParcelForm">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label asp-for="CustomerName" class="form-label fw-bold small text-ink">Customer Name *</label>
                    <input asp-for="CustomerName" class="form-control" placeholder="e.g. Anand Shinde" required />
                    <span asp-validation-for="CustomerName" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="MobileNumber" class="form-label fw-bold small text-ink">Mobile Number *</label>
                    <mobile-input asp-for="MobileNumber" />
                    <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="OrderType" class="form-label fw-bold small text-ink">Parcel Type</label>
                    <select asp-for="OrderType" class="form-select">
                        <option value="Takeaway">Self Pickup (Takeaway)</option>
                        <option value="Delivery">Home Delivery</option>
                    </select>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="PaymentMode" class="form-label fw-bold small text-ink">Payment Mode</label>
                    <select asp-for="PaymentMode" class="form-select">
                        <option value="Cash">Cash</option>
                        <option value="UPI">UPI / QR Code</option>
                        <option value="Card">Card</option>
                        <option value="Credit">Udhari (Credit)</option>
                    </select>
                </div>

                <div class="col-12">
                    <label asp-for="DeliveryAddress" class="form-label fw-bold small text-ink">Delivery Address / Landmark (Optional)</label>
                    <input asp-for="DeliveryAddress" class="form-control" placeholder="Flat / Building, Road, Area" />
                </div>

                <div class="col-12">
                    <label asp-for="Notes" class="form-label fw-bold small text-ink">Special Kitchen / Packing Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="e.g. Extra chutney, less spicy, separate sambar"></textarea>
                </div>
            </div>

            <div class="border-top pt-3 d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                <button type="submit" class="btn btn-teal text-white px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-printer me-2"></i> Create &amp; Print Token <span class="badge bg-white text-teal ms-1">F4</span>
                </button>
            </div>
        </form>
    </div>
</div>
