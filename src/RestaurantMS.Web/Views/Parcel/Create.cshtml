@model RestaurantMS.Web.Models.CreateParcelViewModel
@{
    ViewData["Title"] = Localizer["Parcel_Create_Title"].Value;
}

<div class="mx-auto" style="max-width: 820px;">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <form asp-action="Create" method="post" id="createParcelForm" data-app-form="true" novalidate>
            @Html.AntiForgeryToken()

            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 js-form-error-summary @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="mb-0"></div> }
            </div>

            <div class="mb-4">
                <partial name="_FormSection" model='new RestaurantMS.Web.Models.FormSectionModel { Title = Localizer["Parcel_Create_Title"].Value, HelperText = "Customer contact, order channel and payment preference", Icon = "bi-box-seam" }' />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold small text-ink mb-1">Order Type <span class="text-chili">*</span></label>
                        <div class="app-segmented-control">
                            <div class="seg-option">
                                <input type="radio" name="OrderType" id="parcelTakeaway" value="Takeaway" checked="@(Model.OrderType != "Delivery" ? "checked" : null)" />
                                <label for="parcelTakeaway"><i class="bi bi-bag-check"></i> Self Pickup (Takeaway)</label>
                            </div>
                            <div class="seg-option">
                                <input type="radio" name="OrderType" id="parcelDelivery" value="Delivery" checked="@(Model.OrderType == "Delivery" ? "checked" : null)" />
                                <label for="parcelDelivery"><i class="bi bi-bicycle"></i> Home Delivery</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="CustomerName" class="form-label fw-semibold small text-ink mb-1">Customer Name <span class="text-chili">*</span></label>
                        <input asp-for="CustomerName" class="form-control" placeholder="e.g. Anand Shinde" required />
                        <span asp-validation-for="CustomerName" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="MobileNumber" class="form-label fw-semibold small text-ink mb-1">Mobile Number <span class="text-chili">*</span></label>
                        <input asp-for="MobileNumber" class="form-control" placeholder="10-digit mobile" pattern="^[6-9]\d{9}$" maxlength="10" required />
                        <span asp-validation-for="MobileNumber" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="PaymentMode" class="form-label fw-semibold small text-ink mb-1">Payment Mode</label>
                        <select asp-for="PaymentMode" class="form-select">
                            <option value="Cash">Cash</option>
                            <option value="UPI">UPI / QR Code</option>
                            <option value="Card">Card</option>
                            <option value="Credit">Udhari (Credit)</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="DeliveryAddress" class="form-label fw-semibold small text-ink mb-1">Delivery Address / Landmark</label>
                        <input asp-for="DeliveryAddress" class="form-control" placeholder="Flat / Building, Road, Area" />
                    </div>
                    <div class="col-12 app-form-field">
                        <label asp-for="Notes" class="form-label fw-semibold small text-ink mb-1">Special Kitchen / Packing Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="e.g. Extra chutney, less spicy, separate sambar"></textarea>
                    </div>
                </div>
            </div>

            <partial name="_FormFooter" model='new RestaurantMS.Web.Models.FormFooterModel { CancelUrl = Url.Action("Index", "Parcel")!, SaveLabelKey = "Common_Save", ShowSaveAndNew = true, PrimaryButtonIcon = "bi-printer" }' />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
