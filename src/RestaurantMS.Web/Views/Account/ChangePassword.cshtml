@model RestaurantMS.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = Localizer["ChangePassword_Title"].Value;
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark">@Localizer["ChangePassword_Title"]</h5>
                <p class="text-muted small mb-0">@Localizer["ChangePassword_Subtitle"]</p>
            </div>
            <div class="card-body p-4">
                @if (Model.ForcedChange)
                {
                    <div class="alert alert-warning small mb-3">
                        <i class="bi bi-shield-exclamation me-1"></i> You are logging in with a temporary password and must set a new password before proceeding.
                    </div>
                }

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        @ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage
                    </div>
                }

                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ForcedChange" />

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold small text-secondary">@Localizer["Current Password"]</label>
                        <input asp-for="CurrentPassword" class="form-control" type="password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold small text-secondary">@Localizer["New Password"]</label>
                        <input asp-for="NewPassword" class="form-control" type="password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="form-text small">At least 8 characters with uppercase, lowercase, and a number.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-secondary">@Localizer["Confirm New Password"]</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        @if (!Model.ForcedChange)
                        {
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">@Localizer["Btn_Cancel"]</a>
                        }
                        <button type="submit" class="btn btn-primary btn-sm px-4">@Localizer["Btn_Save"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
