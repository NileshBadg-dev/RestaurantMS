@model RestaurantMS.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = Localizer["ForgotPassword_Title"].Value;
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="card shadow border-0" style="max-width: 440px; width: 100%;">
        <div class="card-body p-4 p-sm-5">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock fs-1 text-primary mb-2"></i>
                <h2 class="h5 fw-bold text-dark">@Localizer["ForgotPassword_Title"]</h2>
                <p class="text-muted small">@Localizer["ForgotPassword_Subtitle"]</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-info py-2 px-3 small mb-4">
                    <i class="bi bi-info-circle-fill me-1"></i> @Model.Message
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="UserId" class="form-label fw-semibold small text-secondary">@Localizer["Login_UserId"]</label>
                    <input asp-for="UserId" class="form-control" placeholder="admin" autofocus />
                    <span asp-validation-for="UserId" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-3">
                    @Localizer["Btn_Submit"]
                </button>

                <div class="text-center">
                    <a asp-action="Login" class="text-decoration-none small text-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
