@{
    ViewData["Title"] = Localizer["AccessDenied_Title"].Value;
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-sm p-4 p-md-5">
            <div class="mb-3 text-danger">
                <i class="bi bi-shield-x" style="font-size: 4rem;"></i>
            </div>
            <h2 class="h4 fw-bold text-dark mb-2">@Localizer["AccessDenied_Title"]</h2>
            <p class="text-muted mb-4">@Localizer["AccessDenied_Message"]</p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm px-4">
                    <i class="bi bi-house-door me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
