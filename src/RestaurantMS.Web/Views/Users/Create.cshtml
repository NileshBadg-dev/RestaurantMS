@model RestaurantMS.Web.Models.CreateUserViewModel
@{
    ViewData["Title"] = Localizer["Users_CreateNew"].Value;
}

<div class="mx-auto" style="max-width: 780px;">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <form asp-action="Create" method="post" data-app-form="true" novalidate>
            @Html.AntiForgeryToken()

            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 js-form-error-summary @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="mb-0"></div> }
            </div>

            <div class="mb-4">
                <partial name="_FormSection" model='new RestaurantMS.Web.Models.FormSectionModel { Title = Localizer["Users_CreateNew"].Value, HelperText = "Create a login account and assign a permission role", Icon = "bi-person-gear" }' />
                <div class="row g-3">
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="UserId" class="form-label fw-semibold small text-ink mb-1">User ID <span class="text-chili">*</span></label>
                        <input asp-for="UserId" class="form-control font-monospace" placeholder="e.g. john12" required />
                        <span asp-validation-for="UserId" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="FullName" class="form-label fw-semibold small text-ink mb-1">Full Name <span class="text-chili">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" required />
                        <span asp-validation-for="FullName" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="Email" class="form-label fw-semibold small text-ink mb-1">Email <span class="text-chili">*</span></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="john@example.com" required />
                        <span asp-validation-for="Email" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold small text-ink mb-1">Mobile Number <span class="text-chili">*</span></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="10-digit mobile" pattern="^[6-9]\d{9}$" maxlength="10" required />
                        <span asp-validation-for="PhoneNumber" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="RoleId" class="form-label fw-semibold small text-ink mb-1">Role <span class="text-chili">*</span></label>
                        <select asp-for="RoleId" class="form-select" required>
                            <option value="">-- Select Role --</option>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role.Id">@role.Name</option>
                            }
                        </select>
                        <span asp-validation-for="RoleId" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="Password" class="form-label fw-semibold small text-ink mb-1">Initial Password <span class="text-chili">*</span></label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Min 8 chars (Aa1)" required />
                        <div class="form-text small">Min 8 chars, 1 uppercase, 1 lowercase, 1 digit.</div>
                        <span asp-validation-for="Password" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                </div>
            </div>

            <partial name="_FormFooter" model='new RestaurantMS.Web.Models.FormFooterModel { CancelUrl = Url.Action("Index", "Users")!, ShowSaveAndNew = false }' />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
