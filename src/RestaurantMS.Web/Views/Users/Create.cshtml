@model RestaurantMS.Web.Models.CreateUserViewModel
@{
    ViewData["Title"] = Localizer["Users_CreateNew"].Value;
}

<div class="row justify-content-center py-3">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">@Localizer["Users_CreateNew"]</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["Btn_Back"]</a>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        @ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage
                    </div>
                }

                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="UserId" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="UserId" class="form-control" placeholder="e.g. john12" />
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="john@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="10 digits e.g. 9876543210" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="RoleId" class="form-label fw-semibold small text-secondary"></label>
                            <select asp-for="RoleId" class="form-select">
                                <option value="">-- Select Role --</option>
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <option value="@role.Id">@role.Name</option>
                                }
                            </select>
                            <span asp-validation-for="RoleId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold small text-secondary"></label>
                            <input asp-for="Password" class="form-control" type="password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="form-text small">Min 8 chars, 1 uppercase, 1 lowercase, 1 digit.</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">@Localizer["Btn_Cancel"]</a>
                        <button type="submit" class="btn btn-primary btn-sm px-4">@Localizer["Btn_Save"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
