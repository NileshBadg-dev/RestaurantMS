@model RestaurantMS.Web.Models.EditUserViewModel
@{
    ViewData["Title"] = Localizer["Users_EditUser"].Value;
}

<div class="mx-auto" style="max-width: 780px;">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <form asp-action="Edit" method="post" data-app-form="true" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />

            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 js-form-error-summary @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="mb-0"></div> }
            </div>

            <div class="mb-4">
                <partial name="_FormSection" model='new RestaurantMS.Web.Models.FormSectionModel { Title = $"{Localizer["Users_EditUser"].Value}: {Model.UserId}", HelperText = "Update user contact details and assigned role", Icon = "bi-person-gear" }' />
                <div class="row g-3">
                    <div class="col-12 col-md-6 app-form-field">
                        <label class="form-label fw-semibold small text-ink mb-1">User ID</label>
                        <input class="form-control font-monospace bg-light" value="@Model.UserId" readonly />
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="FullName" class="form-label fw-semibold small text-ink mb-1">Full Name <span class="text-chili">*</span></label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="Email" class="form-label fw-semibold small text-ink mb-1">Email <span class="text-chili">*</span></label>
                        <input asp-for="Email" class="form-control" type="email" required />
                        <span asp-validation-for="Email" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold small text-ink mb-1">Mobile Number <span class="text-chili">*</span></label>
                        <input asp-for="PhoneNumber" class="form-control" pattern="^[6-9]\d{9}$" maxlength="10" required />
                        <span asp-validation-for="PhoneNumber" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="RoleId" class="form-label fw-semibold small text-ink mb-1">Role <span class="text-chili">*</span></label>
                        <select asp-for="RoleId" class="form-select" required>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role.Id">@role.Name</option>
                            }
                        </select>
                        <span asp-validation-for="RoleId" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-3 border bg-cream-soft d-flex align-items-center justify-content-between h-100">
                            <label class="form-label fw-semibold small text-ink mb-0" for="statusSwitch">@(Model.IsActive ? "Account Active" : "Account Inactive")</label>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="statusSwitch" checked="@(Model.IsActive ? "checked" : null)" disabled />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <partial name="_FormFooter" model='new RestaurantMS.Web.Models.FormFooterModel { CancelUrl = Url.Action("Index", "Users")!, ShowSaveAndNew = false }' />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
