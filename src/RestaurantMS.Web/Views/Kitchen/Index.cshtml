@model RestaurantMS.Web.Models.KitchenDisplayViewModel
@{
    ViewData["Title"] = Localizer["Kitchen_Title"].Value;
}

<div class="kitchen-display-page d-flex flex-column gap-3">
    <!-- Header with Station Filter & Auto-refresh Countdown -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <h2 class="h4 fw-bold text-ink mb-0"><i class="bi bi-fire text-chili me-2"></i> @Localizer["Kitchen_Title"]</h2>
                <span class="badge bg-plum text-white px-3 py-2 rounded-pill">
                    <i class="bi bi-arrow-repeat me-1 spinner-grow spinner-grow-sm" style="animation-duration: 2s;"></i>
                    Auto-refresh: <span id="refreshTimer">15</span>s
                </span>
            </div>

            <!-- Station Filter Pills -->
            <div class="d-flex gap-2 overflow-x-auto">
                <a asp-action="Index" asp-route-station="All" class="btn btn-sm @(Model.SelectedStation == "All" ? "btn-plum" : "btn-light border") rounded-pill px-3">
                    All Stations
                </a>
                <a asp-action="Index" asp-route-station="Tandoor" class="btn btn-sm @(Model.SelectedStation == "Tandoor" ? "btn-plum" : "btn-light border") rounded-pill px-3">
                    Tandoor
                </a>
                <a asp-action="Index" asp-route-station="Curry" class="btn btn-sm @(Model.SelectedStation == "Curry" ? "btn-plum" : "btn-light border") rounded-pill px-3">
                    Curry &amp; Rice
                </a>
                <a asp-action="Index" asp-route-station="Chinese" class="btn btn-sm @(Model.SelectedStation == "Chinese" ? "btn-plum" : "btn-light border") rounded-pill px-3">
                    Chinese &amp; Fast Food
                </a>
                <a asp-action="Index" asp-route-station="Beverages" class="btn btn-sm @(Model.SelectedStation == "Beverages" ? "btn-plum" : "btn-light border") rounded-pill px-3">
                    Beverages
                </a>
            </div>
        </div>
    </div>

    <!-- 3 Columns Kanban Board -->
    <div class="row g-3 kitchen-board-row">
        <!-- COLUMN 1: NEW TICKETS (Soft Lavender #EFEBF5) -->
        <div class="col-12 col-md-4">
            <div class="kitchen-column card border-0 shadow-sm rounded-3 h-100 bg-light">
                <div class="kitchen-col-header p-3 rounded-top d-flex justify-content-between align-items-center" style="background-color: var(--color-lavender-soft, #EFEBF5); border-bottom: 2px solid #D1C4E9;">
                    <span class="fw-bold text-plum fs-6 text-uppercase">
                        <i class="bi bi-bell-fill me-1 text-plum"></i> New Tickets
                    </span>
                    <span class="badge bg-plum text-white px-2 py-1 fs-6">@Model.DisplayData.NewTickets.Count</span>
                </div>

                <div class="kitchen-tickets-list p-3 d-flex flex-column gap-3 overflow-y-auto" style="max-height: calc(100vh - 220px);">
                    @foreach (var ticket in Model.DisplayData.NewTickets)
                    {
                        <div class="card border-0 shadow-sm rounded-3 ticket-card bg-white">
                            <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold text-plum font-monospace fs-6">@ticket.KotNumber</span>
                                    <div class="badge @(ticket.IsParcel ? "bg-warning-subtle text-dark" : "bg-plum-subtle text-plum") ms-2">
                                        @ticket.TableOrTakeaway
                                    </div>
                                </div>
                                <span class="badge bg-light text-muted border small">
                                    <i class="bi bi-clock me-1"></i>@ticket.ElapsedFormatted
                                </span>
                            </div>

                            <div class="card-body p-3">
                                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                    @foreach (var item in ticket.Items)
                                    {
                                        <li class="d-flex align-items-start justify-content-between">
                                            <div>
                                                <span class="badge bg-plum text-white me-2">@(item.Quantity)x</span>
                                                <span class="fw-semibold text-ink">@item.ItemName</span>
                                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                                {
                                                    <div class="small text-danger ms-4"><i class="bi bi-exclamation-circle me-1"></i>@item.Notes</div>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="card-footer bg-light border-top p-2">
                                <form asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ticketId" value="@ticket.TicketId" />
                                    <input type="hidden" name="newStatus" value="Preparing" />
                                    <button type="submit" class="btn btn-sm btn-saffron text-dark w-100 fw-bold py-2">
                                        <i class="bi bi-play-fill me-1"></i> Start Cooking
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                    @if (Model.DisplayData.NewTickets.Count == 0)
                    {
                        <div class="text-center py-5 text-muted small">
                            <i class="bi bi-check2-all display-6 text-teal mb-2 d-block"></i>
                            No new tickets in queue
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- COLUMN 2: PREPARING TICKETS (Soft Saffron #FFF3E0) -->
        <div class="col-12 col-md-4">
            <div class="kitchen-column card border-0 shadow-sm rounded-3 h-100 bg-light">
                <div class="kitchen-col-header p-3 rounded-top d-flex justify-content-between align-items-center" style="background-color: var(--color-saffron-soft, #FFF3E0); border-bottom: 2px solid #FFE0B2;">
                    <span class="fw-bold text-dark fs-6 text-uppercase">
                        <i class="bi bi-fire me-1 text-saffron"></i> Preparing
                    </span>
                    <span class="badge bg-saffron text-dark px-2 py-1 fs-6">@Model.DisplayData.PreparingTickets.Count</span>
                </div>

                <div class="kitchen-tickets-list p-3 d-flex flex-column gap-3 overflow-y-auto" style="max-height: calc(100vh - 220px);">
                    @foreach (var ticket in Model.DisplayData.PreparingTickets)
                    {
                        var isLate = ticket.IsLate;
                        <div class="card border-0 shadow-sm rounded-3 ticket-card bg-white @(isLate ? "border-start border-4 border-danger" : "")">
                            <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold text-plum font-monospace fs-6">@ticket.KotNumber</span>
                                    <div class="badge @(ticket.IsParcel ? "bg-warning-subtle text-dark" : "bg-plum-subtle text-plum") ms-2">
                                        @ticket.TableOrTakeaway
                                    </div>
                                </div>
                                <span class="badge @(isLate ? "bg-chili text-white animate-pulse" : "bg-warning-subtle text-dark") px-2 py-1">
                                    <i class="bi bi-stopwatch me-1"></i>@ticket.ElapsedFormatted @(isLate ? "LATE" : "")
                                </span>
                            </div>

                            <div class="card-body p-3">
                                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                    @foreach (var item in ticket.Items)
                                    {
                                        <li class="d-flex align-items-start justify-content-between">
                                            <div>
                                                <span class="badge bg-saffron text-dark me-2">@(item.Quantity)x</span>
                                                <span class="fw-semibold text-ink">@item.ItemName</span>
                                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                                {
                                                    <div class="small text-danger ms-4"><i class="bi bi-exclamation-circle me-1"></i>@item.Notes</div>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="card-footer bg-light border-top p-2 d-flex gap-2">
                                <form asp-action="UpdateStatus" method="post" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ticketId" value="@ticket.TicketId" />
                                    <input type="hidden" name="newStatus" value="Ready" />
                                    <button type="submit" class="btn btn-sm btn-teal text-white w-100 fw-bold py-2">
                                        <i class="bi bi-check2-circle me-1"></i> Mark Ready
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                    @if (Model.DisplayData.PreparingTickets.Count == 0)
                    {
                        <div class="text-center py-5 text-muted small">
                            <i class="bi bi-cup-hot display-6 text-saffron mb-2 d-block"></i>
                            Nothing currently cooking
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- COLUMN 3: READY TICKETS (Soft Teal #E0F2F1) -->
        <div class="col-12 col-md-4">
            <div class="kitchen-column card border-0 shadow-sm rounded-3 h-100 bg-light">
                <div class="kitchen-col-header p-3 rounded-top d-flex justify-content-between align-items-center" style="background-color: var(--color-teal-soft, #E0F2F1); border-bottom: 2px solid #B2DFDB;">
                    <span class="fw-bold text-teal fs-6 text-uppercase">
                        <i class="bi bi-check-circle-fill me-1 text-teal"></i> Ready for Pickup
                    </span>
                    <span class="badge bg-teal text-white px-2 py-1 fs-6">@Model.DisplayData.ReadyTickets.Count</span>
                </div>

                <div class="kitchen-tickets-list p-3 d-flex flex-column gap-3 overflow-y-auto" style="max-height: calc(100vh - 220px);">
                    @foreach (var ticket in Model.DisplayData.ReadyTickets)
                    {
                        <div class="card border-0 shadow-sm rounded-3 ticket-card bg-white">
                            <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold text-teal font-monospace fs-6">@ticket.KotNumber</span>
                                    <div class="badge bg-teal-subtle text-teal ms-2">
                                        @ticket.TableOrTakeaway
                                    </div>
                                </div>
                                <span class="badge bg-light text-muted border small">
                                    <i class="bi bi-bell me-1"></i>Waiter Notified
                                </span>
                            </div>

                            <div class="card-body p-3">
                                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                    @foreach (var item in ticket.Items)
                                    {
                                        <li class="d-flex align-items-start justify-content-between">
                                            <div>
                                                <span class="badge bg-teal text-white me-2">@(item.Quantity)x</span>
                                                <span class="fw-semibold text-ink">@item.ItemName</span>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="card-footer bg-light border-top p-2 d-flex gap-2">
                                <form asp-action="UpdateStatus" method="post" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ticketId" value="@ticket.TicketId" />
                                    <input type="hidden" name="newStatus" value="Served" />
                                    <button type="submit" class="btn btn-sm btn-plum text-white w-100 fw-bold py-2">
                                        <i class="bi bi-hand-thumbs-up me-1"></i> Served / Packed
                                    </button>
                                </form>
                                <form asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ticketId" value="@ticket.TicketId" />
                                    <input type="hidden" name="newStatus" value="Preparing" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary py-2" title="Recall back to cooking">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                    @if (Model.DisplayData.ReadyTickets.Count == 0)
                    {
                        <div class="text-center py-5 text-muted small">
                            <i class="bi bi-inbox display-6 text-muted mb-2 d-block"></i>
                            No orders waiting for pickup
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let remainingSeconds = @Model.AutoRefreshSeconds;
const timerEl = document.getElementById("refreshTimer");

setInterval(() => {
    remainingSeconds--;
    if (timerEl) {
        timerEl.textContent = remainingSeconds;
    }
    if (remainingSeconds <= 0) {
        location.reload();
    }
}, 1000);
</script>
