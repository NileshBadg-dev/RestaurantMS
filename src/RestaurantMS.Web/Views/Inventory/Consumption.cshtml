@model RestaurantMS.Web.Models.StockConsumptionViewModel
@{
    ViewData["Title"] = Localizer["Nav_Consumption"].Value;
    var todayStr = DateTime.UtcNow.AddHours(5).AddMinutes(30).ToString("yyyy-MM-dd");
}

<div class="mx-auto d-flex flex-column gap-4" style="max-width: 920px;" id="inventoryModuleRoot">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-fire text-teal me-2"></i> @Localizer["Nav_Consumption"]</h2>
                <div class="text-muted small">@Localizer["Inventory_ConsumptionSubtitle"]</div>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> @Localizer["Nav_StockSummary"]
            </a>
        </div>

        <form method="post" asp-action="Consumption" data-app-form="true" novalidate>
            @Html.AntiForgeryToken()

            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 js-form-error-summary @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="mb-0"></div>
                }
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-5 app-form-field">
                    <label asp-for="StockItemId" class="form-label fw-semibold small text-ink mb-1">@Localizer["Inventory_ItemName"] <span class="text-chili">*</span></label>
                    <select asp-for="StockItemId" id="invMovementItemSelect" class="form-select" required>
                        <option value="">-- Select Stock Item --</option>
                        @foreach (var item in Model.StockItems)
                        {
                            <option value="@item.Id"
                                    data-stock="@item.CurrentStock"
                                    data-unit="@item.Unit"
                                    data-rate="@item.LastPurchaseRate">@item.Name (@item.CurrentStock.ToString("0.##") @item.Unit)</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-2 app-form-field">
                    <label asp-for="Quantity" class="form-label fw-semibold small text-ink mb-1">@Localizer["Billing_Qty"] <span class="text-chili">*</span></label>
                    <input asp-for="Quantity" id="invMovementQtyInput" type="number" step="0.01" min="0.01" class="form-control font-monospace" required />
                </div>

                <div class="col-6 col-md-2 app-form-field">
                    <label asp-for="Department" class="form-label fw-semibold small text-ink mb-1">@Localizer["Inventory_Department"] <span class="text-chili">*</span></label>
                    <select asp-for="Department" class="form-select" required>
                        <option value="Main Kitchen">Main Kitchen</option>
                        <option value="Tandoor">Tandoor</option>
                        <option value="Bakery & Desserts">Bakery &amp; Desserts</option>
                        <option value="Beverages">Beverages</option>
                        <option value="Staff Meal">Staff Meal</option>
                    </select>
                </div>

                <div class="col-12 col-md-3 app-form-field">
                    <label asp-for="ConsumptionDate" class="form-label fw-semibold small text-ink mb-1">@Localizer["Date"] <span class="text-chili">*</span></label>
                    <input asp-for="ConsumptionDate" type="date" max="@todayStr" value="@Model.ConsumptionDate.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>

                <div class="col-12">
                    <div class="p-3 bg-cream rounded-3 border d-flex flex-wrap justify-content-between gap-3 small">
                        <span>@Localizer["Inventory_AvailableStock"]: <strong id="invSystemStockDisplay" class="font-monospace text-ink">-</strong></span>
                        <span>@Localizer["Inventory_LastRate"]: <strong id="invItemRateDisplay" class="font-monospace text-muted">-</strong></span>
                        <span>@Localizer["Inventory_ConsumptionValue"]: <strong id="invLossPreview" class="font-monospace text-plum">₹0.00</strong></span>
                    </div>
                </div>

                <div class="col-12 app-form-field">
                    <label asp-for="ReferenceNote" class="form-label fw-semibold small text-ink mb-1">@Localizer["Inventory_Notes"]</label>
                    <input asp-for="ReferenceNote" class="form-control" placeholder="e.g. Lunch service prep issue / Banquet batch" />
                </div>
            </div>

            <partial name="_FormFooter" model='new RestaurantMS.Web.Models.FormFooterModel { CancelUrl = Url.Action("Index", "Inventory")!, ShowSaveAndNew = true }' />
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <h6 class="fw-bold text-ink mb-3"><i class="bi bi-clock-history me-1 text-teal"></i> @Localizer["Inventory_RecentConsumption"]</h6>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light small text-muted text-uppercase">
                    <tr>
                        <th>@Localizer["Date"]</th>
                        <th>@Localizer["Inventory_ItemName"]</th>
                        <th class="text-end">@Localizer["Inventory_OutQty"]</th>
                        <th class="text-end">@Localizer["Inventory_Balance"]</th>
                        <th>@Localizer["Inventory_Notes"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentConsumption.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3 small">@Localizer["Inventory_NoRecordsYet"]</td></tr>
                    }
                    else
                    {
                        @foreach (var r in Model.RecentConsumption)
                        {
                            <tr>
                                <td class="small text-muted">@r.EntryDate.ToString("dd-MMM-yyyy")</td>
                                <td class="fw-semibold small">@r.ItemName</td>
                                <td class="text-end font-monospace text-plum fw-bold">-@r.OutQty.ToString("0.##") @r.Unit</td>
                                <td class="text-end font-monospace">@r.BalanceQty.ToString("0.##") @r.Unit</td>
                                <td class="small text-muted">@r.Reason</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/inventory.js" asp-append-version="true"></script>
}
