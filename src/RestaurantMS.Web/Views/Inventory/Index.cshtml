@model RestaurantMS.Web.Models.StockSummaryViewModel
@{
    ViewData["Title"] = Localizer["Nav_StockSummary"].Value;
    ViewData["QuickAddUnits"] = Model.Units;
    ViewData["QuickAddCategories"] = Model.Categories;
}

<div class="inventory-page d-flex flex-column gap-3" id="inventoryModuleRoot" data-quick-add-url="@Url.Action("QuickAddMaster", "Inventory")">
    @Html.AntiForgeryToken()

    <!-- Header & Quick Navigation -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-boxes text-plum me-2"></i> @Localizer["Nav_StockSummary"]</h2>
                <div class="text-muted small">
                    @Localizer["Inventory_SummarySubtitle"]
                    &bull;
                    <a asp-controller="Masters" asp-action="Index" asp-route-tab="suppliers" class="text-plum text-decoration-none fw-semibold">@Localizer["Inventory_ManageSuppliersInMasters"]</a>
                    &bull;
                    <a asp-controller="Masters" asp-action="Index" asp-route-tab="tax-units" class="text-plum text-decoration-none fw-semibold">@Localizer["Inventory_ManageUnitsInMasters"]</a>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-outline-plum" data-bs-toggle="modal" data-bs-target="#quickAddStockItemModal" permission="@Permissions.Inventory.Create">
                    <i class="bi bi-plus-circle"></i> @Localizer["Inventory_QuickAddItem"]
                </button>
                <a asp-action="Adjustment" class="btn btn-sm btn-outline-secondary" permission="@Permissions.Inventory.Adjust">
                    <i class="bi bi-sliders"></i> @Localizer["Nav_StockAdjustment"]
                </a>
                <a asp-action="Wastage" class="btn btn-sm btn-outline-chili" permission="@Permissions.Inventory.Wastage">
                    <i class="bi bi-trash3"></i> @Localizer["Nav_Wastage"]
                </a>
                <a asp-action="Consumption" class="btn btn-sm btn-outline-teal" permission="@Permissions.Inventory.Consumption">
                    <i class="bi bi-fire"></i> @Localizer["Nav_Consumption"]
                </a>
                <a asp-action="Purchase" class="btn btn-sm btn-plum shadow-sm" permission="@Permissions.Inventory.Purchase">
                    <i class="bi bi-cart-plus"></i> @Localizer["Nav_Purchase"]
                </a>
            </div>
        </div>
    </div>

    <!-- 4 KPI Cards: Items, Stock Value, Low Stock Count, Expiring Soon -->
    <div class="row g-3">
        <div class="col-6 col-lg-3">
            <a asp-action="Index" asp-route-status="All" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 border-start border-4 border-primary">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small text-muted fw-semibold text-uppercase">@Localizer["Inventory_Kpi_Items"]</span>
                        <i class="bi bi-boxes text-plum fs-5"></i>
                    </div>
                    <div class="fs-3 fw-bold text-ink font-monospace">@Model.Kpis.TotalItems</div>
                    <div class="small text-muted">@Localizer["Inventory_Kpi_ItemsSub"]</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 border-start border-4" style="border-left-color: #0B7A70 !important;">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small text-muted fw-semibold text-uppercase">@Localizer["Inventory_Kpi_StockValue"]</span>
                    <i class="bi bi-currency-rupee text-teal fs-5"></i>
                </div>
                <div class="fs-3 fw-bold text-teal font-monospace">₹@Model.Kpis.TotalStockValue.ToString("N0")</div>
                <div class="small text-muted">@Localizer["Inventory_Kpi_StockValueSub"]</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-action="LowStock" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 border-start border-4 border-danger">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small text-muted fw-semibold text-uppercase">@Localizer["Inventory_Kpi_LowStock"]</span>
                        <i class="bi bi-exclamation-triangle-fill text-chili fs-5"></i>
                    </div>
                    <div class="fs-3 fw-bold text-chili font-monospace">@Model.Kpis.LowStockCount</div>
                    <div class="small text-muted">@Model.Kpis.OutOfStockCount @Localizer["Inventory_OutOfStock"]</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-action="Index" asp-route-status="Expiring" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 border-start border-4 border-warning">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small text-muted fw-semibold text-uppercase">@Localizer["Inventory_Kpi_ExpiringSoon"]</span>
                        <i class="bi bi-clock-history text-saffron fs-5"></i>
                    </div>
                    <div class="fs-3 fw-bold text-dark font-monospace">@Model.Kpis.ExpiringSoonCount</div>
                    <div class="small text-muted">@Localizer["Inventory_Kpi_ExpiringSub"]</div>
                </div>
            </a>
        </div>
    </div>

    <!-- Filter Bar & Colour Status Chips -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <form method="get" asp-action="Index" class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <a asp-action="Index" asp-route-status="All" asp-route-category="@Model.CategoryFilter" asp-route-search="@Model.Search"
                   class="btn btn-sm rounded-pill @(Model.StatusFilter == "All" ? "btn-plum" : "btn-light border")">@Localizer["Filter_All"]</a>
                <a asp-action="Index" asp-route-status="OK" asp-route-category="@Model.CategoryFilter" asp-route-search="@Model.Search"
                   class="btn btn-sm rounded-pill @(Model.StatusFilter == "OK" ? "btn-teal" : "btn-light border text-teal")">@Localizer["StockStatus_OK"]</a>
                <a asp-action="Index" asp-route-status="Low" asp-route-category="@Model.CategoryFilter" asp-route-search="@Model.Search"
                   class="btn btn-sm rounded-pill @(Model.StatusFilter == "Low" ? "btn-saffron" : "btn-light border text-dark")">@Localizer["StockStatus_Low"]</a>
                <a asp-action="Index" asp-route-status="Out" asp-route-category="@Model.CategoryFilter" asp-route-search="@Model.Search"
                   class="btn btn-sm rounded-pill @(Model.StatusFilter == "Out" ? "btn-chili" : "btn-light border text-chili")">@Localizer["StockStatus_Out"]</a>
                <a asp-action="Index" asp-route-status="Expiring" asp-route-category="@Model.CategoryFilter" asp-route-search="@Model.Search"
                   class="btn btn-sm rounded-pill @(Model.StatusFilter == "Expiring" ? "btn-saffron" : "btn-light border")">
                    <i class="bi bi-clock"></i> @Localizer["Inventory_Kpi_ExpiringSoon"]
                </a>
            </div>

            <div class="d-flex flex-wrap gap-2 align-items-center">
                <input type="hidden" name="status" value="@Model.StatusFilter" />
                <select name="category" class="form-select form-select-sm" style="width: 155px;" onchange="this.form.submit()">
                    <option value="All">@Localizer["Inventory_AllCategories"]</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat" selected="@(Model.CategoryFilter.Equals(cat, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@cat</option>
                    }
                </select>
                <div class="input-group input-group-sm" style="width: 220px;">
                    <input type="text" name="search" class="form-control" value="@Model.Search" placeholder="@Localizer["Inventory_SearchPlaceholder"]" />
                    <button type="submit" class="btn btn-outline-plum"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>

        <!-- Stock Grid -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted text-uppercase">
                    <tr>
                        <th>@Localizer["Code"]</th>
                        <th>@Localizer["Inventory_ItemName"]</th>
                        <th>@Localizer["Category"]</th>
                        <th class="text-end">@Localizer["Inventory_CurrentStock"]</th>
                        <th class="text-end">@Localizer["Inventory_ReorderLevel"]</th>
                        <th class="text-end">@Localizer["Inventory_LastRate"]</th>
                        <th class="text-end">@Localizer["Inventory_StockValue"]</th>
                        <th class="text-center">@Localizer["Status"]</th>
                        <th class="text-end">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4 small">@Localizer["Inventory_NoItemsMatch"]</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var chipClass = item.Status == "Out"
                                ? "bg-chili text-white"
                                : item.Status == "Low"
                                    ? "bg-saffron text-dark"
                                    : "bg-teal text-white";
                            var chipLabel = item.Status == "Out"
                                ? Localizer["StockStatus_Out"].Value
                                : item.Status == "Low"
                                    ? Localizer["StockStatus_Low"].Value
                                    : Localizer["StockStatus_OK"].Value;

                            <tr data-row-key="@item.Name">
                                <td class="font-monospace small text-muted">@item.Code</td>
                                <td>
                                    <div class="fw-bold text-ink">@item.Name</div>
                                    @if (item.IsExpiringSoon && item.ExpiryDate.HasValue)
                                    {
                                        <span class="badge bg-warning-subtle text-dark border small">
                                            <i class="bi bi-clock-history me-1"></i> Exp: @item.ExpiryDate.Value.ToString("dd-MMM-yyyy")
                                        </span>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                                <td class="text-end font-monospace fw-bold @(item.Status == "Out" ? "text-chili" : item.Status == "Low" ? "text-dark" : "text-ink")">
                                    @item.CurrentStock.ToString("0.##") @item.Unit
                                </td>
                                <td class="text-end font-monospace text-muted">@item.ReorderLevel.ToString("0.##") @item.Unit</td>
                                <td class="text-end font-monospace">₹@item.LastPurchaseRate.ToString("N2")</td>
                                <td class="text-end font-monospace fw-bold text-plum">₹@item.StockValue.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge rounded-pill px-3 py-1 @chipClass">@chipLabel</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Purchase" asp-route-itemId="@item.Id" class="btn btn-outline-plum" title="@Localizer["Nav_Purchase"]" permission="@Permissions.Inventory.Purchase">
                                            <i class="bi bi-cart-plus"></i>
                                        </a>
                                        <a asp-action="Adjustment" asp-route-itemId="@item.Id" class="btn btn-outline-secondary" title="@Localizer["Nav_StockAdjustment"]" permission="@Permissions.Inventory.Adjust">
                                            <i class="bi bi-sliders"></i>
                                        </a>
                                        <a asp-action="Wastage" asp-route-itemId="@item.Id" class="btn btn-outline-chili" title="@Localizer["Nav_Wastage"]" permission="@Permissions.Inventory.Wastage">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                        <a asp-action="Consumption" asp-route-itemId="@item.Id" class="btn btn-outline-teal" title="@Localizer["Nav_Consumption"]" permission="@Permissions.Inventory.Consumption">
                                            <i class="bi bi-fire"></i>
                                        </a>
                                        <a asp-action="Ledger" asp-route-itemId="@item.Id" class="btn btn-outline-dark" title="@Localizer["Nav_StockLedger"]">
                                            <i class="bi bi-journal-check"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_InventoryQuickAddModals" />

@section Scripts {
    <script src="~/js/modules/inventory.js" asp-append-version="true"></script>
}
