@model RestaurantMS.Web.Models.StockListViewModel
@{
    ViewData["Title"] = Localizer["Inventory_Title"].Value;
}

<div class="inventory-page d-flex flex-column gap-3">
    <!-- Header with KPI Badges -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-boxes text-plum me-2"></i> @Localizer["Inventory_Title"]</h2>
                <div class="d-flex align-items-center gap-3 text-muted small">
                    <span><strong class="text-ink">@Model.TotalStockItems</strong> Items Tracked</span>
                    <span>&bull;</span>
                    @if (Model.LowStockAlertsCount > 0)
                    {
                        <a asp-action="LowStock" class="badge bg-danger-subtle text-chili text-decoration-none">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.LowStockAlertsCount Low Stock Alerts
                        </a>
                    }
                    <span>&bull;</span>
                    <span class="fw-bold text-teal font-monospace">Valuation: ₹@Model.TotalStockValuation.ToString("N0")</span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Suppliers" class="btn btn-outline-plum px-3 py-2 fw-semibold">
                    <i class="bi bi-truck me-1"></i> Suppliers
                </a>
                <a asp-action="Purchase" class="btn btn-plum px-3 py-2 fw-semibold shadow-sm">
                    <i class="bi bi-cart-plus me-1"></i> Inward Purchase
                </a>
            </div>
        </div>
    </div>

    <!-- Stock Inventory Grid Table -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 font-monospace">
                <thead class="table-light small text-muted text-uppercase font-sans">
                    <tr>
                        <th class="text-start">Item Name</th>
                        <th class="text-start">Category</th>
                        <th class="text-end">Current Stock</th>
                        <th class="text-end">Reorder Level</th>
                        <th class="text-end">Cost Price</th>
                        <th class="text-end">Total Valuation</th>
                        <th class="text-center font-sans">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var isLow = item.IsLowStock || item.CurrentStock <= item.ReorderLevel;
                        <tr>
                            <td class="text-start font-sans fw-bold text-ink">@item.Name</td>
                            <td class="text-start font-sans small text-muted">@item.Category</td>
                            <td class="text-end fw-bold @(isLow ? "text-danger" : "text-ink")">
                                @item.CurrentStock.ToString("N1") @item.Unit
                            </td>
                            <td class="text-end text-muted">@item.ReorderLevel.ToString("N1") @item.Unit</td>
                            <td class="text-end text-muted">₹@item.CostPrice.ToString("N2")</td>
                            <td class="text-end fw-bold text-plum">₹@((item.CurrentStock * item.CostPrice).ToString("N2"))</td>
                            <td class="text-center font-sans">
                                @if (isLow)
                                {
                                    <span class="badge bg-chili text-white"><i class="bi bi-exclamation-triangle me-1"></i> Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-teal text-white">Sufficient</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
