@model RestaurantMS.Web.Models.SupplierListViewModel
@{
    ViewData["Title"] = Localizer["Inventory_Suppliers_Title"].Value;
}

<div class="suppliers-page d-flex flex-column gap-3">
    <!-- Header with KPI Badges -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-truck text-plum me-2"></i> @Localizer["Inventory_Suppliers_Title"]</h2>
                <div class="d-flex align-items-center gap-3 text-muted small">
                    <span><strong class="text-ink">@Model.TotalSuppliers</strong> Vendors Registered</span>
                    <span>&bull;</span>
                    <span class="text-chili"><strong class="badge bg-danger-subtle text-chili">₹@Model.TotalPayable.ToString("N0") Outstanding Payable</strong></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2">
                    <i class="bi bi-arrow-left me-1"></i> Stock Items
                </a>
                <a asp-action="SupplierForm" class="btn btn-plum px-3 py-2 fw-semibold shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Add Supplier
                </a>
            </div>
        </div>
    </div>

    <!-- Suppliers Table Grid -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted text-uppercase">
                    <tr>
                        <th class="text-start">Supplier / Business Name</th>
                        <th class="text-start">Contact Person</th>
                        <th class="text-start">Mobile</th>
                        <th class="text-center">GSTIN</th>
                        <th class="text-end">Payable Balance</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Suppliers)
                    {
                        <tr>
                            <td class="text-start fw-bold text-ink">@s.Name</td>
                            <td class="text-start">@s.ContactPerson</td>
                            <td class="text-start font-monospace small"><i class="bi bi-telephone text-muted me-1"></i>@s.Mobile</td>
                            <td class="text-center font-monospace small text-muted">@s.Gstin</td>
                            <td class="text-end fw-bold font-monospace @(s.PendingPayment > 0 ? "text-chili" : "text-muted")">
                                ₹@s.PendingPayment.ToString("N2")
                            </td>
                            <td class="text-end">
                                <a asp-action="SupplierForm" asp-route-id="@s.Id" class="btn btn-sm btn-outline-plum py-1 px-2">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
