@model RestaurantMS.Web.Models.SupplierFormViewModel
@{
    ViewData["Title"] = Localizer["Inventory_SupplierForm_Title"].Value;
}

<div class="mx-auto" style="max-width: 780px;">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <form asp-action="SupplierForm" method="post" id="supplierForm" data-app-form="true" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 js-form-error-summary @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="mb-0"></div> }
            </div>

            <partial name="_FormSection" model='new RestaurantMS.Web.Models.FormSectionModel { Title = Localizer["Inventory_SupplierForm_Title"].Value, HelperText = "Vendor contact details, GST registration and payment credit terms", Icon = "bi-truck" }' />

            <div class="row g-3 mb-3">
                <div class="col-12 app-form-field">
                    <label asp-for="Name" class="form-label fw-semibold small text-ink mb-1">Supplier / Firm Name <span class="text-chili">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Pawar Dairy Products" required />
                    <span asp-validation-for="Name" class="invalid-feedback d-block small js-field-error"></span>
                </div>
                <div class="col-12 col-md-6 app-form-field">
                    <label asp-for="ContactPerson" class="form-label fw-semibold small text-ink mb-1">Contact Person</label>
                    <input asp-for="ContactPerson" class="form-control" placeholder="e.g. Dnyaneshwar Pawar" />
                </div>
                <div class="col-12 col-md-6 app-form-field">
                    <label asp-for="Phone" class="form-label fw-semibold small text-ink mb-1">Mobile / Phone <span class="text-chili">*</span></label>
                    <input asp-for="Phone" class="form-control" placeholder="10-digit mobile" pattern="^[6-9]\d{9}$" maxlength="10" required />
                    <span asp-validation-for="Phone" class="invalid-feedback d-block small js-field-error"></span>
                </div>
                <div class="col-12 col-md-6 app-form-field">
                    <label asp-for="Email" class="form-label fw-semibold small text-ink mb-1">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="vendor@example.com" />
                </div>
                <div class="col-12 col-md-6 app-form-field">
                    <label asp-for="Gstin" class="form-label fw-semibold small text-ink mb-1">GSTIN</label>
                    <input asp-for="Gstin" class="form-control font-monospace" placeholder="27AAAAA0000A1Z2" maxlength="15" />
                </div>
                <div class="col-12 col-md-8 app-form-field">
                    <label asp-for="Address" class="form-label fw-semibold small text-ink mb-1">Shop / Warehouse Address</label>
                    <input asp-for="Address" class="form-control" placeholder="Market Yard, Sector 4, Pune" />
                </div>
                <div class="col-12 col-md-4 app-form-field">
                    <label asp-for="CreditDays" class="form-label fw-semibold small text-ink mb-1">Credit Term</label>
                    <div class="input-group">
                        <input asp-for="CreditDays" type="number" class="form-control" min="0" max="180" value="30" />
                        <span class="input-group-text bg-light text-muted small fw-semibold">days</span>
                    </div>
                </div>
            </div>

            <partial name="_FormFooter" model='new RestaurantMS.Web.Models.FormFooterModel { CancelUrl = Url.Action("Index", "Masters", new { tab = "suppliers" })!, ShowSaveAndNew = true }' />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
