@model RestaurantMS.Web.Models.MenuCategoriesViewModel
@{
    ViewData["Title"] = Localizer["Menu_Categories_Title"].Value;
}

<div class="menu-categories-page d-flex flex-column gap-3">
    <!-- Header with Action -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-card-list text-plum me-2"></i> @Localizer["Menu_Categories_Title"]</h2>
                <div class="d-flex align-items-center gap-3 text-muted small">
                    <span><strong class="text-ink">@Model.TotalCategories</strong> Categories</span>
                    <span>&bull;</span>
                    <span><strong class="text-plum">@Model.TotalItems</strong> Menu Dishes</span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Items" class="btn btn-outline-plum px-3 py-2 fw-semibold">
                    <i class="bi bi-egg-fried me-1"></i> Manage Dishes
                </a>
                <a asp-action="CategoryForm" class="btn btn-plum px-3 py-2 fw-semibold shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Add Category
                </a>
            </div>
        </div>
    </div>

    <!-- Category Grid -->
    <div class="row g-3">
        @foreach (var cat in Model.Categories)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="rounded-circle bg-plum-subtle text-plum d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                <i class="bi bi-tag fs-5"></i>
                            </div>
                            <span class="badge bg-light text-muted border">Order: @cat.DisplayOrder</span>
                        </div>
                        <h5 class="fw-bold text-ink mb-1">@cat.Name</h5>
                        @if (!string.IsNullOrWhiteSpace(cat.MarathiName))
                        {
                            <div class="text-muted small mb-1">@cat.MarathiName</div>
                        }
                        <div class="text-muted small">@cat.ItemCount Dishes Active</div>
                    </div>

                    <div class="pt-3 border-top mt-3 d-flex justify-content-between align-items-center">
                        <a asp-action="Items" asp-route-categoryId="@cat.Id" class="btn btn-sm btn-outline-plum">
                            View Dishes <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                        <a asp-action="CategoryForm" asp-route-id="@cat.Id" class="btn btn-sm btn-link text-muted p-0">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
