@model RestaurantMS.Web.Models.CategoryFormViewModel
@{
    ViewData["Title"] = Localizer["Menu_CategoryForm_Title"].Value;
}

<div class="mx-auto" style="max-width: 720px;">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <form asp-action="CategoryForm" method="post" id="categoryForm" data-app-form="true" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 js-form-error-summary @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="mb-0"></div> }
            </div>

            <partial name="_FormSection" model='new RestaurantMS.Web.Models.FormSectionModel { Title = Localizer["Menu_CategoryForm_Title"].Value, HelperText = Localizer["Form_Sec_Category_Help"].Value, Icon = "bi-tags" }' />

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6 app-form-field">
                    <label asp-for="NameEn" class="form-label fw-semibold small text-ink mb-1">Category Name (English) <span class="text-chili">*</span></label>
                    <input asp-for="NameEn" class="form-control" placeholder="e.g. Starters &amp; Snacks" required />
                    <span asp-validation-for="NameEn" class="invalid-feedback d-block small js-field-error"></span>
                </div>
                <div class="col-12 col-md-6 app-form-field">
                    <label asp-for="NameMr" class="form-label fw-semibold small text-ink mb-1">Category Name (मराठी) <span class="text-chili">*</span></label>
                    <input asp-for="NameMr" class="form-control" placeholder="उदा. स्टार्टर्स आणि स्नॅक्स" required />
                    <span asp-validation-for="NameMr" class="invalid-feedback d-block small js-field-error"></span>
                </div>
                <div class="col-12 col-md-6 app-form-field">
                    <label asp-for="Icon" class="form-label fw-semibold small text-ink mb-1">Icon Class</label>
                    <input asp-for="Icon" class="form-control font-monospace" placeholder="bi-cup-hot" />
                </div>
                <partial name="_FormField" model='new RestaurantMS.Web.Models.FormFieldModel { Name = "DisplayOrder", Label = "Display Order", InputType = "stepper", Value = (Model.DisplayOrder > 0 ? Model.DisplayOrder : 1).ToString(), Min = "1", Max = "99", ColClass = "col-12 col-md-6" }' />
                <div class="col-12">
                    <div class="p-3 rounded-3 border bg-cream-soft d-flex align-items-center justify-content-between">
                        <div>
                            <label class="form-label fw-semibold small text-ink mb-0" for="categoryActiveCheck">Visible on POS Terminal</label>
                            <div class="text-muted" style="font-size: 0.74rem;">Inactive categories stay hidden from order screens</div>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="categoryActiveCheck" />
                        </div>
                    </div>
                </div>
            </div>

            <partial name="_FormFooter" model='new RestaurantMS.Web.Models.FormFooterModel { CancelUrl = Url.Action("Index", "Masters", new { tab = "categories" })!, ShowSaveAndNew = true }' />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
