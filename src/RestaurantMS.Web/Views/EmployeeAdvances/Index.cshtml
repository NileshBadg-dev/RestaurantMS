@model RestaurantMS.Web.Models.EmployeeAdvancesViewModel
@{
    ViewData["Title"] = Localizer["Adv_PageTitle"].Value;
    Layout = "_Layout";
    var todayStr = DateTime.UtcNow.ToString("yyyy-MM-dd");
    var nextMonthStr = DateTime.UtcNow.AddMonths(1).ToString("yyyy-MM");
}

<div class="d-flex flex-column gap-3"
     id="employeeAdvancesRoot"
     data-max-percent="@Model.MaxAdvanceSalaryPercent"
     data-lock-date="@(Model.AccountingLockDate?.ToString("yyyy-MM-dd") ?? "")"
     data-preview-url="@Url.Action("PreviewSchedule", "EmployeeAdvances")">

    @if (TempData["SuccessMessage"] is string okMsg)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm py-2 px-3 small" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@okMsg
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm py-2 px-3 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errMsg
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Action Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h2 class="h4 fw-bold text-ink mb-0"><i class="bi bi-cash-coin text-plum me-2"></i>@Localizer["Adv_PageTitle"]</h2>
            <div class="small text-muted">
                @Localizer["Adv_PageSubtitle"]
                @if (Model.AccountingLockDate.HasValue)
                {
                    <span class="ms-2 badge bg-light text-muted border"><i class="bi bi-lock me-1"></i>Locked up to @Model.AccountingLockDate.Value.ToString("dd MMM yyyy")</span>
                }
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-action="Reports" asp-route-report="outstanding" class="btn btn-outline-plum btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-bar-chart-line me-1"></i> @Localizer["Adv_ReportsBtn"]
            </a>
            <a asp-controller="Accounts" asp-action="DayBook" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-journal-text me-1"></i> @Localizer["Nav_DayBook"]
            </a>
            @if (Model.CanGiveAdvance)
            {
                <button type="button" class="btn btn-teal text-white btn-sm rounded-pill px-3 fw-semibold shadow-sm" data-bs-toggle="offcanvas" data-bs-target="#giveAdvanceDrawer" permission="EmployeeAdvances.Create">
                    <i class="bi bi-plus-circle me-1"></i> @Localizer["Adv_GiveAdvance"]
                </button>
            }
        </div>
    </div>

    <!-- Top 4 KPI Cards (Shared _KpiCard) -->
    <div class="row g-3">
        <div class="col-6 col-xl-3">
            <partial name="_KpiCard" model='new RestaurantMS.Web.Models.KpiCardModel { Title = Localizer["Adv_Kpi_TotalGiven"].Value, Value = $"₹{Model.Kpis.TotalAdvanceGiven:N0}", Subtitle = Localizer["Adv_Kpi_TotalGivenSub"].Value, Icon = "bi-cash-stack", Theme = "plum" }' />
        </div>
        <div class="col-6 col-xl-3">
            <partial name="_KpiCard" model='new RestaurantMS.Web.Models.KpiCardModel { Title = Localizer["Adv_Kpi_RecoveredMonth"].Value, Value = $"₹{Model.Kpis.RecoveredThisMonth:N0}", Subtitle = DateTime.UtcNow.ToString("MMMM yyyy"), Icon = "bi-arrow-down-left-circle", Theme = "teal" }' />
        </div>
        <div class="col-6 col-xl-3">
            <partial name="_KpiCard" model='new RestaurantMS.Web.Models.KpiCardModel { Title = Localizer["Adv_Kpi_Outstanding"].Value, Value = $"₹{Model.Kpis.TotalOutstanding:N0}", Subtitle = Localizer["Adv_Kpi_OutstandingSub"].Value, Icon = "bi-exclamation-circle", Theme = "chili" }' />
        </div>
        <div class="col-6 col-xl-3">
            <partial name="_KpiCard" model='new RestaurantMS.Web.Models.KpiCardModel { Title = Localizer["Adv_Kpi_StaffCount"].Value, Value = Model.Kpis.StaffWithOutstandingCount.ToString(), Subtitle = $"of {Model.Employees.Count} total staff", Icon = "bi-people-fill", Theme = "saffron" }' />
        </div>
    </div>

    <!-- Master-Detail Layout: Left Employee Picker | Right Selected Employee Summary & Running Ledger -->
    <div class="row g-3">
        <!-- Left: Employee Picker with Search & Outstanding Badge -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100">
                <div class="fw-bold text-ink mb-2 d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-people text-plum me-1"></i> @Localizer["Adv_EmployeePicker"]</span>
                    <span class="badge bg-light text-muted border">@Model.Employees.Count</span>
                </div>

                <div class="input-group input-group-sm mb-3">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="advEmployeeSearch" class="form-control border-start-0" placeholder="@Localizer["Adv_SearchEmployeePlaceholder"]" value="@Model.Search" />
                </div>

                <div class="list-group list-group-flush gap-1" id="advEmployeeList" style="max-height: 520px; overflow-y: auto;">
                    @foreach (var emp in Model.Employees)
                    {
                        var isSelected = emp.StaffId == Model.SelectedStaffId;
                        var initials = string.Join("", emp.EmployeeName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
                        <a asp-action="Index" asp-route-staffId="@emp.StaffId"
                           class="list-group-item list-group-item-action rounded-3 border px-3 py-2 d-flex align-items-center justify-content-between gap-2 js-emp-picker-item @(isSelected ? "bg-teal-subtle border-teal fw-semibold" : "")"
                           data-search="@($"{emp.EmployeeName} {emp.EmployeeCode} {emp.Designation}".ToLowerInvariant())">
                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                <div class="rounded-circle @(emp.IsActive ? "bg-plum" : "bg-secondary") text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px; font-size: 0.78rem;">
                                    @initials
                                </div>
                                <div class="overflow-hidden">
                                    <div class="text-ink text-truncate small fw-bold">
                                        @emp.EmployeeName
                                        @if (!emp.IsActive)
                                        {
                                            <span class="badge bg-secondary ms-1" style="font-size: 0.62rem;">Inactive</span>
                                        }
                                    </div>
                                    <div class="text-muted text-truncate" style="font-size: 0.72rem;">@emp.EmployeeCode · @emp.Designation</div>
                                </div>
                            </div>
                            <span class="badge rounded-pill @(emp.OutstandingBalance > 0 ? "bg-chili text-white" : "bg-light text-muted border") flex-shrink-0">
                                ₹@emp.OutstandingBalance.ToString("N0")
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Selected Employee Summary Card + Running Ledger Grid -->
        <div class="col-lg-8 d-flex flex-column gap-3">
            @if (Model.SelectedEmployee is not null)
            {
                var sel = Model.SelectedEmployee;
                var selInitials = string.Join("", sel.EmployeeName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

                <!-- Selected Employee Summary Card -->
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 pb-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(sel.PhotoUrl))
                            {
                                <img src="@sel.PhotoUrl" alt="@sel.EmployeeName" class="rounded-circle object-fit-cover border" style="width: 56px; height: 56px;" />
                            }
                            else
                            {
                                <div class="rounded-circle @(sel.IsActive ? "bg-plum" : "bg-secondary") text-white fw-bold d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 1.25rem;">
                                    @selInitials
                                </div>
                            }
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h3 class="h5 fw-bold text-ink mb-0">@sel.EmployeeName</h3>
                                    <span class="badge bg-light text-plum border">@sel.EmployeeCode</span>
                                    <status-chip status="@(sel.IsActive ? "Active" : "Inactive")" label="@(sel.IsActive ? Localizer["Common_Active"].Value : Localizer["Common_Inactive"].Value)"></status-chip>
                                </div>
                                <div class="small text-muted mt-1">
                                    @sel.Designation · @Localizer["Adv_SalaryLabel"]: <strong class="text-ink">₹@sel.BasicSalary.ToString("N0")/@sel.SalaryType</strong>
                                    (Cap @Model.MaxAdvanceSalaryPercent.ToString("0.##")%: ₹@Math.Round(sel.MonthlyEquivalentSalary * (Model.MaxAdvanceSalaryPercent / 100m), 0).ToString("N0"))
                                </div>
                            </div>
                        </div>

                        <div class="text-md-end">
                            <div class="small text-muted">@Localizer["Adv_CurrentOutstanding"]</div>
                            <div class="h3 fw-bold mb-0 @(sel.OutstandingBalance > 0 ? "text-chili" : "text-teal") font-monospace">
                                ₹@sel.OutstandingBalance.ToString("N2")
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-3">
                        <form method="post" asp-action="ToggleAutoRecover" class="d-flex align-items-center gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="staffId" value="@sel.StaffId" />
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input js-adv-autorecover" type="checkbox" role="switch" id="autoRecoverEmpSwitch" name="enabled" value="true" checked="@(sel.AutoRecoverFromSalary ? "checked" : null)" />
                                <label class="form-check-label small fw-semibold text-ink" for="autoRecoverEmpSwitch">
                                    @Localizer["Adv_AutoRecoverToggle"]
                                    @if (sel.PlannedMonthlyInstalment > 0 && sel.OutstandingBalance > 0)
                                    {
                                        <span class="text-muted fw-normal">(₹@sel.PlannedMonthlyInstalment.ToString("N0")/mo)</span>
                                    }
                                </label>
                            </div>
                            <input type="hidden" name="enabled" value="false" />
                        </form>

                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Staff" asp-action="Details" asp-route-id="@sel.StaffId" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                <i class="bi bi-person-vcard me-1"></i> @Localizer["Staff_Profile"]
                            </a>
                            @if (Model.CanRecoverAdvance && sel.OutstandingBalance > 0)
                            {
                                <button type="button" class="btn btn-outline-teal btn-sm rounded-pill px-3 fw-semibold" data-bs-toggle="offcanvas" data-bs-target="#recordRecoveryDrawer" permission="EmployeeAdvances.Recover">
                                    <i class="bi bi-arrow-down-left-circle me-1"></i> @Localizer["Adv_RecordRecovery"]
                                </button>
                            }
                            @if (Model.CanGiveAdvance)
                            {
                                <button type="button" class="btn btn-teal text-white btn-sm rounded-pill px-3 fw-semibold shadow-sm" data-bs-toggle="offcanvas" data-bs-target="#giveAdvanceDrawer" disabled="@(!sel.IsActive ? "disabled" : null)" permission="EmployeeAdvances.Create">
                                    <i class="bi bi-plus-circle me-1"></i> @Localizer["Adv_GiveAdvance"]
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <!-- Running Ledger Grid -->
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                    <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-3">
                        <h4 class="h6 fw-bold text-ink mb-0"><i class="bi bi-journal-bookmark text-plum me-2"></i>@Localizer["Adv_RunningLedger"] — @sel.EmployeeName</h4>
                        <a asp-action="Reports" asp-route-report="ledger" asp-route-staffId="@sel.StaffId" class="small text-decoration-none text-plum fw-semibold">
                            @Localizer["Adv_FullLedgerReport"] <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                    @if (Model.LedgerEntries.Count == 0)
                    {
                        <partial name="_EmptyState" model='new RestaurantMS.Web.Models.EmptyStateModel { Icon = "bi-journal-x", Title = "Adv_LedgerEmpty_Title", Description = "Adv_LedgerEmpty_Desc" }' />
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="master-grid-table table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Common_Date"]</th>
                                        <th>@Localizer["Adv_Col_Voucher"]</th>
                                        <th>@Localizer["Adv_Col_Type"]</th>
                                        <th>@Localizer["Adv_Col_Mode"]</th>
                                        <th class="text-end">@Localizer["Common_Amount"]</th>
                                        <th class="text-end">@Localizer["Adv_Col_Balance"]</th>
                                        <th>@Localizer["Adv_Col_Note"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in Model.LedgerEntries)
                                    {
                                        var chipStatus = entry.EntryType switch
                                        {
                                            "Recovered" => "Paid",
                                            "Adjusted" => "Draft",
                                            _ => "Warning"
                                        };
                                        <tr>
                                            <td class="small text-nowrap">@entry.Date.ToString("dd MMM yyyy")</td>
                                            <td class="font-monospace small text-plum fw-semibold">@entry.VoucherNumber</td>
                                            <td><status-chip status="@chipStatus" label="@entry.EntryType"></status-chip></td>
                                            <td class="small">@entry.PaymentMode</td>
                                            <td class="text-end font-monospace fw-bold @(entry.EntryType == "Given" ? "text-chili" : "text-teal")">
                                                @(entry.EntryType == "Given" ? "+" : "-")₹@entry.Amount.ToString("N2")
                                            </td>
                                            <td class="text-end font-monospace fw-bold text-ink">₹@entry.RunningBalance.ToString("N2")</td>
                                            <td class="small text-muted">
                                                <div>@entry.Note</div>
                                                @if (!string.IsNullOrEmpty(entry.RecoveryPlanSummary))
                                                {
                                                    <span class="badge bg-light text-dark border mt-1">@entry.RecoveryPlanSummary</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                    <partial name="_EmptyState" model='new RestaurantMS.Web.Models.EmptyStateModel { Icon = "bi-person-check", Title = "Adv_SelectEmployee_Title", Description = "Adv_SelectEmployee_Desc" }' />
                </div>
            }
        </div>
    </div>
</div>

<!-- Side Drawer: Give Advance -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="giveAdvanceDrawer" aria-labelledby="giveAdvanceDrawerLabel" style="width: 460px;">
    <div class="offcanvas-header bg-plum text-white">
        <h5 class="offcanvas-title fw-bold" id="giveAdvanceDrawerLabel">
            <i class="bi bi-cash-coin me-2 text-saffron"></i>@Localizer["Adv_GiveAdvance"]
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body bg-cream">
        <form asp-action="GiveAdvance" method="post" id="giveAdvanceForm" class="d-flex flex-column gap-3">
            @Html.AntiForgeryToken()

            <div>
                <label class="form-label fw-semibold small text-ink">@Localizer["Adv_Field_Employee"] <span class="text-danger">*</span></label>
                <select name="StaffId" id="advStaffSelect" class="form-select" required>
                    @foreach (var emp in Model.Employees)
                    {
                        <option value="@emp.StaffId"
                                selected="@(emp.StaffId == Model.SelectedStaffId ? "selected" : null)"
                                data-salary="@emp.MonthlyEquivalentSalary"
                                data-outstanding="@emp.OutstandingBalance"
                                data-active="@emp.IsActive.ToString().ToLowerInvariant()">
                            @emp.EmployeeName (@emp.EmployeeCode) — Salary ₹@emp.MonthlyEquivalentSalary.ToString("N0") @(emp.IsActive ? "" : "[INACTIVE]")
                        </option>
                    }
                </select>
                <div id="advInactiveWarning" class="text-danger small mt-1 d-none">
                    <i class="bi bi-exclamation-octagon-fill me-1"></i>Cannot give advance to an inactive staff member.
                </div>
            </div>

            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label fw-semibold small text-ink">@Localizer["Common_Date"] <span class="text-danger">*</span></label>
                    <input type="date" name="Date" id="advDateInput" class="form-control" value="@todayStr" required />
                </div>
                <div class="col-6">
                    <label class="form-label fw-semibold small text-ink">@Localizer["Common_Amount"] (₹) <span class="text-danger">*</span></label>
                    <input type="number" name="Amount" id="advAmountInput" class="form-control" step="1" min="1" placeholder="e.g. 5000" required />
                </div>
            </div>

            <div id="advSalaryCapAlert" class="alert alert-warning py-2 px-3 small rounded-3 d-none mb-0">
                <div class="fw-bold mb-1"><i class="bi bi-shield-exclamation me-1"></i>Exceeds @Model.MaxAdvanceSalaryPercent.ToString("0.##")% Monthly Salary Limit</div>
                <div id="advSalaryCapText" class="mb-2"></div>
                @if (Model.CanApproveOverride)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="IsManagerOverride" value="true" id="advManagerOverrideCheck" />
                        <label class="form-check-label fw-semibold" for="advManagerOverrideCheck">Manager Override Approved</label>
                    </div>
                    <input type="text" name="ManagerOverrideReason" id="advOverrideReasonInput" class="form-control form-control-sm" placeholder="Mandatory override reason..." />
                }
            </div>

            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label fw-semibold small text-ink">@Localizer["Adv_Field_PaymentMode"] <span class="text-danger">*</span></label>
                    <select name="PaymentMode" class="form-select">
                        <option value="Cash">Cash (Cash in Hand)</option>
                        <option value="Bank">Bank Transfer (HDFC)</option>
                        <option value="UPI">UPI (HDFC Bank)</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label fw-semibold small text-ink">@Localizer["Adv_Field_RecoveryPlan"]</label>
                    <select name="RecoveryPlan" id="advRecoveryPlanSelect" class="form-select">
                        <option value="OneTime">One-Time Recovery</option>
                        <option value="MonthlyInstalment">Monthly Instalment</option>
                    </select>
                </div>
            </div>

            <div class="row g-2 d-none" id="advInstalmentRow">
                <div class="col-6">
                    <label class="form-label fw-semibold small text-ink">@Localizer["Adv_Field_InstalmentAmt"] (₹)</label>
                    <input type="number" name="MonthlyInstalmentAmount" id="advInstalmentAmountInput" class="form-control" step="1" min="1" placeholder="e.g. 2000" />
                </div>
                <div class="col-6">
                    <label class="form-label fw-semibold small text-ink">@Localizer["Adv_Field_StartMonth"]</label>
                    <input type="month" name="StartMonth" id="advStartMonthInput" class="form-control" value="@nextMonthStr" />
                </div>
            </div>

            <div>
                <label class="form-label fw-semibold small text-ink">@Localizer["Adv_Field_Purpose"] <span class="text-danger">*</span></label>
                <input type="text" name="Purpose" class="form-control" placeholder="e.g. Medical emergency, school fees, festival" required />
            </div>

            <div>
                <label class="form-label fw-semibold small text-ink">@Localizer["Adv_Col_Note"]</label>
                <textarea name="Note" class="form-control" rows="2" placeholder="Optional internal remarks"></textarea>
            </div>

            <!-- Live Instalment Schedule Preview -->
            <div class="card border rounded-3 bg-white p-3">
                <div class="small fw-bold text-plum mb-2"><i class="bi bi-calendar-range me-1"></i> @Localizer["Adv_SchedulePreview"]</div>
                <div id="advSchedulePreviewBody" class="small text-muted">
                    Enter amount to preview recovery schedule.
                </div>
            </div>

            <div class="small text-muted bg-white border rounded-3 p-2">
                <i class="bi bi-journal-check text-teal me-1"></i>
                Posts balanced voucher: <strong>Dr Employee Advances A/c</strong> / <strong>Cr Cash or Bank</strong>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-2">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="offcanvas">@Localizer["Common_Cancel"]</button>
                <button type="submit" id="advGiveSubmitBtn" class="btn btn-teal text-white rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-check2-circle me-1"></i> @Localizer["Adv_PostAdvance"]
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Side Drawer: Record Recovery -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="recordRecoveryDrawer" aria-labelledby="recordRecoveryDrawerLabel" style="width: 420px;">
    <div class="offcanvas-header bg-teal text-white">
        <h5 class="offcanvas-title fw-bold" id="recordRecoveryDrawerLabel">
            <i class="bi bi-arrow-down-left-circle me-2"></i>@Localizer["Adv_RecordRecovery"]
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body bg-cream">
        @if (Model.SelectedEmployee is not null)
        {
            <form asp-action="RecordRecovery" method="post" id="recordRecoveryForm" class="d-flex flex-column gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="StaffId" value="@Model.SelectedEmployee.StaffId" />

                <div class="card border rounded-3 bg-white p-3">
                    <div class="fw-bold text-ink">@Model.SelectedEmployee.EmployeeName (@Model.SelectedEmployee.EmployeeCode)</div>
                    <div class="small text-muted">Current Outstanding: <strong class="text-chili font-monospace">₹@Model.SelectedEmployee.OutstandingBalance.ToString("N2")</strong></div>
                </div>

                <div>
                    <label class="form-label fw-semibold small text-ink">@Localizer["Common_Date"] <span class="text-danger">*</span></label>
                    <input type="date" name="Date" class="form-control" value="@todayStr" required />
                </div>

                <div>
                    <label class="form-label fw-semibold small text-ink">@Localizer["Adv_Field_RecoveryAmt"] (₹) <span class="text-danger">*</span></label>
                    <input type="number" name="Amount" id="recAmountInput" class="form-control" step="1" min="1" max="@Model.SelectedEmployee.OutstandingBalance" value="@Math.Min(Model.SelectedEmployee.PlannedMonthlyInstalment > 0 ? Model.SelectedEmployee.PlannedMonthlyInstalment : Model.SelectedEmployee.OutstandingBalance, Model.SelectedEmployee.OutstandingBalance)" required />
                    <div class="form-text small">Max recoverable: ₹@Model.SelectedEmployee.OutstandingBalance.ToString("N2")</div>
                </div>

                <div>
                    <label class="form-label fw-semibold small text-ink">@Localizer["Adv_Field_PaymentMode"] <span class="text-danger">*</span></label>
                    <select name="PaymentMode" class="form-select">
                        <option value="Cash">Cash (Cash in Hand)</option>
                        <option value="Bank">Bank Transfer (HDFC)</option>
                        <option value="UPI">UPI (HDFC Bank)</option>
                        <option value="SalaryDeduction">Salary Deduction (Journal)</option>
                    </select>
                </div>

                <div>
                    <label class="form-label fw-semibold small text-ink">@Localizer["Adv_Col_Note"]</label>
                    <textarea name="Note" class="form-control" rows="2" placeholder="Recovery note or reference"></textarea>
                </div>

                <div class="small text-muted bg-white border rounded-3 p-2">
                    <i class="bi bi-journal-check text-teal me-1"></i>
                    Reverses voucher: <strong>Dr Cash / Bank / Salary Payable</strong> / <strong>Cr Employee Advances A/c</strong>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="offcanvas">@Localizer["Common_Cancel"]</button>
                    <button type="submit" class="btn btn-teal text-white rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> @Localizer["Adv_PostRecovery"]
                    </button>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/employeeAdvances.js" asp-append-version="true"></script>
}
