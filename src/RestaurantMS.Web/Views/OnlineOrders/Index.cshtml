@model RestaurantMS.Web.Models.OnlineOrdersViewModel
@{
    ViewData["Title"] = Localizer["OnlineOrders_Title"].Value;
}

<div class="online-orders-page d-flex flex-column gap-3">
    <!-- Header with Aggregator Status -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h2 class="h4 fw-bold text-ink mb-0"><i class="bi bi-globe2 text-plum me-2"></i> @Localizer["OnlineOrders_Title"]</h2>
                    <span class="badge bg-success-subtle text-success small border border-success-subtle"><i class="bi bi-broadcast me-1"></i> Live Auto-Sync Active</span>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                    <span><strong class="text-ink">@Model.Orders.Count</strong> Total Orders</span>
                    <span>&bull;</span>
                    <span class="text-plum"><strong class="badge bg-plum-subtle text-plum">@Model.NewOrdersCount New Orders</strong></span>
                    <span>&bull;</span>
                    <span class="text-teal fw-bold font-monospace">Net Payout: ₹@Model.NetPayout.ToString("N0")</span>
                </div>
            </div>

            <!-- Aggregator Channel Status Badges -->
            <div class="d-flex flex-wrap gap-2">
                <div class="px-3 py-1 rounded-pill border d-flex align-items-center gap-2 bg-light">
                    <span class="badge rounded-circle p-1" style="background-color: #E23744;">&nbsp;</span>
                    <span class="fw-bold small text-dark">Zomato</span>
                    <span class="badge bg-success rounded-pill small" style="font-size: 0.65rem;">ONLINE</span>
                </div>
                <div class="px-3 py-1 rounded-pill border d-flex align-items-center gap-2 bg-light">
                    <span class="badge rounded-circle p-1" style="background-color: #FC8019;">&nbsp;</span>
                    <span class="fw-bold small text-dark">Swiggy</span>
                    <span class="badge bg-success rounded-pill small" style="font-size: 0.65rem;">ONLINE</span>
                </div>
                <div class="px-3 py-1 rounded-pill border d-flex align-items-center gap-2 bg-light">
                    <span class="badge rounded-circle p-1" style="background-color: #0B7A70;">&nbsp;</span>
                    <span class="fw-bold small text-dark">Direct Web</span>
                    <span class="badge bg-success rounded-pill small" style="font-size: 0.65rem;">ACTIVE</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Filter Pills -->
    <ul class="nav nav-pills gap-2 bg-white p-2 rounded-3 shadow-sm border-0" id="onlineOrderTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active px-3 py-2 fw-semibold" id="tab-all" data-bs-toggle="pill" data-bs-target="#content-all" type="button">
                All Orders <span class="badge bg-secondary ms-1">@Model.Orders.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link px-3 py-2 fw-semibold text-chili" id="tab-new" data-bs-toggle="pill" data-bs-target="#content-new" type="button">
                <i class="bi bi-bell-fill me-1"></i> New Requests <span class="badge bg-chili text-white ms-1">@Model.NewOrdersCount</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link px-3 py-2 fw-semibold text-plum" id="tab-prep" data-bs-toggle="pill" data-bs-target="#content-prep" type="button">
                <i class="bi bi-fire me-1"></i> In Kitchen <span class="badge bg-plum text-white ms-1">@Model.PreparingCount</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link px-3 py-2 fw-semibold text-saffron" id="tab-ready" data-bs-toggle="pill" data-bs-target="#content-ready" type="button">
                <i class="bi bi-box-seam me-1"></i> Food Ready <span class="badge bg-saffron text-dark ms-1">@Model.ReadyCount</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link px-3 py-2 fw-semibold text-teal" id="tab-out" data-bs-toggle="pill" data-bs-target="#content-out" type="button">
                <i class="bi bi-bicycle me-1"></i> Out for Delivery <span class="badge bg-teal text-white ms-1">@Model.OutForDeliveryCount</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link px-3 py-2 fw-semibold text-muted" id="tab-done" data-bs-toggle="pill" data-bs-target="#content-done" type="button">
                <i class="bi bi-check2-circle me-1"></i> Delivered <span class="badge bg-light text-dark border ms-1">@Model.DeliveredCount</span>
            </button>
        </li>
    </ul>

    <!-- Orders Cards Grid -->
    <div class="row g-3">
        @foreach (var order in Model.Orders)
        {
            var isZomato = order.Channel == "Zomato";
            var isSwiggy = order.Channel == "Swiggy";
            var channelColor = isZomato ? "#E23744" : isSwiggy ? "#FC8019" : "#0B7A70";

            <div class="col-12 col-lg-6 col-xl-4 order-card-wrapper" data-status="@order.Status">
                <div class="card border-0 shadow-sm rounded-3 bg-white h-100 d-flex flex-column justify-content-between overflow-hidden">
                    <!-- Top Ribbon with Channel & ID -->
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="border-top: 4px solid @channelColor !important;">
                        <div>
                            <span class="badge text-white px-2 py-1 fw-bold" style="background-color: @channelColor;">
                                @order.Channel
                            </span>
                            <span class="fw-bold font-monospace text-ink ms-1">@order.OrderId</span>
                        </div>
                        <div class="text-end small">
                            <span class="text-muted"><i class="bi bi-clock me-1"></i>@order.OrderTime</span>
                        </div>
                    </div>

                    <!-- Order Details -->
                    <div class="p-3 flex-grow-1">
                        <!-- Customer Info -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="fw-bold text-ink mb-0">@order.CustomerName</h6>
                                <small class="text-muted font-monospace"><i class="bi bi-telephone me-1"></i>@order.CustomerPhone</small>
                            </div>
                            <span class="badge bg-light text-dark border font-monospace fs-6">₹@order.TotalAmount.ToString("N0")</span>
                        </div>

                        <!-- Delivery Address -->
                        <div class="p-2 rounded bg-light small text-muted mb-3 d-flex align-items-start gap-1">
                            <i class="bi bi-geo-alt-fill text-plum flex-shrink-0 mt-1"></i>
                            <span class="text-truncate-2">@order.DeliveryAddress</span>
                        </div>

                        <!-- Items Summary -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Dishes / Items</label>
                            <div class="fw-semibold text-ink small bg-cream p-2 rounded border">
                                @order.ItemsSummary
                            </div>
                        </div>

                        <!-- Rider & Financials -->
                        <div class="d-flex justify-content-between align-items-center small p-2 rounded bg-light border">
                            <div>
                                <span class="text-muted d-block">Rider / Pickup:</span>
                                <span class="fw-bold text-ink">@(order.RiderName ?? "Assigning rider...")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(order.RiderOtp))
                            {
                                <div class="text-end">
                                    <span class="text-muted d-block">Pickup OTP:</span>
                                    <span class="badge bg-plum font-monospace px-2 py-1">@order.RiderOtp</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Action Footer -->
                    <div class="p-3 border-top bg-light d-flex justify-content-between align-items-center gap-2">
                        <div class="small">
                            <span class="text-muted">Net: </span>
                            <strong class="text-teal font-monospace">₹@order.NetPayout.ToString("N0")</strong>
                        </div>

                        <div class="d-flex gap-1">
                            @if (order.Status == "New")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <input type="hidden" name="newStatus" value="InPreparation" />
                                    <button type="submit" class="btn btn-sm btn-teal fw-bold">
                                        <i class="bi bi-check2 me-1"></i> Accept &amp; KOT (@order.PrepTimeMinutes m)
                                    </button>
                                </form>
                            }
                            else if (order.Status == "InPreparation")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <input type="hidden" name="newStatus" value="FoodReady" />
                                    <button type="submit" class="btn btn-sm btn-saffron text-dark fw-bold">
                                        <i class="bi bi-bell-fill me-1"></i> Food Ready
                                    </button>
                                </form>
                            }
                            else if (order.Status == "FoodReady")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <input type="hidden" name="newStatus" value="OutForDelivery" />
                                    <button type="submit" class="btn btn-sm btn-plum fw-bold">
                                        <i class="bi bi-bicycle me-1"></i> Handover to Rider
                                    </button>
                                </form>
                            }
                            else if (order.Status == "OutForDelivery")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <input type="hidden" name="newStatus" value="Delivered" />
                                    <button type="submit" class="btn btn-sm btn-outline-teal fw-bold">
                                        <i class="bi bi-check-all me-1"></i> Mark Delivered
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success py-2 px-3 fw-bold">
                                    <i class="bi bi-check2-circle me-1"></i> Delivered
                                </span>
                            }

                            <!-- Customer WhatsApp Ping -->
                            <button type="button" class="btn btn-sm btn-outline-success p-1 px-2" onclick="sendBillOnWhatsApp('@order.CustomerPhone', '@order.OrderId', '₹@order.TotalAmount')" title="Message customer on WhatsApp">
                                <i class="bi bi-whatsapp"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('#onlineOrderTabs button').forEach(btn => {
    btn.addEventListener('click', function() {
        const id = this.id;
        const cards = document.querySelectorAll('.order-card-wrapper');
        let targetStatus = '';
        if (id === 'tab-new') targetStatus = 'New';
        else if (id === 'tab-prep') targetStatus = 'InPreparation';
        else if (id === 'tab-ready') targetStatus = 'FoodReady';
        else if (id === 'tab-out') targetStatus = 'OutForDelivery';
        else if (id === 'tab-done') targetStatus = 'Delivered';

        cards.forEach(card => {
            const status = card.getAttribute('data-status');
            if (!targetStatus || status === targetStatus) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    });
});
</script>
}
