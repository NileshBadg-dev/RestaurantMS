@model RestaurantMS.Web.Models.TablesViewModel
@{
    ViewData["Title"] = Localizer["Tables_Title"].Value;
}

<div class="tables-page d-flex flex-column gap-3">
    <!-- Header with Legend & Quick Statistics -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1">@Localizer["Tables_Title"]</h2>
                <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                    <span><strong class="text-ink">@Model.TotalTables</strong> Total Tables</span>
                    <span>&bull;</span>
                    <span class="text-teal"><strong class="badge bg-teal-subtle text-teal">@Model.FreeCount Free</strong></span>
                    <span class="text-chili"><strong class="badge bg-danger-subtle text-chili">@Model.OccupiedCount Occupied</strong></span>
                    <span class="text-saffron"><strong class="badge bg-warning-subtle text-dark">@Model.ReservedCount Reserved</strong></span>
                    <span class="text-muted"><strong class="badge bg-secondary-subtle text-secondary">@Model.CleaningCount Cleaning</strong></span>
                    <span>&bull;</span>
                    <span class="fw-bold text-plum font-monospace">Running: ₹@Model.TotalRunningSales.ToString("N0")</span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Parcel" asp-action="Create" class="btn btn-outline-plum px-3 py-2 fw-semibold">
                    <i class="bi bi-box-seam me-1"></i> New Parcel
                </a>
                <a asp-controller="Orders" asp-action="New" class="btn btn-plum px-3 py-2 fw-semibold shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> New Order (F2)
                </a>
            </div>
        </div>

        <!-- Section Navigation Tabs -->
        <div class="d-flex gap-2 border-top mt-3 pt-3 overflow-x-auto">
            @foreach (var s in Model.Sections)
            {
                <a asp-action="Index" asp-route-section="@s.Name" class="btn btn-sm @(Model.SelectedSection == s.Name ? "btn-plum" : "btn-light border") rounded-pill px-3">
                    @s.Name (@s.TotalTables)
                </a>
            }
        </div>
    </div>

    <!-- Table Cards Grid -->
    <div class="row g-3">
        @foreach (var table in Model.Tables)
        {
            var isOccupied = table.Status.Equals("Occupied", StringComparison.OrdinalIgnoreCase);
            var isFree = table.Status.Equals("Free", StringComparison.OrdinalIgnoreCase);
            var isReserved = table.Status.Equals("Reserved", StringComparison.OrdinalIgnoreCase);
            var isCleaning = table.Status.Equals("Cleaning", StringComparison.OrdinalIgnoreCase);

            var borderClass = isOccupied ? "table-card-occupied" :
                              isFree ? "table-card-free" :
                              isReserved ? "table-card-reserved" : "table-card-cleaning";

            var headerBg = isOccupied ? "bg-chili text-white" :
                           isFree ? "bg-teal text-white" :
                           isReserved ? "bg-saffron text-dark" : "bg-secondary text-white";

            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                <div class="card h-100 border-0 shadow-sm rounded-3 table-card @borderClass">
                    <!-- Card Header -->
                    <div class="card-header @headerBg py-2 px-3 d-flex justify-content-between align-items-center rounded-top">
                        <span class="fw-bold fs-5 font-monospace">@table.TableCode</span>
                        <span class="small opacity-75"><i class="bi bi-people-fill me-1"></i>@table.Capacity</span>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body p-3 d-flex flex-column justify-content-between bg-white">
                        @if (isOccupied)
                        {
                            <div>
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Section:</span>
                                    <span class="fw-semibold text-ink">@table.Section</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="badge @((table.ElapsedMinutes ?? 0) > 45 ? "bg-chili" : "bg-light text-dark border") small">
                                        <i class="bi bi-stopwatch me-1"></i>@(table.ElapsedMinutes ?? 0) min
                                    </span>
                                    <span class="fw-bold font-monospace text-chili fs-6">₹@((table.CurrentBillAmount ?? 0).ToString("N0"))</span>
                                </div>
                            </div>

                            <div class="mt-3 pt-2 border-top d-flex gap-1">
                                <a asp-controller="Billing" asp-action="Index" asp-route-table="@table.TableCode" class="btn btn-sm btn-teal flex-grow-1 text-white fw-semibold">
                                    <i class="bi bi-receipt"></i> Bill
                                </a>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary px-2" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                        <li><a class="dropdown-item small" asp-controller="Orders" asp-action="New" asp-route-table="@table.TableCode"><i class="bi bi-plus-circle me-2 text-plum"></i> Add Items</a></li>
                                        <li><a class="dropdown-item small" href="#" onclick="alert('Table transfer for ' + '@table.TableCode')"><i class="bi bi-arrow-left-right me-2 text-primary"></i> Transfer Table</a></li>
                                        <li><a class="dropdown-item small" href="#" onclick="alert('Marked cleaning')"><i class="bi bi-stars me-2 text-secondary"></i> Mark Cleaning</a></li>
                                    </ul>
                                </div>
                            </div>
                        }
                        else if (isFree)
                        {
                            <div class="text-center py-3">
                                <i class="bi bi-check-circle-fill text-teal display-6 mb-2 d-block"></i>
                                <div class="fw-semibold text-teal">Available</div>
                                <small class="text-muted">@table.Section</small>
                            </div>

                            <div class="mt-auto">
                                <a asp-controller="Orders" asp-action="New" asp-route-table="@table.TableCode" class="btn btn-sm btn-outline-plum w-100 fw-semibold">
                                    <i class="bi bi-plus-lg me-1"></i> Take Order
                                </a>
                            </div>
                        }
                        else if (isReserved)
                        {
                            <div class="text-center py-2">
                                <i class="bi bi-bookmark-star-fill text-saffron fs-2 mb-1 d-block"></i>
                                <div class="fw-bold text-dark">Reserved</div>
                                <small class="text-muted d-block font-monospace">@table.ReservedTime</small>
                                <small class="text-muted">@table.Section</small>
                            </div>

                            <div class="mt-auto">
                                <a asp-controller="Orders" asp-action="New" asp-route-table="@table.TableCode" class="btn btn-sm btn-saffron text-dark w-100 fw-semibold">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Seat Guest
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-2">
                                <i class="bi bi-stars text-muted fs-2 mb-1 d-block"></i>
                                <div class="fw-semibold text-muted">Cleaning</div>
                                <small class="text-muted">@table.Section</small>
                            </div>

                            <div class="mt-auto">
                                <button type="button" class="btn btn-sm btn-outline-teal w-100 fw-semibold" onclick="alert('Table @table.TableCode is now Free!')">
                                    <i class="bi bi-check-lg me-1"></i> Mark Free
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
