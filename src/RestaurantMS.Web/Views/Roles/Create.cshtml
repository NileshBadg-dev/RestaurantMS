@model RestaurantMS.Web.Models.CreateRoleViewModel
@{
    ViewData["Title"] = Localizer["Roles_CreateNew"].Value;
}

<div class="mx-auto" style="max-width: 680px;">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <form asp-action="Create" method="post" data-app-form="true" novalidate>
            @Html.AntiForgeryToken()

            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 js-form-error-summary @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="mb-0"></div> }
            </div>

            <partial name="_FormSection" model='new RestaurantMS.Web.Models.FormSectionModel { Title = Localizer["Roles_CreateNew"].Value, HelperText = "Define a custom access role and configure permissions in the matrix", Icon = "bi-shield-lock" }' />

            <div class="row g-3 mb-3">
                <div class="col-12 app-form-field">
                    <label asp-for="Name" class="form-label fw-semibold small text-ink mb-1">Role Name <span class="text-chili">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Floor Supervisor" required />
                    <span asp-validation-for="Name" class="invalid-feedback d-block small js-field-error"></span>
                </div>
                <div class="col-12 app-form-field">
                    <label asp-for="Description" class="form-label fw-semibold small text-ink mb-1">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief explanation of duties and access scope"></textarea>
                    <span asp-validation-for="Description" class="invalid-feedback d-block small js-field-error"></span>
                </div>
            </div>

            <partial name="_FormFooter" model='new RestaurantMS.Web.Models.FormFooterModel { CancelUrl = Url.Action("Index", "Roles")!, ShowSaveAndNew = false }' />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
