@model RestaurantMS.Web.Models.EditRoleViewModel
@{
    ViewData["Title"] = Localizer["Roles_EditRole"].Value;
}

<div class="row justify-content-center py-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">@Localizer["Roles_EditRole"]: @Model.Name</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["Btn_Back"]</a>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        @ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage
                    </div>
                }

                <form asp-action="Edit" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="IsSystemRole" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold small text-secondary"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">@Localizer["Btn_Cancel"]</a>
                        <button type="submit" class="btn btn-primary btn-sm px-4">@Localizer["Btn_Save"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
