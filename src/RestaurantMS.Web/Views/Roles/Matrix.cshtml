@model RestaurantMS.Web.Models.RolePermissionMatrixViewModel
@{
    ViewData["Title"] = $"{Localizer["Roles_Matrix_Title"].Value} {Model.Matrix.RoleName}";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1">
            @Localizer["Roles_Matrix_Title"] <span class="text-primary">@Model.Matrix.RoleName</span>
        </h2>
        <p class="text-muted small mb-0">Configure granted actions per screen for this role.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">@Localizer["Btn_Back"]</a>
        <button type="submit" form="matrixForm" class="btn btn-primary btn-sm px-4">@Localizer["Btn_Save"]</button>
    </div>
</div>

<form id="matrixForm" asp-action="Matrix" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="roleId" value="@Model.Matrix.RoleId" />

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <span class="small fw-semibold text-muted">Toggle capabilities per screen or select column/row quick toggles</span>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary" id="selectAllBtn">Select All</button>
                <button type="button" class="btn btn-outline-secondary" id="deselectAllBtn">Deselect All</button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle text-center mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-start ps-4" style="width: 25%;">@Localizer["Roles_Matrix_Screen"]</th>
                        <th style="width: 12%;">View</th>
                        <th style="width: 12%;">Create</th>
                        <th style="width: 12%;">Edit</th>
                        <th style="width: 12%;">Delete</th>
                        <th style="width: 12%;">Print</th>
                        <th style="width: 12%;">Export</th>
                        <th style="width: 5%;">Row</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Matrix.Rows)
                    {
                        <tr>
                            <td class="text-start ps-4 fw-semibold text-dark">
                                <i class="bi bi-folder2-open me-2 text-primary"></i>@row.Screen
                            </td>

                            <!-- View -->
                            <td>
                                @if (row.View is not null)
                                {
                                    <input type="checkbox" name="selectedPermissions" value="@row.View.PermissionId"
                                           class="form-check-input perm-cb perm-row-@row.Screen"
                                           @(row.View.IsGranted ? "checked" : "") />
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>

                            <!-- Create -->
                            <td>
                                @if (row.Create is not null)
                                {
                                    <input type="checkbox" name="selectedPermissions" value="@row.Create.PermissionId"
                                           class="form-check-input perm-cb perm-row-@row.Screen"
                                           @(row.Create.IsGranted ? "checked" : "") />
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>

                            <!-- Edit -->
                            <td>
                                @if (row.Edit is not null)
                                {
                                    <input type="checkbox" name="selectedPermissions" value="@row.Edit.PermissionId"
                                           class="form-check-input perm-cb perm-row-@row.Screen"
                                           @(row.Edit.IsGranted ? "checked" : "") />
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>

                            <!-- Delete -->
                            <td>
                                @if (row.Delete is not null)
                                {
                                    <input type="checkbox" name="selectedPermissions" value="@row.Delete.PermissionId"
                                           class="form-check-input perm-cb perm-row-@row.Screen"
                                           @(row.Delete.IsGranted ? "checked" : "") />
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>

                            <!-- Print -->
                            <td>
                                @if (row.Print is not null)
                                {
                                    <input type="checkbox" name="selectedPermissions" value="@row.Print.PermissionId"
                                           class="form-check-input perm-cb perm-row-@row.Screen"
                                           @(row.Print.IsGranted ? "checked" : "") />
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>

                            <!-- Export -->
                            <td>
                                @if (row.Export is not null)
                                {
                                    <input type="checkbox" name="selectedPermissions" value="@row.Export.PermissionId"
                                           class="form-check-input perm-cb perm-row-@row.Screen"
                                           @(row.Export.IsGranted ? "checked" : "") />
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>

                            <!-- Row Quick Toggle -->
                            <td>
                                <button type="button" class="btn btn-link btn-sm text-secondary p-0 toggle-row-btn" data-row="@row.Screen" title="Toggle entire row">
                                    <i class="bi bi-check2-all"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex justify-content-end py-3">
            <button type="submit" class="btn btn-primary btn-sm px-4">@Localizer["Btn_Save"]</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.getElementById('selectAllBtn').addEventListener('click', function () {
            document.querySelectorAll('.perm-cb').forEach(cb => cb.checked = true);
        });

        document.getElementById('deselectAllBtn').addEventListener('click', function () {
            document.querySelectorAll('.perm-cb').forEach(cb => cb.checked = false);
        });

        document.querySelectorAll('.toggle-row-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                var screen = this.getAttribute('data-row');
                var cbs = document.querySelectorAll('.perm-row-' + screen);
                var anyUnchecked = Array.from(cbs).some(cb => !cb.checked);
                cbs.forEach(cb => cb.checked = anyUnchecked);
            });
        });
    </script>
}
