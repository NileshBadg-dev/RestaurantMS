@model RestaurantMS.Web.Models.CashBookViewModel
@{
    ViewData["Title"] = Localizer["Accounts_CashBook_Title"].Value;
}

<div class="cashbook-page d-flex flex-column gap-3">
    <!-- Header with Balance Summary -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-wallet2 text-teal me-2"></i> @Localizer["Accounts_CashBook_Title"]</h2>
                <div class="text-muted small">Cash-in-hand register with daily receipts and payments</div>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Accounts</a>
        </div>

        <div class="row g-2">
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 bg-light border text-end">
                    <div class="small text-muted">Opening Balance</div>
                    <div class="fs-5 fw-bold font-monospace text-ink">₹@Model.OpeningBalance.ToString("N2")</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 bg-teal-subtle text-teal border border-teal-subtle text-end">
                    <div class="small fw-semibold">Total Receipts (+)</div>
                    <div class="fs-5 fw-bold font-monospace">₹@Model.TotalReceipts.ToString("N2")</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 bg-danger-subtle text-chili border border-danger-subtle text-end">
                    <div class="small fw-semibold">Total Payments (-)</div>
                    <div class="fs-5 fw-bold font-monospace">₹@Model.TotalPayments.ToString("N2")</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 bg-cream border text-end">
                    <div class="small text-muted">Closing Balance</div>
                    <div class="fs-5 fw-bold font-monospace text-plum">₹@Model.ClosingBalance.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cash Book Transactions Table -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 font-monospace">
                <thead class="table-light small text-muted text-uppercase font-sans">
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Voucher #</th>
                        <th class="font-sans">Particulars</th>
                        <th class="text-end text-teal">Receipt (In)</th>
                        <th class="text-end text-chili">Payment (Out)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td class="small text-muted">@t.Time</td>
                            <td class="fw-semibold text-plum">@t.VoucherNo</td>
                            <td class="font-sans small">@t.AccountName @(string.IsNullOrEmpty(t.Narration) ? "" : $"({t.Narration})")</td>
                            <td class="text-end @(t.DebitAmount > 0 ? "text-teal fw-bold" : "text-muted")">@(t.DebitAmount > 0 ? "₹" + t.DebitAmount.ToString("N2") : "-")</td>
                            <td class="text-end @(t.CreditAmount > 0 ? "text-chili fw-bold" : "text-muted")">@(t.CreditAmount > 0 ? "₹" + t.CreditAmount.ToString("N2") : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
