@model RestaurantMS.Web.Models.VoucherFormViewModel
@{
    ViewData["Title"] = Localizer["Accounts_CreateVoucher_Title"].Value;
}

<div class="mx-auto" style="max-width: 960px;">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-journal-plus text-plum me-2"></i>@Localizer["Accounts_CreateVoucher_Title"]</h2>
                <div class="text-muted small">Post balanced double-entry accounting &amp; expense vouchers</div>
            </div>
            <a asp-action="Vouchers" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Vouchers
            </a>
        </div>

        <form asp-action="CreateVoucher" method="post" id="voucherForm" data-app-form="true" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TotalDebit" id="TotalDebitHidden" />
            <input type="hidden" asp-for="TotalCredit" id="TotalCreditHidden" />

            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 js-form-error-summary @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="mb-0"></div>
                }
            </div>

            <!-- Section 1: Voucher Header -->
            <div class="mb-4">
                <partial name="_FormSection" model='new RestaurantMS.Web.Models.FormSectionModel { Title = Localizer["Form_Sec_VoucherHeader"].Value, HelperText = Localizer["Form_Sec_VoucherHeader_Help"].Value, Icon = "bi-receipt" }' />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold small text-ink mb-1">Voucher Type <span class="text-chili">*</span></label>
                        <div class="app-segmented-control">
                            <div class="seg-option">
                                <input type="radio" name="VoucherType" id="vchPayment" value="Payment" checked="@(Model.VoucherType == "Payment" ? "checked" : null)" />
                                <label for="vchPayment"><i class="bi bi-arrow-up-right text-chili"></i> Payment / Expense</label>
                            </div>
                            <div class="seg-option">
                                <input type="radio" name="VoucherType" id="vchReceipt" value="Receipt" checked="@(Model.VoucherType == "Receipt" ? "checked" : null)" />
                                <label for="vchReceipt"><i class="bi bi-arrow-down-left text-teal"></i> Receipt</label>
                            </div>
                            <div class="seg-option">
                                <input type="radio" name="VoucherType" id="vchJournal" value="Journal" checked="@(Model.VoucherType == "Journal" || string.IsNullOrEmpty(Model.VoucherType) ? "checked" : null)" />
                                <label for="vchJournal"><i class="bi bi-journal-text text-plum"></i> Journal</label>
                            </div>
                            <div class="seg-option">
                                <input type="radio" name="VoucherType" id="vchContra" value="Contra" checked="@(Model.VoucherType == "Contra" ? "checked" : null)" />
                                <label for="vchContra"><i class="bi bi-arrow-left-right"></i> Contra</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="VoucherNumber" class="form-label fw-semibold small text-ink mb-1">Voucher Number</label>
                        <input asp-for="VoucherNumber" class="form-control font-monospace bg-light" readonly />
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="Date" class="form-label fw-semibold small text-ink mb-1">Voucher Date <span class="text-chili">*</span></label>
                        <input asp-for="Date" type="date" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
            </div>

            <!-- Section 2: Double-Entry Ledger Lines -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="flex-grow-1">
                        <partial name="_FormSection" model='new RestaurantMS.Web.Models.FormSectionModel { Title = Localizer["Form_Sec_VoucherLines"].Value, HelperText = Localizer["Form_Sec_VoucherLines_Help"].Value, Icon = "bi-list-columns" }' />
                    </div>
                    <button type="button" id="addVoucherLineBtn" class="btn btn-sm btn-outline-plum rounded-pill px-3 ms-3 mb-3">
                        <i class="bi bi-plus-lg me-1"></i> Add Line
                    </button>
                </div>

                <div class="table-responsive border rounded-3 p-2 bg-cream-soft">
                    <table class="table table-sm align-middle mb-0" id="voucherLinesTable">
                        <thead class="small text-muted text-uppercase">
                            <tr>
                                <th>Ledger Account</th>
                                <th style="width: 150px;">Debit</th>
                                <th style="width: 150px;">Credit</th>
                                <th>Line Memo</th>
                                <th style="width: 40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Lines.Count; i++)
                            {
                                <tr>
                                    <td><input type="text" name="Lines[@i].AccountName" class="form-control form-control-sm" value="@Model.Lines[i].AccountName" required /></td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input type="number" name="Lines[@i].Debit" class="form-control text-end js-vch-dr" step="0.01" min="0" value="@Model.Lines[i].Debit" />
                                            <span class="input-group-text">₹</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input type="number" name="Lines[@i].Credit" class="form-control text-end js-vch-cr" step="0.01" min="0" value="@Model.Lines[i].Credit" />
                                            <span class="input-group-text">₹</span>
                                        </div>
                                    </td>
                                    <td><input type="text" name="Lines[@i].Narration" class="form-control form-control-sm" value="@Model.Lines[i].Narration" /></td>
                                    <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger js-del-line"><i class="bi bi-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold font-monospace">
                            <tr>
                                <td class="text-end">Totals:</td>
                                <td class="text-end text-chili" id="totalDebitCell">₹@Model.TotalDebit.ToString("N2")</td>
                                <td class="text-end text-teal" id="totalCreditCell">₹@Model.TotalCredit.ToString("N2")</td>
                                <td colspan="2"><span class="badge bg-teal text-white" id="balanceStatusBadge">Balanced</span></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Section 3: Narration -->
            <div class="mb-3">
                <partial name="_FormSection" model='new RestaurantMS.Web.Models.FormSectionModel { Title = Localizer["Form_Sec_Narration"].Value, HelperText = Localizer["Form_Sec_Narration_Help"].Value, Icon = "bi-chat-left-text" }' />
                <div class="app-form-field">
                    <label asp-for="Narration" class="form-label fw-semibold small text-ink mb-1">Overall Narration <span class="text-chili">*</span></label>
                    <textarea asp-for="Narration" class="form-control" rows="2" placeholder="Describe the accounting or expense purpose" required></textarea>
                    <span asp-validation-for="Narration" class="invalid-feedback d-block small js-field-error"></span>
                </div>
            </div>

            <partial name="_FormFooter" model='new RestaurantMS.Web.Models.FormFooterModel { CancelUrl = Url.Action("Vouchers", "Accounts")!, SaveLabelKey = "Form_PostVoucher", ShowSaveAndNew = true }' />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/modules/transactionForms.js" asp-append-version="true"></script>
}
