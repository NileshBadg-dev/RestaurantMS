@model RestaurantMS.Web.Models.VoucherFormViewModel
@{
    ViewData["Title"] = Localizer["Accounts_CreateVoucher_Title"].Value;
}

<div class="create-voucher-page" style="max-width: 900px; margin: 0 auto;">
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h3 class="h4 fw-bold text-ink mb-1"><i class="bi bi-journal-plus text-plum me-2"></i> @Localizer["Accounts_CreateVoucher_Title"]</h3>
                <div class="text-muted small">Record double-entry transaction voucher with debits and credits</div>
            </div>
            <a asp-action="Vouchers" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Vouchers
            </a>
        </div>

        <form asp-action="CreateVoucher" method="post" id="voucherForm">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage
                </div>
            }

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <label asp-for="VoucherType" class="form-label fw-bold small text-ink">Voucher Type *</label>
                    <select asp-for="VoucherType" class="form-select">
                        <option value="Journal">Journal Voucher (General)</option>
                        <option value="Payment">Payment Voucher (Cash/Bank Out)</option>
                        <option value="Receipt">Receipt Voucher (Cash/Bank In)</option>
                        <option value="Contra">Contra Voucher (Cash to Bank / Bank to Cash)</option>
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="VoucherNumber" class="form-label fw-bold small text-ink">Voucher Number</label>
                    <input asp-for="VoucherNumber" class="form-control font-monospace" readonly />
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Date" class="form-label fw-bold small text-ink">Date</label>
                    <input asp-for="Date" type="date" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                </div>
            </div>

            <!-- Double-entry Lines Table -->
            <div class="table-responsive mb-3 border rounded-3 p-2 bg-light">
                <table class="table table-sm align-middle mb-0" id="voucherLinesTable">
                    <thead class="small text-muted text-uppercase">
                        <tr>
                            <th>Ledger Account</th>
                            <th style="width: 140px;" class="text-end">Debit (₹)</th>
                            <th style="width: 140px;" class="text-end">Credit (₹)</th>
                            <th>Narration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Lines.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input type="text" name="Lines[@i].AccountName" class="form-control form-control-sm" value="@Model.Lines[i].AccountName" />
                                </td>
                                <td>
                                    <input type="number" name="Lines[@i].Debit" class="form-control form-control-sm text-end" value="@Model.Lines[i].Debit" onchange="recalculateVoucherTotals()" />
                                </td>
                                <td>
                                    <input type="number" name="Lines[@i].Credit" class="form-control form-control-sm text-end" value="@Model.Lines[i].Credit" onchange="recalculateVoucherTotals()" />
                                </td>
                                <td>
                                    <input type="text" name="Lines[@i].Narration" class="form-control form-control-sm" value="@Model.Lines[i].Narration" />
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold font-monospace">
                        <tr>
                            <td class="text-end">Totals:</td>
                            <td class="text-end text-chili" id="totalDebitCell">₹@Model.TotalDebit.ToString("N2")</td>
                            <td class="text-end text-teal" id="totalCreditCell">₹@Model.TotalCredit.ToString("N2")</td>
                            <td><span class="badge bg-teal text-white" id="balanceStatusBadge">Balanced</span></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="mb-4">
                <label asp-for="Narration" class="form-label fw-bold small text-ink">Overall Narration</label>
                <textarea asp-for="Narration" class="form-control" rows="2" placeholder="Describe the transaction purpose"></textarea>
            </div>

            <div class="border-top pt-3 d-flex justify-content-end gap-2">
                <a asp-action="Vouchers" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                <button type="submit" class="btn btn-plum px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-check-circle me-1"></i> Post Voucher
                </button>
            </div>
        </form>
    </div>
</div>
