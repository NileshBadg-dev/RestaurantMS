@model RestaurantMS.Web.Models.ChartOfAccountsViewModel
@{
    ViewData["Title"] = Localizer["Accounts_Title"].Value;
}

<div class="accounts-page d-flex flex-column gap-3">
    <!-- Header with Accounting Navigation -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-journal-bookmark text-plum me-2"></i> @Localizer["Accounts_Title"]</h2>
                <div class="d-flex align-items-center gap-3 text-muted small">
                    <span>Assets: <strong class="text-teal font-monospace">₹@Model.TotalAssets.ToString("N0")</strong></span>
                    <span>&bull;</span>
                    <span>Liabilities: <strong class="text-chili font-monospace">₹@Model.TotalLiabilities.ToString("N0")</strong></span>
                    <span>&bull;</span>
                    <span>Net Equity: <strong class="text-plum font-monospace">₹@Model.TotalEquity.ToString("N0")</strong></span>
                </div>
            </div>

            <!-- Accounting Quick Links -->
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="DayBook" class="btn btn-outline-plum btn-sm fw-semibold">Day Book</a>
                <a asp-action="CashBook" class="btn btn-outline-plum btn-sm fw-semibold">Cash Book</a>
                <a asp-action="Vouchers" class="btn btn-outline-plum btn-sm fw-semibold">Vouchers</a>
                <a asp-action="TrialBalance" class="btn btn-outline-plum btn-sm fw-semibold">Trial Balance</a>
                <a asp-action="ProfitLoss" class="btn btn-outline-plum btn-sm fw-semibold">P&amp;L</a>
                <a asp-action="BalanceSheet" class="btn btn-outline-plum btn-sm fw-semibold">Balance Sheet</a>
                <a asp-action="CreateVoucher" class="btn btn-plum btn-sm fw-semibold shadow-sm">+ Voucher</a>
            </div>
        </div>
    </div>

    <!-- Chart of Accounts Tree View -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
        <h6 class="fw-bold text-ink mb-3"><i class="bi bi-diagram-3 me-1 text-plum"></i> Chart of Accounts Tree</h6>

        <div class="account-tree">
            @foreach (var root in Model.RootAccounts)
            {
                <div class="account-group mb-3 p-3 bg-light rounded-3 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-plum fs-6"><i class="bi bi-folder-fill me-2 text-saffron"></i>@root.Code &bull; @root.Name</span>
                        <span class="badge bg-cream text-dark border font-monospace">₹@root.Balance.ToString("N2")</span>
                    </div>

                    @if (root.Children.Count > 0)
                    {
                        <div class="ms-4 mt-2 d-flex flex-column gap-1">
                            @foreach (var child in root.Children)
                            {
                                <div class="d-flex justify-content-between align-items-center p-2 rounded bg-white border-bottom">
                                    <span class="small text-ink"><i class="bi bi-file-earmark-text me-2 text-muted"></i>@child.Code &bull; @child.Name</span>
                                    <span class="small font-monospace text-muted">₹@child.Balance.ToString("N2")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
