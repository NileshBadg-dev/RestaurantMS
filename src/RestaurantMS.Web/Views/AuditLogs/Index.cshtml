@model RestaurantMS.Web.Models.AuditLogsViewModel
@{
    ViewData["Title"] = "System Audit & Activity Log";
}

<div class="audit-logs-page d-flex flex-column gap-3">
    <!-- Header with Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h2 class="h4 fw-bold text-ink mb-0">
                        <i class="bi bi-activity text-chili me-1"></i> System Activity &amp; Audit Log
                    </h2>
                    <span class="badge bg-danger-subtle text-chili fw-bold px-2 py-1">Admin Only</span>
                </div>
                <div class="text-muted small mt-1">Tracks who generated anything across Billing, Orders, KOT, Voids, Discounts, and Auth.</div>
            </div>

            <!-- Export Buttons -->
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print
                </button>
                <button type="button" class="btn btn-outline-plum btn-sm" onclick="alert('Exporting audit trail to Excel...')">
                    <i class="bi bi-file-earmark-excel me-1 text-teal"></i> Export Excel
                </button>
            </div>
        </div>

        <!-- Filter Controls -->
        <form method="get" class="row g-2 align-items-end mt-2 pt-2 border-top">
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">User / Staff</label>
                <select name="user" class="form-select form-select-sm" onchange="this.form.submit()">
                    <!option value="All" @(Model.SelectedUser == "All" ? "selected" : "")>All Users</!option>
                    <!option value="admin" @(Model.SelectedUser == "admin" ? "selected" : "")>admin (Owner/Admin)</!option>
                    <!option value="Cashier" @(Model.SelectedUser == "Cashier" ? "selected" : "")>Cashier</!option>
                    <!option value="Waiter" @(Model.SelectedUser == "Waiter" ? "selected" : "")>Waiter</!option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Action Type</label>
                <select name="action" class="form-select form-select-sm" onchange="this.form.submit()">
                    <!option value="All" @(Model.SelectedAction == "All" ? "selected" : "")>All Actions</!option>
                    <!option value="Bill Settled" @(Model.SelectedAction == "Bill Settled" ? "selected" : "")>Bill Settled</!option>
                    <!option value="KOT Generated" @(Model.SelectedAction == "KOT Generated" ? "selected" : "")>KOT Generated</!option>
                    <!option value="User Login" @(Model.SelectedAction == "User Login" ? "selected" : "")>User Login</!option>
                    <!option value="Void" @(Model.SelectedAction == "Void" ? "selected" : "")>Void / Cancellation</!option>
                    <!option value="Discount" @(Model.SelectedAction == "Discount" ? "selected" : "")>Discount Applied</!option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Module</label>
                <select name="module" class="form-select form-select-sm" onchange="this.form.submit()">
                    <!option value="All" @(Model.SelectedModule == "All" ? "selected" : "")>All Modules</!option>
                    <!option value="Billing" @(Model.SelectedModule == "Billing" ? "selected" : "")>Billing</!option>
                    <!option value="Orders" @(Model.SelectedModule == "Orders" ? "selected" : "")>Orders / POS</!option>
                    <!option value="Kitchen" @(Model.SelectedModule == "Kitchen" ? "selected" : "")>Kitchen</!option>
                    <!option value="Accounts" @(Model.SelectedModule == "Accounts" ? "selected" : "")>Accounts</!option>
                    <!option value="Auth" @(Model.SelectedModule == "Auth" ? "selected" : "")>Auth</!option>
                </select>
            </div>
            <div class="col-6 col-md-4 d-flex gap-2">
                <div class="flex-grow-1">
                    <label class="form-label small fw-semibold text-muted mb-1">Date</label>
                    <input type="date" name="from" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))" onchange="this.form.submit()" />
                </div>
                <div class="d-flex align-items-end">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear filters">Reset</a>
                </div>
            </div>
        </form>
    </div>

    <!-- Audit Table Card -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-ink mb-0"><i class="bi bi-list-ul me-1 text-plum"></i> Recorded Audit Trail (@Model.TotalLogsCount entries)</h6>
            <span class="badge bg-light text-muted border">Real-time recording</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 font-monospace" style="font-size: 0.88rem;">
                <thead class="table-light small text-muted text-uppercase font-sans">
                    <tr>
                        <th style="width: 170px;">Timestamp</th>
                        <th style="width: 130px;">Actor / User</th>
                        <th style="width: 110px;">Role</th>
                        <th style="width: 140px;">Action</th>
                        <th style="width: 100px;">Module</th>
                        <th>Activity Details</th>
                        <th style="width: 110px;">IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Logs.Count > 0)
                    {
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td class="small text-muted font-sans">@log.TimestampFormatted</td>
                                <td>
                                    <span class="fw-bold text-plum font-sans">
                                        <i class="bi bi-person me-1"></i>@log.UserName
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(log.RoleName == "Owner" || log.RoleName == "Admin" ? "bg-plum" : "bg-secondary-subtle text-dark") font-sans">
                                        @log.RoleName
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(log.Action.Contains("Settled") ? "bg-teal text-white" : log.Action.Contains("KOT") ? "bg-saffron text-dark" : log.Action.Contains("Void") ? "bg-danger text-white" : "bg-light text-dark border") font-sans">
                                        @log.Action
                                    </span>
                                </td>
                                <td><span class="badge bg-light text-muted border font-sans">@log.Module</span></td>
                                <td class="font-sans text-ink">@log.Details</td>
                                <td class="small text-muted">@log.IpAddress</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted font-sans">
                                No audit log records found matching the filter criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
