@model RestaurantMS.Web.Models.ReservationFormViewModel
@{
    ViewData["Title"] = Localizer["Reservations_Create_Title"].Value;
}

<div class="mx-auto" style="max-width: 780px;">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <form asp-action="Create" method="post" id="reservationForm" data-app-form="true" novalidate>
            @Html.AntiForgeryToken()

            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 js-form-error-summary @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="mb-0"></div> }
            </div>

            <div class="mb-4">
                <partial name="_FormSection" model='new RestaurantMS.Web.Models.FormSectionModel { Title = Localizer["Reservations_Create_Title"].Value, HelperText = "Guest contact, booking slot, party size and table assignment", Icon = "bi-calendar-plus" }' />
                <div class="row g-3">
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="CustomerName" class="form-label fw-semibold small text-ink mb-1">Guest / Customer Name <span class="text-chili">*</span></label>
                        <input asp-for="CustomerName" class="form-control" placeholder="e.g. Rahul Deshmukh" required />
                        <span asp-validation-for="CustomerName" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="MobileNumber" class="form-label fw-semibold small text-ink mb-1">Mobile Number <span class="text-chili">*</span></label>
                        <input asp-for="MobileNumber" class="form-control" placeholder="10-digit mobile" pattern="^[6-9]\d{9}$" maxlength="10" required />
                        <span asp-validation-for="MobileNumber" class="invalid-feedback d-block small js-field-error"></span>
                    </div>
                    <div class="col-12 col-md-4 app-form-field">
                        <label asp-for="ReservationDate" class="form-label fw-semibold small text-ink mb-1">Booking Date <span class="text-chili">*</span></label>
                        <input asp-for="ReservationDate" type="date" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-12 col-md-4 app-form-field">
                        <label asp-for="ReservationTime" class="form-label fw-semibold small text-ink mb-1">Booking Time <span class="text-chili">*</span></label>
                        <input asp-for="ReservationTime" type="time" class="form-control" value="19:30" required />
                    </div>
                    <partial name="_FormField" model='new RestaurantMS.Web.Models.FormFieldModel { Name = "GuestCount", Label = "Guests", InputType = "stepper", Value = (Model.GuestCount > 0 ? Model.GuestCount : 4).ToString(), Min = "1", Max = "50", UnitSuffix = "pax", Required = true, ColClass = "col-12 col-md-4" }' />
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="TableNumber" class="form-label fw-semibold small text-ink mb-1">Assign Table <span class="text-chili">*</span></label>
                        <select asp-for="TableNumber" class="form-select" required>
                            <option value="T1">T1 (Ground AC · 4 Seater)</option>
                            <option value="T3">T3 (Ground AC · 4 Seater)</option>
                            <option value="T5">T5 (Family Garden · 6 Seater)</option>
                            <option value="T7">T7 (Family Garden · 4 Seater)</option>
                            <option value="T9">T9 (Rooftop · 8 Seater)</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 app-form-field">
                        <label asp-for="AdvanceAmount" class="form-label fw-semibold small text-ink mb-1">Advance Paid</label>
                        <div class="input-group">
                            <input asp-for="AdvanceAmount" type="number" step="50" min="0" class="form-control" placeholder="0" />
                            <span class="input-group-text bg-light text-muted fw-semibold">₹</span>
                        </div>
                    </div>
                    <div class="col-12 app-form-field">
                        <label asp-for="Notes" class="form-label fw-semibold small text-ink mb-1">Special Arrangements / Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="e.g. Birthday table setup, baby high chair"></textarea>
                    </div>
                </div>
            </div>

            <partial name="_FormFooter" model='new RestaurantMS.Web.Models.FormFooterModel { CancelUrl = Url.Action("Index", "Reservations")!, ShowSaveAndNew = true }' />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
