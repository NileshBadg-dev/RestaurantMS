@model RestaurantMS.Web.Models.FeatureTogglesViewModel
@{
    ViewData["Title"] = Localizer["FeatureToggles_Title"].Value;
    var groups = Model.Toggles.GroupBy(t => t.Group).OrderBy(g => g.Key);
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-toggle-on text-plum me-2"></i> @Localizer["FeatureToggles_Title"]</h2>
        <p class="text-muted small mb-0">@Localizer["FeatureToggles_Subtitle"]</p>
    </div>
    <div>
        <button type="submit" form="togglesForm" class="btn btn-plum px-4 py-2 fw-bold shadow-sm" permission="@Permissions.FeatureToggles.Edit">
            <i class="bi bi-floppy me-1"></i> @Localizer["Btn_Save"]
        </button>
    </div>
</div>

<form id="togglesForm" asp-action="Index" method="post">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        @foreach (var group in groups)
        {
            <div class="col-12 col-lg-6">
                <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
                    <div class="card-header bg-cream py-3 border-bottom d-flex align-items-center rounded-top">
                        <i class="bi bi-collection me-2 text-plum fs-5"></i>
                        <h5 class="h6 fw-bold mb-0 text-ink">@group.Key Module Features</h5>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @foreach (var toggle in group)
                            {
                                var isChecked = Model.ToggleStates.TryGetValue(toggle.Key, out var enabled) && enabled;
                                <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                    <div class="me-3">
                                        <div class="fw-semibold text-ink">@toggle.Name</div>
                                        <div class="text-muted small">@toggle.Description</div>
                                        <span class="badge bg-light text-secondary border font-monospace mt-1" style="font-size: 0.7rem;">@toggle.Key</span>
                                    </div>
                                    <div class="form-check form-switch fs-5">
                                        <input type="hidden" name="toggleInputs[@toggle.Key]" value="false" />
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               name="toggleInputs[@toggle.Key]" value="true"
                                               id="toggle-@toggle.Key" @(isChecked ? "checked" : "") />
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-end mt-4 mb-5">
        <button type="submit" class="btn btn-plum px-4 py-2 fw-bold shadow-sm" permission="@Permissions.FeatureToggles.Edit">
            <i class="bi bi-floppy me-1"></i> @Localizer["Btn_Save"]
        </button>
    </div>
</form>
