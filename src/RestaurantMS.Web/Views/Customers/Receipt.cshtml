@model RestaurantMS.Web.Models.CustomerReceiptViewModel
@{
    ViewData["Title"] = Localizer["Customers_Receipt_Title"].Value;
}

<div class="mx-auto" style="max-width: 720px;">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <form asp-action="Receipt" method="post" id="receiptForm" data-app-form="true" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CustomerId" />
            <input type="hidden" asp-for="CustomerName" />

            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 js-form-error-summary @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="mb-0"></div> }
            </div>

            <partial name="_FormSection" model='new RestaurantMS.Web.Models.FormSectionModel { Title = Localizer["Customers_Receipt_Title"].Value, HelperText = "Record customer udhari settlement and post receipt voucher", Icon = "bi-cash" }' />

            <div class="p-3 bg-cream rounded-3 border mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <span class="small text-muted">Customer</span>
                    <div class="fw-bold fs-5 text-ink">@Model.CustomerName</div>
                </div>
                <div class="text-end">
                    <span class="small text-muted">Outstanding Balance</span>
                    <div class="fw-bold fs-5 text-chili font-monospace">₹@Model.CurrentOutstanding.ToString("N2")</div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6 app-form-field">
                    <label asp-for="Amount" class="form-label fw-semibold small text-ink mb-1">Amount Received <span class="text-chili">*</span></label>
                    <div class="input-group">
                        <input asp-for="Amount" type="number" step="0.01" min="1" class="form-control fw-bold" required />
                        <span class="input-group-text bg-light text-muted fw-semibold">₹</span>
                    </div>
                    <span asp-validation-for="Amount" class="invalid-feedback d-block small js-field-error"></span>
                </div>
                <div class="col-12 col-md-6 app-form-field">
                    <label asp-for="PaymentMode" class="form-label fw-semibold small text-ink mb-1">Payment Mode <span class="text-chili">*</span></label>
                    <select asp-for="PaymentMode" class="form-select" required>
                        <option value="Cash">Cash</option>
                        <option value="UPI">UPI / QR Code</option>
                        <option value="Card">Debit / Credit Card</option>
                        <option value="Cheque">Cheque</option>
                        <option value="BankTransfer">Bank Transfer (NEFT/IMPS)</option>
                    </select>
                </div>
                <div class="col-12 app-form-field">
                    <label asp-for="ReferenceNumber" class="form-label fw-semibold small text-ink mb-1">Transaction / UTR / Cheque Ref #</label>
                    <input asp-for="ReferenceNumber" class="form-control font-monospace" placeholder="e.g. UPI Ref / Cheque number" />
                </div>
                <div class="col-12 app-form-field">
                    <label asp-for="Notes" class="form-label fw-semibold small text-ink mb-1">Remarks</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="e.g. Settled bills #1040 and #1042"></textarea>
                </div>
            </div>

            <partial name="_FormFooter" model='new RestaurantMS.Web.Models.FormFooterModel { CancelUrl = Url.Action("Ledger", "Customers", new { id = Model.CustomerId })!, SaveLabelKey = "Common_Save", ShowSaveAndNew = false, PrimaryButtonIcon = "bi-printer" }' />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
