@model RestaurantMS.Web.Models.CustomerReceiptViewModel
@{
    ViewData["Title"] = Localizer["Customers_Receipt_Title"].Value;
}

<div class="customer-receipt-page" style="max-width: 650px; margin: 0 auto;">
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h3 class="h4 fw-bold text-ink mb-1"><i class="bi bi-cash text-teal me-2"></i> @Localizer["Customers_Receipt_Title"]</h3>
                <div class="text-muted small">Record udhari payment received from customer</div>
            </div>
            <a asp-action="Ledger" asp-route-id="@Model.CustomerId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Ledger
            </a>
        </div>

        <form asp-action="Receipt" method="post" id="receiptForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CustomerId" />
            <input type="hidden" asp-for="CustomerName" />

            <div class="p-3 bg-cream rounded-3 border mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small text-muted">Customer Name:</span>
                        <div class="fw-bold fs-5 text-ink">@Model.CustomerName</div>
                    </div>
                    <div class="text-end">
                        <span class="small text-muted">Total Outstanding:</span>
                        <div class="fw-bold fs-5 text-chili font-monospace">₹@Model.CurrentOutstanding.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label asp-for="Amount" class="form-label fw-bold small text-ink">Amount Received (₹) *</label>
                    <money-input asp-for="Amount" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="PaymentMode" class="form-label fw-bold small text-ink">Payment Mode *</label>
                    <select asp-for="PaymentMode" class="form-select">
                        <option value="Cash">Cash</option>
                        <option value="UPI">UPI / QR Code</option>
                        <option value="Card">Debit / Credit Card</option>
                        <option value="Cheque">Cheque</option>
                        <option value="BankTransfer">Bank Transfer (NEFT/IMPS)</option>
                    </select>
                </div>

                <div class="col-12">
                    <label asp-for="ReferenceNumber" class="form-label fw-bold small text-ink">Transaction / UTR / Cheque Ref #</label>
                    <input asp-for="ReferenceNumber" class="form-control" placeholder="e.g. UPI Ref / Cheque number" />
                </div>

                <div class="col-12">
                    <label asp-for="Notes" class="form-label fw-bold small text-ink">Remarks</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="e.g. Settled bill #1040 and partial for #1042"></textarea>
                </div>
            </div>

            <div class="border-top pt-3 d-flex justify-content-end gap-2">
                <a asp-action="Ledger" asp-route-id="@Model.CustomerId" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                <button type="submit" class="btn btn-teal text-white px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-printer me-1"></i> Save &amp; Print Receipt
                </button>
            </div>
        </form>
    </div>
</div>
