@model RestaurantMS.Web.Models.CustomerAgeingViewModel
@{
    ViewData["Title"] = Localizer["Customers_Ageing_Title"].Value;
}

<div class="customer-ageing-page d-flex flex-column gap-3">
    <!-- Header with 4 Ageing Bucket KPI Cards -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-bar-chart-steps text-plum me-2"></i> @Localizer["Customers_Ageing_Title"]</h2>
                <div class="text-muted small">Outstanding Udhari categorized by overdue age brackets</div>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Customers
            </a>
        </div>

        <div class="row g-2">
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 bg-teal-subtle text-teal border border-teal-subtle">
                    <div class="small fw-semibold">0 - 30 Days (Current)</div>
                    <div class="fs-4 fw-bold font-monospace">₹@Model.TotalBucket0To30.ToString("N0")</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 bg-warning-subtle text-dark border border-warning-subtle">
                    <div class="small fw-semibold">31 - 60 Days</div>
                    <div class="fs-4 fw-bold font-monospace">₹@Model.TotalBucket31To60.ToString("N0")</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 bg-danger-subtle text-chili border border-danger-subtle">
                    <div class="small fw-semibold">61 - 90 Days</div>
                    <div class="fs-4 fw-bold font-monospace">₹@Model.TotalBucket61To90.ToString("N0")</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 bg-danger text-white">
                    <div class="small fw-semibold">90+ Days (Critical)</div>
                    <div class="fs-4 fw-bold font-monospace">₹@Model.TotalBucketOver90.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ageing Table -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 font-monospace">
                <thead class="table-light small text-muted text-uppercase font-sans">
                    <tr>
                        <th>Customer Name</th>
                        <th>Mobile</th>
                        <th class="text-end text-teal">0-30 Days</th>
                        <th class="text-end text-warning">31-60 Days</th>
                        <th class="text-end text-danger">61-90 Days</th>
                        <th class="text-end text-danger fw-bold">90+ Days</th>
                        <th class="text-end fw-bold text-ink">Total Due</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.CustomerAgeings)
                    {
                        <tr>
                            <td class="font-sans fw-bold text-ink">@a.CustomerName</td>
                            <td class="small text-muted font-sans">@a.Mobile</td>
                            <td class="text-end">@(a.Bucket0To30 > 0 ? "₹" + a.Bucket0To30.ToString("N0") : "-")</td>
                            <td class="text-end">@(a.Bucket31To60 > 0 ? "₹" + a.Bucket31To60.ToString("N0") : "-")</td>
                            <td class="text-end">@(a.Bucket61To90 > 0 ? "₹" + a.Bucket61To90.ToString("N0") : "-")</td>
                            <td class="text-end fw-bold @(a.BucketOver90 > 0 ? "text-danger" : "")">@(a.BucketOver90 > 0 ? "₹" + a.BucketOver90.ToString("N0") : "-")</td>
                            <td class="text-end fw-bold text-ink">₹@a.TotalOutstanding.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
