@model RestaurantMS.Web.Models.MastersViewModel

@{
    ViewData["Title"] = Localizer["Nav_Masters"].Value;
    Layout = "_Layout";
}

<div class="d-flex flex-column gap-3" id="mastersHubRoot" data-active-tab="@Model.ActiveTab">
    <!-- Top Header Bar with Breadcrumb and Back to Dashboard Button -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 pb-1">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item">
                        <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-teal fw-semibold">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active text-muted fw-medium" aria-current="page">
                        <i class="bi bi-stack me-1"></i>Masters
                    </li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-ink mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-stack text-plum"></i> @Localizer["Nav_Masters"]
            </h1>
        </div>

        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1 shadow-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> @Localizer["Master_BackToDashboard"]
        </a>
    </div>

    <!-- Horizontal Tabs Bar -->
    <div class="masters-tabs-bar">
        @foreach (var tab in Model.Tabs)
        {
            var isTabActive = tab.Id == Model.ActiveTab;
            <a href="@Url.Action("Index", "Masters", new { tab = tab.Id })"
               class="master-tab-btn js-master-tab-trigger @(isTabActive ? "active" : "")"
               id="tab-btn-@tab.Id"
               data-tab="@tab.Id">
                <i class="bi @tab.Icon"></i>
                <span>@Localizer[tab.TitleKey]</span>
                <span class="badge">@tab.CountBadge</span>
            </a>
        }
    </div>

    <!-- Live Dynamic AJAX Tab Content Container -->
    <div id="masterTabContentContainer" class="position-relative">
        @await Html.PartialAsync("_TabContent", Model)
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/mastersHub.js" asp-append-version="true"></script>
}
