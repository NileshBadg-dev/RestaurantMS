@model RestaurantMS.Web.Models.StaffHubViewModel
@{
    var monthLabel = new DateTime(Model.SelectedYear, Model.SelectedMonth, 1).ToString("MMMM yyyy");
}

<div class="card border-0 shadow-sm rounded-4 bg-white p-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 pb-3 border-bottom">
        <div class="d-flex align-items-center gap-2">
            <div class="d-flex align-items-center justify-content-center bg-saffron-subtle text-dark rounded-3" style="width: 36px; height: 36px;">
                <i class="bi bi-file-earmark-spreadsheet fs-5"></i>
            </div>
            <div>
                <h2 class="h5 fw-bold text-ink mb-0">@Localizer["Staff_SalaryStatement_Title"] — @monthLabel</h2>
                <div class="small text-muted">
                    @Localizer["Staff_SalaryFormula"]
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3">
            <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2">
                <input type="hidden" name="tab" value="salary" />
                <select name="month" class="form-select form-select-sm js-autosubmit" style="width: 130px;">
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.SelectedMonth ? "selected" : null)">@(new DateTime(2026, m, 1).ToString("MMMM"))</option>
                    }
                </select>
                <input type="number" name="year" value="@Model.SelectedYear" min="2024" max="2030" class="form-control form-control-sm js-autosubmit" style="width: 90px;" />

                <div class="form-check form-switch ms-2 mb-0">
                    <input class="form-check-input js-autosubmit" type="checkbox" role="switch" id="autoRecoverToggle" name="autoRecover" value="true" checked="@(Model.AutoRecoverAdvance ? "checked" : null)" />
                    <label class="form-check-label small fw-semibold text-ink" for="autoRecoverToggle">@Localizer["Staff_AutoRecoverAdvances"]</label>
                </div>
                <input type="hidden" name="autoRecover" value="false" />
            </form>

            <form method="post" asp-action="ToggleMonthLock" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="month" value="@Model.SelectedMonth" />
                <input type="hidden" name="year" value="@Model.SelectedYear" />
                <input type="hidden" name="locked" value="@((!Model.IsMonthLocked).ToString().ToLowerInvariant())" />
                <input type="hidden" name="returnTab" value="salary" />
                <button type="submit" class="btn btn-sm @(Model.IsMonthLocked ? "btn-outline-secondary" : "btn-outline-danger") rounded-pill px-3 fw-semibold" permission="Staff.LockMonth">
                    <i class="bi @(Model.IsMonthLocked ? "bi-unlock" : "bi-lock") me-1"></i>
                    @(Model.IsMonthLocked ? Localizer["Staff_UnlockMonth"] : Localizer["Staff_LockMonthAfterPayroll"])
                </button>
            </form>
        </div>
    </div>

    <div class="table-responsive mt-3">
        <table class="master-grid-table table align-middle mb-0">
            <thead>
                <tr>
                    <th>@Localizer["Staff_Col_Employee"]</th>
                    <th>@Localizer["Staff_Col_Attendance"]</th>
                    <th class="text-end">@Localizer["Staff_Col_Basic"]</th>
                    <th class="text-end text-teal">@Localizer["Staff_Col_Overtime"]</th>
                    <th class="text-end text-chili">@Localizer["Staff_Col_AbsentDed"]</th>
                    <th class="text-end text-plum">@Localizer["Staff_Col_AdvRecovery"]</th>
                    <th class="text-end">@Localizer["Staff_Col_NetPayable"]</th>
                    <th>@Localizer["Common_Status"]</th>
                    <th class="text-end">@Localizer["Common_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.SalaryRows)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-ink">@row.EmployeeName</div>
                            <div class="small text-muted">@row.EmployeeCode · @row.Designation (@row.SalaryType)</div>
                        </td>
                        <td class="small">
                            <span class="badge bg-teal-subtle text-teal">@row.PresentDays P</span>
                            <span class="badge bg-danger-subtle text-chili">@row.AbsentDays A</span>
                            @if (row.HalfDays > 0)
                            {
                                <span class="badge bg-warning-subtle text-dark">@row.HalfDays HD</span>
                            }
                            @if (row.OvertimeHours > 0)
                            {
                                <span class="badge bg-light text-dark border">@row.OvertimeHours.ToString("0.#")h OT</span>
                            }
                        </td>
                        <td class="text-end font-monospace">₹@row.BasicSalary.ToString("N2")</td>
                        <td class="text-end font-monospace text-teal">+₹@row.OvertimePay.ToString("N2")</td>
                        <td class="text-end font-monospace text-chili">-₹@row.AbsentDeduction.ToString("N2")</td>
                        <td class="text-end font-monospace text-plum">
                            -₹@row.AdvanceRecovery.ToString("N2")
                            @if (row.OutstandingAdvance > 0 && row.Status == "Draft")
                            {
                                <div class="text-muted" style="font-size: 0.7rem;">Bal: ₹@row.OutstandingAdvance.ToString("N0")</div>
                            }
                        </td>
                        <td class="text-end font-monospace fw-bold text-ink fs-6">₹@row.NetPayable.ToString("N2")</td>
                        <td>
                            <status-chip status="@row.Status" label="@row.Status"></status-chip>
                            @if (!string.IsNullOrEmpty(row.RecoveryVoucherNumber))
                            {
                                <div class="small text-muted font-monospace" style="font-size: 0.68rem;">@row.RecoveryVoucherNumber</div>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (row.Status == "Draft")
                            {
                                <form method="post" asp-action="MarkSalaryPaid" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="staffId" value="@row.StaffId" />
                                    <input type="hidden" name="month" value="@row.Month" />
                                    <input type="hidden" name="year" value="@row.Year" />
                                    <input type="hidden" name="autoRecover" value="@Model.AutoRecoverAdvance.ToString().ToLowerInvariant()" />
                                    <button type="submit" class="btn btn-sm btn-teal text-white rounded-3 px-2 py-1 me-1" permission="Staff.Salary" title="@Localizer["Staff_MarkPaid"]">
                                        <i class="bi bi-check2-circle me-1"></i>@Localizer["Staff_MarkPaid"]
                                    </button>
                                </form>
                            }
                            <a asp-action="Payslip" asp-route-staffId="@row.StaffId" asp-route-month="@row.Month" asp-route-year="@row.Year" asp-route-autoRecover="@Model.AutoRecoverAdvance" target="_blank" class="btn btn-sm btn-outline-plum rounded-3 px-2 py-1" permission="Staff.PrintPayslip" title="@Localizer["Staff_PrintPayslip"]">
                                <i class="bi bi-printer"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="5" class="text-end text-uppercase small text-muted">@Localizer["Common_Total"]</td>
                    <td class="text-end font-monospace text-plum">-₹@Model.TotalAdvanceRecovery.ToString("N2")</td>
                    <td class="text-end font-monospace text-ink fs-6">₹@Model.TotalNetPayroll.ToString("N2")</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
