@model RestaurantMS.Web.Models.StaffHubViewModel
@{
    var monthName = new DateTime(Model.SelectedYear, Model.SelectedMonth, 1).ToString("MMMM yyyy");
    var statuses = new[] { "Present", "Absent", "HalfDay", "Leave", "WeekOff" };
}

<div class="d-flex flex-column gap-4">
    <!-- Daily Attendance Sheet Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 pb-3 border-bottom">
            <div class="d-flex align-items-center gap-2">
                <div class="d-flex align-items-center justify-content-center bg-teal-subtle text-teal rounded-3" style="width: 36px; height: 36px;">
                    <i class="bi bi-calendar2-check fs-5"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-ink mb-0">@Localizer["Staff_Attendance_SheetTitle"]</h2>
                    <div class="small text-muted">
                        @Model.SelectedDate.ToString("dddd, dd MMMM yyyy")
                        @if (Model.IsMonthLocked)
                        {
                            <span class="badge bg-chili text-white ms-2"><i class="bi bi-lock-fill me-1"></i>@Localizer["Staff_MonthLocked"]</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="tab" value="attendance" />
                    <input type="hidden" name="calendarStaffId" value="@Model.SelectedCalendarStaffId" />
                    <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm js-autosubmit" />
                </form>

                <form method="post" asp-action="MarkAllPresent" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    <button type="submit" class="btn btn-teal btn-sm rounded-pill px-3 text-white fw-semibold shadow-sm" disabled="@(Model.IsMonthLocked ? "disabled" : null)" permission="Staff.Attendance">
                        <i class="bi bi-check2-all me-1"></i> @Localizer["Staff_MarkAllPresent"]
                    </button>
                </form>

                <form method="post" asp-action="ToggleMonthLock" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="month" value="@Model.SelectedMonth" />
                    <input type="hidden" name="year" value="@Model.SelectedYear" />
                    <input type="hidden" name="locked" value="@((!Model.IsMonthLocked).ToString().ToLowerInvariant())" />
                    <input type="hidden" name="returnTab" value="attendance" />
                    <button type="submit" class="btn btn-sm @(Model.IsMonthLocked ? "btn-outline-secondary" : "btn-outline-danger") rounded-pill px-3 fw-semibold" permission="Staff.LockMonth">
                        <i class="bi @(Model.IsMonthLocked ? "bi-unlock" : "bi-lock") me-1"></i>
                        @(Model.IsMonthLocked ? Localizer["Staff_UnlockMonth"] : Localizer["Staff_LockMonthAfterPayroll"])
                    </button>
                </form>
            </div>
        </div>

        <div class="table-responsive mt-3">
            <table class="master-grid-table table align-middle mb-0">
                <thead>
                    <tr>
                        <th>@Localizer["Staff_Col_Employee"]</th>
                        <th>@Localizer["Common_Status"]</th>
                        <th style="width: 120px;">@Localizer["Staff_Col_InTime"]</th>
                        <th style="width: 120px;">@Localizer["Staff_Col_OutTime"]</th>
                        <th style="width: 110px;">@Localizer["Staff_Col_OvertimeHrs"]</th>
                        <th>@Localizer["Common_Remarks"]</th>
                        <th class="text-end" style="width: 95px;">@Localizer["Common_Save"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.DailyAttendance)
                    {
                        <tr class="js-attendance-row" data-staff-id="@row.StaffId" data-date="@Model.SelectedDate.ToString("yyyy-MM-dd")">
                            <td>
                                <div class="fw-bold text-ink">@row.EmployeeName <span class="small text-muted">(@row.EmployeeCode)</span></div>
                                <div class="small text-muted">@row.Designation · @row.Shift</div>
                            </td>
                            <td>
                                <select class="form-select form-select-sm js-att-status" disabled="@(Model.IsMonthLocked ? "disabled" : null)">
                                    @foreach (var st in statuses)
                                    {
                                        <option value="@st" selected="@(row.Status == st ? "selected" : null)">@st</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm js-att-in" value="@row.InTime" disabled="@(Model.IsMonthLocked ? "disabled" : null)" />
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm js-att-out" value="@row.OutTime" disabled="@(Model.IsMonthLocked ? "disabled" : null)" />
                            </td>
                            <td>
                                <input type="number" step="0.5" min="0" max="12" class="form-control form-control-sm js-att-ot" value="@row.OvertimeHours" disabled="@(Model.IsMonthLocked ? "disabled" : null)" />
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm js-att-remarks" value="@row.Remarks" disabled="@(Model.IsMonthLocked ? "disabled" : null)" />
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-plum rounded-3 js-save-att" disabled="@(Model.IsMonthLocked ? "disabled" : null)">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Monthly Calendar View Per Employee -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 pb-3 border-bottom">
            <div>
                <h3 class="h6 fw-bold text-ink mb-0"><i class="bi bi-calendar3 text-plum me-2"></i>@Localizer["Staff_MonthlyCalendar_Title"] — @monthName</h3>
                <div class="small text-muted">P = Present · A = Absent · HD = Half-Day · L = Leave · WO = Week-Off</div>
            </div>

            <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2">
                <input type="hidden" name="tab" value="attendance" />
                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                <select name="calendarStaffId" class="form-select form-select-sm js-autosubmit" style="width: 210px;">
                    @foreach (var s in Model.StaffProfiles)
                    {
                        <option value="@s.Id" selected="@(s.Id == Model.SelectedCalendarStaffId ? "selected" : null)">@s.Name (@s.EmployeeCode)</option>
                    }
                </select>
                <select name="month" class="form-select form-select-sm js-autosubmit" style="width: 130px;">
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.SelectedMonth ? "selected" : null)">@(new DateTime(2026, m, 1).ToString("MMMM"))</option>
                    }
                </select>
                <input type="number" name="year" value="@Model.SelectedYear" min="2024" max="2030" class="form-control form-control-sm js-autosubmit" style="width: 90px;" />
            </form>
        </div>

        <div class="row row-cols-2 row-cols-sm-4 row-cols-md-7 g-2 mt-3">
            @foreach (var day in Model.MonthlyCalendar)
            {
                var badgeClass = day.Status switch
                {
                    "Present" => "bg-teal-subtle text-teal border-teal-subtle",
                    "Absent" => "bg-danger-subtle text-chili border-danger-subtle",
                    "HalfDay" => "bg-warning-subtle text-dark border-warning",
                    "Leave" => "bg-info-subtle text-dark border-info-subtle",
                    _ => "bg-light text-muted border"
                };
                <div class="col">
                    <div class="border rounded-3 p-2 h-100 d-flex flex-column justify-content-between @badgeClass">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold small">@day.DayOfMonth</span>
                            <span class="small opacity-75">@day.DayOfWeekShort</span>
                        </div>
                        <div class="text-center my-1">
                            <span class="fw-bold">@day.StatusCode</span>
                        </div>
                        <div class="text-center" style="font-size: 0.7rem;">
                            @(day.OvertimeHours > 0 ? $"+{day.OvertimeHours:0.#}h OT" : day.InTime)
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
