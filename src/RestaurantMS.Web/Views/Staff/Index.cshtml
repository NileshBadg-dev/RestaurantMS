@model RestaurantMS.Web.Models.StaffHubViewModel
@{
    ViewData["Title"] = Localizer["Staff_Title"].Value;
    Layout = "_Layout";
}

<div class="d-flex flex-column gap-3" id="staffHubRoot" data-save-attendance-url="@Url.Action("SaveAttendance", "Staff")">
    @Html.AntiForgeryToken()

    @if (TempData["SuccessMessage"] is string okMsg)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm py-2 px-3 small" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@okMsg
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm py-2 px-3 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errMsg
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Top KPI Row (Shared _KpiCard) -->
    <div class="row g-3">
        <div class="col-6 col-xl-3">
            <partial name="_KpiCard" model='new RestaurantMS.Web.Models.KpiCardModel { Title = Localizer["Staff_Kpi_Total"].Value, Value = Model.TotalStaff.ToString(), Subtitle = $"{Model.ActiveStaff} active profiles", Icon = "bi-people-fill", Theme = "plum" }' />
        </div>
        <div class="col-6 col-xl-3">
            <partial name="_KpiCard" model='new RestaurantMS.Web.Models.KpiCardModel { Title = Localizer["Staff_Kpi_PresentToday"].Value, Value = $"{Model.PresentToday} / {Model.ActiveStaff}", Subtitle = Model.SelectedDate.ToString("dd MMM yyyy"), Icon = "bi-calendar2-check", Theme = "teal" }' />
        </div>
        <div class="col-6 col-xl-3">
            <partial name="_KpiCard" model='new RestaurantMS.Web.Models.KpiCardModel { Title = Localizer["Staff_Kpi_MonthlyPayroll"].Value, Value = $"₹{Model.MonthlyPayrollEstimate:N0}", Subtitle = new DateTime(Model.SelectedYear, Model.SelectedMonth, 1).ToString("MMM yyyy"), Icon = "bi-wallet2", Theme = "saffron" }' />
        </div>
        <div class="col-6 col-xl-3">
            <partial name="_KpiCard" model='new RestaurantMS.Web.Models.KpiCardModel { Title = Localizer["Staff_Kpi_AdvRecovery"].Value, Value = $"₹{Model.TotalAdvanceRecovery:N0}", Subtitle = Model.AutoRecoverAdvance ? "Auto-recovery ON" : "Auto-recovery OFF", Icon = "bi-cash-coin", Theme = "ink" }' />
        </div>
    </div>

    <!-- Combined Staff Module Horizontal Tabs -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="masters-tabs-bar">
            <a asp-action="Index" asp-route-tab="list" class="master-tab-btn @(Model.ActiveTab == "list" ? "active" : "")">
                <i class="bi bi-person-badge"></i>
                <span>@Localizer["Nav_Staff"]</span>
                <span class="badge">@Model.TotalStaff</span>
            </a>
            <a asp-action="Index" asp-route-tab="attendance" asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="master-tab-btn @(Model.ActiveTab == "attendance" ? "active" : "")" permission="Staff.Attendance">
                <i class="bi bi-calendar2-check"></i>
                <span>@Localizer["Nav_StaffAttendance"]</span>
                <span class="badge">@Model.PresentToday/@Model.ActiveStaff</span>
            </a>
            <a asp-action="Index" asp-route-tab="salary" asp-route-month="@Model.SelectedMonth" asp-route-year="@Model.SelectedYear" class="master-tab-btn @(Model.ActiveTab == "salary" ? "active" : "")" permission="Staff.Salary">
                <i class="bi bi-file-earmark-spreadsheet"></i>
                <span>@Localizer["Nav_SalaryReport"]</span>
                <span class="badge">@(Model.IsMonthLocked ? "Locked" : "Open")</span>
            </a>
        </div>

        <a asp-controller="EmployeeAdvances" asp-action="Index" class="btn btn-outline-plum btn-sm rounded-pill px-3 fw-semibold" permission="EmployeeAdvances.View">
            <i class="bi bi-cash-coin me-1"></i> @Localizer["Nav_StaffAdvances"] <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <!-- Active Tab View -->
    @if (Model.ActiveTab == "attendance")
    {
        <partial name="_AttendanceTab" model="Model" />
    }
    else if (Model.ActiveTab == "salary")
    {
        <partial name="_SalaryTab" model="Model" />
    }
    else
    {
        <partial name="_StaffListTab" model="Model" />
    }
</div>

@section Scripts {
    <script src="~/js/modules/staffModule.js" asp-append-version="true"></script>
}
