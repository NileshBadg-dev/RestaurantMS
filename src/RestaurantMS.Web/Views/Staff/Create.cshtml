@model RestaurantMS.Web.Models.StaffFormViewModel
@{
    ViewData["Title"] = Localizer["Staff_Create_Title"].Value;
}

<div class="staff-create-page" style="max-width: 650px; margin: 0 auto;">
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h3 class="h4 fw-bold text-ink mb-1"><i class="bi bi-person-plus text-plum me-2"></i> @Localizer["Staff_Create_Title"]</h3>
                <div class="text-muted small">Register employee, assign shift timing &amp; roles</div>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Staff
            </a>
        </div>

        <form asp-action="Create" method="post" id="staffForm">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-4">
                <div class="col-12">
                    <label asp-for="FullName" class="form-label fw-bold small text-ink">Full Name *</label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. Dnyaneshwar Pawar" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Role" class="form-label fw-bold small text-ink">Role / Designation *</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Waiter">Waiter / Captain</option>
                        <option value="Cashier">Cashier</option>
                        <option value="Kitchen">Kitchen Chef / Cook</option>
                        <option value="Manager">Manager</option>
                        <option value="Accountant">Accountant</option>
                    </select>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="MobileNumber" class="form-label fw-bold small text-ink">Mobile Number *</label>
                    <mobile-input asp-for="MobileNumber" />
                    <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Shift" class="form-label fw-bold small text-ink">Assigned Shift</label>
                    <select asp-for="Shift" class="form-select">
                        <option value="Morning">Morning Shift (10 AM - 4 PM)</option>
                        <option value="Evening">Evening Shift (5 PM - 11:30 PM)</option>
                        <option value="Full Day">Full Day Shift</option>
                    </select>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="MonthlySalary" class="form-label fw-bold small text-ink">Monthly Salary (₹)</label>
                    <money-input asp-for="MonthlySalary" />
                </div>
            </div>

            <div class="border-top pt-3 d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                <button type="submit" class="btn btn-plum px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-check-circle me-1"></i> Save Staff Member
                </button>
            </div>
        </form>
    </div>
</div>
