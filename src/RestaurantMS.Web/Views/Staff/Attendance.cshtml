@model RestaurantMS.Web.Models.StaffAttendanceViewModel
@{
    ViewData["Title"] = Localizer["Staff_Attendance_Title"].Value;
}

<div class="attendance-page d-flex flex-column gap-3">
    <!-- Header with KPI Badges -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-calendar2-check text-plum me-2"></i> @Localizer["Staff_Attendance_Title"]</h2>
                <div class="d-flex align-items-center gap-3 text-muted small">
                    <span><strong class="text-ink">@Model.TotalStaff</strong> Total Staff</span>
                    <span>&bull;</span>
                    <span class="text-teal"><strong class="badge bg-teal-subtle text-teal">@Model.TotalPresent Present</strong></span>
                    <span class="text-warning"><strong class="badge bg-warning-subtle text-warning">@Model.TotalHalfDay Half Day</strong></span>
                    <span class="text-chili"><strong class="badge bg-danger-subtle text-chili">@Model.TotalAbsent Absent</strong></span>
                    <span class="text-muted"><strong class="badge bg-secondary-subtle text-muted">@Model.TotalOnLeave Leave</strong></span>
                </div>
            </div>

            <!-- Date Selector & Actions -->
            <form method="get" class="d-flex align-items-center gap-2">
                <input type="date" name="date" class="form-control form-control-sm text-ink" value="@Model.AttendanceDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2">
                    <i class="bi bi-people me-1"></i> Staff Directory
                </a>
                <button type="button" class="btn btn-plum px-3 py-2 fw-semibold shadow-sm" onclick="Swal.fire('Saved!', 'Daily attendance submitted successfully', 'success')">
                    <i class="bi bi-check2-circle me-1"></i> Save Attendance
                </button>
            </form>
        </div>
    </div>

    <!-- Attendance Grid -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted text-uppercase">
                    <tr>
                        <th class="text-center">Code</th>
                        <th class="text-start">Staff Name</th>
                        <th class="text-center">Role</th>
                        <th class="text-center">Shift</th>
                        <th class="text-center" style="min-width: 220px;">Attendance Status</th>
                        <th class="text-center">In Time</th>
                        <th class="text-center">Out Time</th>
                        <th class="text-center">Hrs</th>
                        <th class="text-start">Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.AttendanceList)
                    {
                        <tr>
                            <td class="text-center font-monospace text-muted">@row.EmployeeCode</td>
                            <td class="text-start fw-bold text-ink">
                                <a asp-action="Details" asp-route-id="@row.StaffId" class="text-decoration-none text-ink hover-underline">
                                    @row.FullName
                                </a>
                            </td>
                            <td class="text-center"><span class="badge bg-plum-subtle text-plum">@row.Role</span></td>
                            <td class="text-center text-muted small">@row.Shift</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn @(row.Status == "Present" ? "btn-teal text-white fw-bold" : "btn-outline-secondary")" onclick="setStatus(this, 'Present')">P</button>
                                    <button type="button" class="btn @(row.Status == "HalfDay" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary")" onclick="setStatus(this, 'HalfDay')">HD</button>
                                    <button type="button" class="btn @(row.Status == "Absent" ? "btn-danger text-white fw-bold" : "btn-outline-secondary")" onclick="setStatus(this, 'Absent')">A</button>
                                    <button type="button" class="btn @(row.Status == "Leave" ? "btn-secondary text-white fw-bold" : "btn-outline-secondary")" onclick="setStatus(this, 'Leave')">L</button>
                                </div>
                            </td>
                            <td class="text-center font-monospace small">@row.InTime</td>
                            <td class="text-center font-monospace small">@row.OutTime</td>
                            <td class="text-center fw-semibold">@row.HoursWorked</td>
                            <td class="text-start text-muted small">@(row.Remarks ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function setStatus(btn, status) {
        const group = btn.closest('.btn-group');
        group.querySelectorAll('.btn').forEach(b => {
            b.className = 'btn btn-outline-secondary';
        });
        if (status === 'Present') {
            btn.className = 'btn btn-teal text-white fw-bold';
        } else if (status === 'HalfDay') {
            btn.className = 'btn btn-warning text-dark fw-bold';
        } else if (status === 'Absent') {
            btn.className = 'btn btn-danger text-white fw-bold';
        } else {
            btn.className = 'btn btn-secondary text-white fw-bold';
        }
    }
</script>
