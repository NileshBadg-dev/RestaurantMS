@model RestaurantMS.Web.Models.StaffAdvanceViewModel
@{
    ViewData["Title"] = Localizer["Staff_Advances_Title"].Value;
}

<div class="advances-page d-flex flex-column gap-3">
    <!-- Header with KPI Badges -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-cash-coin text-plum me-2"></i> @Localizer["Staff_Advances_Title"]</h2>
                <div class="d-flex align-items-center gap-3 text-muted small">
                    <span><strong class="text-ink">@Model.ActiveAdvanceAccountsCount</strong> Staff with Active Balances</span>
                    <span>&bull;</span>
                    <span>Total Disbursed: <strong class="text-ink">₹@Model.TotalAdvancesGiven.ToString("N0")</strong></span>
                    <span>&bull;</span>
                    <span class="text-teal">Recovered via Salary: <strong>₹@Model.TotalRecovered.ToString("N0")</strong></span>
                    <span>&bull;</span>
                    <span class="text-chili"><strong class="badge bg-danger-subtle text-chili">₹@Model.TotalOutstandingAdvance.ToString("N0") Outstanding</strong></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="SalaryReport" class="btn btn-outline-plum px-3 py-2 fw-semibold">
                    <i class="bi bi-file-earmark-spreadsheet me-1"></i> Salary Deductions
                </a>
                <button type="button" class="btn btn-plum px-3 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#recordAdvanceModal">
                    <i class="bi bi-plus-circle me-1"></i> Record Advance
                </button>
            </div>
        </div>
    </div>

    <!-- Advances Ledger Table Grid -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted text-uppercase">
                    <tr>
                        <th class="text-center">Voucher #</th>
                        <th class="text-center">Date</th>
                        <th class="text-start">Staff Member</th>
                        <th class="text-center">Role</th>
                        <th class="text-end">Advance Given</th>
                        <th class="text-end">Recovered</th>
                        <th class="text-end">Balance Due</th>
                        <th class="text-center">Mode</th>
                        <th class="text-start">Reason / Notes</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Advances)
                    {
                        <tr>
                            <td class="text-center font-monospace text-muted">@row.VoucherNumber</td>
                            <td class="text-center small text-muted">@row.DateFormatted</td>
                            <td class="text-start fw-bold text-ink">@row.EmployeeName</td>
                            <td class="text-center"><span class="badge bg-plum-subtle text-plum">@row.Role</span></td>
                            <td class="text-end fw-semibold font-monospace">₹@row.AdvanceAmount.ToString("N2")</td>
                            <td class="text-end text-teal fw-semibold font-monospace">₹@row.RecoveredAmount.ToString("N2")</td>
                            <td class="text-end fw-bold font-monospace @(row.BalanceAmount > 0 ? "text-chili" : "text-muted")">
                                ₹@row.BalanceAmount.ToString("N2")
                            </td>
                            <td class="text-center"><span class="badge bg-light text-dark border">@row.PaymentMode</span></td>
                            <td class="text-start text-muted small">@row.Reason</td>
                            <td class="text-center">
                                @if (row.Status == "Settled")
                                {
                                    <span class="badge bg-teal-subtle text-teal">Settled</span>
                                }
                                else if (row.Status == "PartiallyDeducted")
                                {
                                    <span class="badge bg-warning-subtle text-warning">Partial</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-chili">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Record Advance -->
<div class="modal fade" id="recordAdvanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header bg-plum text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-cash-coin me-2"></i> Record Staff Advance</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RecordAdvance" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 d-flex flex-column gap-3">
                    <div>
                        <label class="form-label fw-semibold text-ink small">Staff Member</label>
                        <select name="employeeName" class="form-select" required>
                            <option value="">-- Select Employee --</option>
                            <option value="Suresh Patil">Suresh Patil (Head Waiter)</option>
                            <option value="Anil Deshmukh">Anil Deshmukh (Waiter)</option>
                            <option value="Meena Jadhav">Meena Jadhav (Captain)</option>
                            <option value="Chef Rakesh">Chef Rakesh (Head Chef)</option>
                            <option value="Prakash Shinde">Prakash Shinde (Cashier)</option>
                            <option value="Kavita Pawar">Kavita Pawar (Kitchen Assistant)</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label fw-semibold text-ink small">Advance Amount (₹)</label>
                        <input type="number" step="100" min="500" max="50000" name="amount" class="form-control font-monospace fw-bold" placeholder="5000" required />
                    </div>

                    <div>
                        <label class="form-label fw-semibold text-ink small">Payment Mode</label>
                        <select name="paymentMode" class="form-select">
                            <option value="Cash">Cash (from Till)</option>
                            <option value="UPI">UPI / GPay</option>
                            <option value="Bank Transfer">Bank Transfer / NEFT</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label fw-semibold text-ink small">Reason / Purpose</label>
                        <textarea name="reason" rows="2" class="form-control" placeholder="Medical emergency, festival advance, family travel..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-plum fw-semibold px-4">Disburse & Record</button>
                </div>
            </form>
        </div>
    </div>
</div>
