@model RestaurantMS.Web.Models.OrdersViewModel
@{
    ViewData["Title"] = Localizer["Orders_Title"].Value;
}

<div class="orders-page d-flex flex-column gap-3">
    <!-- Header -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h4 fw-bold text-ink mb-1"><i class="bi bi-receipt-cutoff text-plum me-2"></i> @Localizer["Orders_Title"]</h2>
                <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                    <span class="text-plum"><strong class="badge bg-plum-subtle text-plum">@Model.ActiveDineInOrders Dine-in Running</strong></span>
                    <span class="text-saffron"><strong class="badge bg-warning-subtle text-dark">@Model.ActiveParcelOrders Parcel Orders</strong></span>
                    <span>&bull;</span>
                    <span class="fw-bold text-teal font-monospace">Running Total: ₹@Model.TotalRunningRevenue.ToString("N0")</span>
                </div>
            </div>

            <a asp-action="New" class="btn btn-plum px-3 py-2 fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Take New Order <span class="badge bg-saffron text-dark ms-1">F2</span>
            </a>
        </div>
    </div>

    <!-- Open Orders Table -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 font-monospace">
                <thead class="table-light small text-muted text-uppercase font-sans">
                    <tr>
                        <th class="text-start">Order #</th>
                        <th class="text-start">Table / Mode</th>
                        <th class="text-start">Waiter</th>
                        <th class="text-center">Ordered At</th>
                        <th class="text-center">Items Count</th>
                        <th class="text-end">Running Total</th>
                        <th class="text-center font-sans">Status</th>
                        <th class="text-end font-sans">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.OpenOrders)
                    {
                        <tr>
                            <td class="text-start fw-bold text-plum">@order.OrderNumber</td>
                            <td class="text-start font-sans fw-semibold text-ink">@order.TableOrType</td>
                            <td class="text-start font-sans text-muted">@order.WaiterName</td>
                            <td class="text-center small text-muted font-sans">@order.OrderedAt</td>
                            <td class="text-center"><span class="badge bg-light text-dark border">@order.ItemsCount items</span></td>
                            <td class="text-end fw-bold text-ink fs-6">₹@order.RunningAmount.ToString("N2")</td>
                            <td class="text-center font-sans">
                                <status-chip status="@order.Status" />
                            </td>
                            <td class="text-end font-sans">
                                <a asp-action="New" asp-route-table="@order.TableOrType" class="btn btn-sm btn-outline-plum me-1">
                                    <i class="bi bi-plus-circle"></i> Add
                                </a>
                                <a asp-controller="Billing" asp-action="Index" asp-route-table="@order.TableOrType" class="btn btn-sm btn-teal text-white">
                                    <i class="bi bi-receipt"></i> Bill
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
