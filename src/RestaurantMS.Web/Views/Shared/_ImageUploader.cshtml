@model RestaurantMS.Web.Models.ImageUploaderModel

<div class="image-uploader-card card p-3 border rounded-3 bg-white js-image-uploader"
     data-prefix="@Model.Name"
     data-max-images="@Model.MaxImages"
     data-max-size="@Model.MaxSizeMb">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <label class="form-label fw-bold small text-ink mb-0">@Model.Label</label>
        <span class="badge bg-light text-muted border">Max @Model.MaxImages images (@Model.MaxSizeMb MB each)</span>
    </div>

    <input type="hidden" name="MainImageIndex" class="js-main-image-index" value="0" />

    <div class="upload-dropzone border border-dashed rounded-3 p-4 text-center mb-3 bg-cream position-relative js-dropzone">
        <input type="file"
               name="@Model.Name"
               id="@(Model.Name)_input"
               multiple
               accept=".jpg,.jpeg,.png,.webp"
               class="position-absolute top-0 start-0 w-100 h-100 opacity-0 js-image-file-input"
               style="cursor: pointer;" />
        <i class="bi bi-cloud-arrow-up text-plum fs-2 d-block mb-1"></i>
        <div class="fw-semibold text-ink small">Drag &amp; drop images here, or click to browse</div>
        <div class="small text-muted">@Model.HelpText</div>
    </div>

    <div class="row g-2 image-preview-container js-image-previews" id="@(Model.Name)_previews">
        @for (var i = 0; i < Model.ExistingImageUrls.Count; i++)
        {
            var url = Model.ExistingImageUrls[i];
            var isMain = i == 0;
            <div class="col-4 position-relative preview-item js-preview-item @(isMain ? "is-main" : "")" data-index="@i">
                <img src="@url" class="img-thumbnail rounded-3 w-100 js-preview-img" style="height: 100px; object-fit: cover;" alt="Dish image preview" />
                <button type="button" class="btn btn-sm @(isMain ? "btn-saffron text-dark" : "btn-light border") position-absolute bottom-0 start-0 m-2 py-0 px-2 rounded-pill small fw-semibold js-set-main-btn" style="font-size: 0.7rem;">
                    <i class="bi @(isMain ? "bi-star-fill" : "bi-star") me-1"></i>@(isMain ? "Main" : "Set Main")
                </button>
                <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 rounded-circle p-1 js-remove-img-btn" style="line-height: 1; width: 24px; height: 24px;" aria-label="Remove image">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }
    </div>
</div>
