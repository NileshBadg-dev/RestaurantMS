@model RestaurantMS.Web.Models.CustomerPickerModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<RestaurantMS.Web.SharedResource> Localizer

<div class="customer-picker-container border rounded p-3 bg-white" data-customer-picker="true">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <label class="form-label mb-0 fw-semibold small text-ink">
            <i class="bi bi-person-badge me-1 text-plum"></i> @Localizer["Customer Details"]
        </label>
        <button type="button" class="btn btn-sm btn-outline-plum py-0 px-2" data-bs-toggle="modal" data-bs-target="#quickAddCustomerModal">
            <i class="bi bi-person-plus"></i> @Localizer["Quick Add"]
        </button>
    </div>

    <div class="position-relative mb-2">
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text"
                   id="customerSearchInput"
                   class="form-control"
                   placeholder="@Localizer["Search by name or 10-digit mobile..."]"
                   value="@(Model.CustomerId.HasValue ? Model.CustomerName : "")"
                   autocomplete="off" />
            <input type="hidden" name="@Model.FieldName" id="selectedCustomerId" value="@Model.CustomerId" />
        </div>
        <div id="customerSearchResults" class="customer-search-results d-none"></div>
    </div>

    <div id="customerSummaryBlock" class="p-2 rounded bg-cream border @(Model.CustomerId.HasValue ? "" : "d-none")">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <strong id="pickedCustomerName" class="text-ink">@(Model.CustomerName ?? "")</strong>
                <span class="text-muted small ms-2 font-monospace" id="pickedCustomerMobile">@(Model.CustomerMobile ?? "")</span>
                <span class="badge bg-chili text-white ms-2 @(Model.IsCreditAllowed ? "d-none" : "")" id="pickedCustomerCreditBlocked">
                    @Localizer["Billing_CreditDisabledBadge"]
                </span>
            </div>
            <button type="button" class="btn btn-sm text-danger p-0" id="btnClearCustomer" title="@Localizer["Btn_Clear"]">
                <i class="bi bi-x-circle-fill"></i>
            </button>
        </div>
        <div class="small text-muted mt-1" id="pickedCustomerAddress"></div>
        <div class="d-flex flex-wrap gap-3 mt-1 small">
            <span class="text-chili">
                @Localizer["Outstanding"]: <strong id="pickedCustomerOutstanding" class="font-monospace">₹@((Model.OutstandingAmount ?? 0m).ToString("N2"))</strong>
            </span>
            <span class="text-muted">
                @Localizer["Limit"]: <strong id="pickedCustomerLimit" class="font-monospace">₹@((Model.CreditLimit ?? 0m).ToString("N2"))</strong>
            </span>
            <span class="text-teal">
                @Localizer["Billing_AvailableCredit"]: <strong id="pickedCustomerAvailable" class="font-monospace">₹@(Math.Max(0m, (Model.CreditLimit ?? 0m) - (Model.OutstandingAmount ?? 0m)).ToString("N2"))</strong>
            </span>
        </div>
    </div>
</div>

<!-- Quick Add Customer Modal -->
<div class="modal fade" id="quickAddCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-plum text-white py-2">
                <h6 class="modal-title fw-bold mb-0"><i class="bi bi-person-plus me-1"></i> @Localizer["Quick Add Customer"]</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger py-2 small d-none" id="quickCustomerError"></div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">@Localizer["Full Name"] *</label>
                    <input type="text" class="form-control" id="quickCustomerName" placeholder="e.g. Ramesh Patil" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">@Localizer["Mobile Number"] *</label>
                    <input type="tel" class="form-control font-monospace" id="quickCustomerMobile" placeholder="10 digits starting 6-9" maxlength="10" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">@Localizer["Address"]</label>
                    <input type="text" class="form-control" id="quickCustomerAddress" placeholder="e.g. 14 Shivaji Nagar, Pune" />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">@Localizer["Credit Limit (₹)"]</label>
                    <input type="number" class="form-control font-monospace" id="quickCustomerLimit" value="5000" min="0" step="100" />
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-sm btn-teal" id="btnSaveQuickCustomer">
                    <i class="bi bi-check-lg"></i> @Localizer["Save Customer"]
                </button>
            </div>
        </div>
    </div>
</div>
