@model RestaurantMS.Web.Models.BillingPanelModel

<div class="billing-panel-container row g-3">
    <!-- Left Column: Items Grid -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 bg-white h-100 d-flex flex-column">
            <!-- Order Type & Table Selector Header -->
            <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2 bg-cream rounded-top">
                <div class="order-type-tabs btn-group" role="group">
                    <input type="radio" class="btn-check" name="orderTypeRadio" id="typeDineIn" value="Dine-in" checked onchange="changeOrderType('Dine-in')" />
                    <label class="btn btn-outline-plum px-3 py-2 fw-semibold" for="typeDineIn">
                        <i class="bi bi-shop me-1"></i> Dine-in
                    </label>

                    <input type="radio" class="btn-check" name="orderTypeRadio" id="typeParcel" value="Parcel" onchange="changeOrderType('Parcel')" />
                    <label class="btn btn-outline-plum px-3 py-2 fw-semibold" for="typeParcel">
                        <i class="bi bi-bag me-1"></i> Parcel
                    </label>

                    <input type="radio" class="btn-check" name="orderTypeRadio" id="typeDelivery" value="Delivery" onchange="changeOrderType('Delivery')" />
                    <label class="btn btn-outline-plum px-3 py-2 fw-semibold" for="typeDelivery">
                        <i class="bi bi-bicycle me-1"></i> Delivery
                    </label>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm" id="tableSelectWrapper" style="width: 140px;">
                        <span class="input-group-text bg-plum text-white fw-bold">Table</span>
                        <select class="form-select fw-bold text-plum" id="billingTableSelect" onchange="switchBillingTable(this.value)">
                            @for (int t = 1; t <= 12; t++)
                            {
                                var tCode = $"T{t}";
                                <!option value="@tCode" @(Model.Order.TableCode == tCode ? "selected" : "")>@tCode</!option>
                            }
                        </select>
                    </div>
                    <div class="small text-muted text-nowrap d-none d-sm-block">Waiter: Sachin</div>
                </div>
            </div>

            <!-- Items Table -->
            <div class="table-responsive flex-grow-1 p-3" style="min-height: 260px;">
                <table class="table table-hover align-middle billing-items-table" id="billingItemsTable">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th style="width: 40px;">#</th>
                            <th>Item Name</th>
                            <th class="text-center" style="width: 140px;">Qty</th>
                            <th class="text-end" style="width: 100px;">Rate</th>
                            <th class="text-end" style="width: 110px;">Total</th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="billingItemsBody">
                        @if (Model.Order.Items != null && Model.Order.Items.Count > 0)
                        {
                            for (int i = 0; i < Model.Order.Items.Count; i++)
                            {
                                var item = Model.Order.Items[i];
                                <tr data-rate="@item.Rate" data-name="@item.ItemName">
                                    <td class="text-muted small row-num">@(i + 1)</td>
                                    <td>
                                        <div class="fw-semibold text-ink">@item.ItemName</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <small class="text-muted"><i class="bi bi-chat-left-text me-1"></i>@item.Notes</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm quantity-input-group justify-content-center">
                                            <button class="btn btn-outline-secondary btn-qty-minus py-0 px-2" type="button" onclick="updateItemQty(this, -1)">-</button>
                                            <input type="number" class="form-control text-center input-qty py-0 px-1" style="max-width: 48px;" value="@item.Quantity" min="1" max="99" onchange="recalcBillingRow(this)" />
                                            <button class="btn btn-outline-secondary btn-qty-plus py-0 px-2" type="button" onclick="updateItemQty(this, 1)">+</button>
                                        </div>
                                    </td>
                                    <td class="text-end font-monospace">₹@item.Rate.ToString("N2")</td>
                                    <td class="text-end fw-bold font-monospace text-ink item-total">₹@item.Amount.ToString("N2")</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-link text-chili p-0" onclick="removeBillingRow(this)" title="Remove item">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <div id="emptyBillingItemsMsg" class="text-center py-5 @(Model.Order.Items != null && Model.Order.Items.Count > 0 ? "d-none" : "")">
                    <i class="bi bi-cart3 fs-1 text-muted opacity-50"></i>
                    <p class="text-muted small mt-2 mb-0">No dishes on this ticket yet.<br />Use short code (101-113) or click Browse to add dishes.</p>
                </div>
            </div>

            <!-- Quick Add Item Bar -->
            <div class="p-3 border-top bg-light d-flex gap-2">
                <input type="text" id="quickItemInput" class="form-control" placeholder="Type short code (101=Paneer, 102=Biryani) or dish name + Enter..." onkeydown="handleQuickItemKeyDown(event)" />
                <button type="button" class="btn btn-plum" data-bs-toggle="modal" data-bs-target="#browseDishesModal">
                    <i class="bi bi-search me-1"></i> Browse Dishes
                </button>
            </div>
        </div>
    </div>

    <!-- Right Column: Customer & Settlement -->
    <div class="col-lg-5">
        <form method="post" action="@Model.SettleActionUrl" id="settlementForm">
            @Html.AntiForgeryToken()

            <!-- Hidden Inputs to deliver complete form data -->
            <input type="hidden" name="orderType" id="hiddenOrderType" value="Dine-in" />
            <input type="hidden" name="tableCode" id="hiddenTableCode" value="@(Model.Order.TableCode ?? "T1")" />
            <input type="hidden" name="customerName" id="hiddenCustomerName" value="Walk-in Customer" />
            <input type="hidden" name="customerPhone" id="hiddenCustomerPhone" value="" />
            <input type="hidden" name="customerAddress" id="hiddenCustomerAddress" value="" />
            <input type="hidden" name="grandTotal" id="hiddenGrandTotal" value="@Model.Order.TotalAmount" />

            <!-- Customer Picker & Search Box -->
            <div class="card border-0 shadow-sm rounded-3 bg-white mb-3 p-3 position-relative" id="billingCustomerCard">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-bold text-ink mb-0">
                        <i class="bi bi-person-circle me-1 text-plum"></i> Customer <span class="badge bg-danger-subtle text-chili ms-1" id="udhariMandatoryBadge" style="display: none;">Mandatory for Udhari</span>
                    </label>
                    <button type="button" class="btn btn-link btn-sm text-plum p-0 text-decoration-none fw-bold" data-bs-toggle="modal" data-bs-target="#quickAddCustomerModal">
                        <i class="bi bi-person-plus-fill me-1 text-saffron"></i>+ Quick Add Customer
                    </button>
                </div>

                <!-- Live Search Customer Input -->
                <div class="input-group input-group-sm mb-2">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="billingCustomerSearch" class="form-control border-start-0 bg-light" placeholder="Search customer by name or 10-digit mobile..." oninput="searchBillingCustomer(this.value)" autocomplete="off" />
                    <button class="btn btn-outline-secondary" type="button" onclick="clearCustomerSearch()" title="Clear customer"><i class="bi bi-x-lg"></i></button>
                </div>

                <!-- Customer Search Results Dropdown -->
                <div id="billingCustomerResults" class="list-group shadow position-absolute start-0 end-0 mx-3 z-3 bg-white border rounded-3" style="display: none; max-height: 220px; overflow-y: auto; top: 80px;">
                    <!-- Injected by JS -->
                </div>

                <!-- Selected Customer Card Details -->
                <div class="customer-selected-card border rounded-3 p-2 bg-cream d-flex justify-content-between align-items-center" id="selectedCustomerDisplay">
                    <div class="overflow-hidden pe-2">
                        <div class="fw-bold text-ink text-truncate" id="selectedCustomerName">Walk-in Customer</div>
                        <div class="small text-muted font-monospace" id="selectedCustomerPhone">No mobile linked</div>
                        <div class="small text-muted text-truncate" id="selectedCustomerAddress" style="max-width: 260px; font-size: 0.75rem;">No address linked</div>
                    </div>
                    <div class="text-end flex-shrink-0">
                        <span class="badge bg-saffron text-dark" id="customerCreditBadge">Outstanding: ₹0</span>
                        <div class="small text-muted" id="customerLimitDisplay">Limit: ₹10,000</div>
                    </div>
                </div>
            </div>

            <!-- Bill Summary & Tax Calculation Box -->
            <div class="card border-0 shadow-sm rounded-3 bg-white mb-3 p-3">
                <div class="bill-summary-rows">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-semibold font-monospace" id="summarySubtotal">₹@Model.Order.Subtotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">CGST (2.5%)</span>
                        <span class="font-monospace" id="summaryCgst">₹@((Model.Order.GstAmount / 2).ToString("N2"))</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">SGST (2.5%)</span>
                        <span class="font-monospace" id="summarySgst">₹@((Model.Order.GstAmount / 2).ToString("N2"))</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom align-items-center">
                        <span class="text-muted">Discount (₹)</span>
                        <div class="d-flex align-items-center gap-1">
                            <input type="number" name="discountAmount" id="discountInput" class="form-control form-control-sm text-end" style="width: 90px;" value="0" min="0" oninput="recalculateTotals()" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Round Off</span>
                        <span class="font-monospace text-muted" id="summaryRoundOff">₹0.00</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2 fs-5 fw-bold text-ink">
                        <span>Grand Total</span>
                        <span class="font-monospace text-plum" id="summaryGrandTotal">₹@Model.Order.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- Payment Modes -->
            <div class="card border-0 shadow-sm rounded-3 bg-white mb-3 p-3">
                <label class="form-label fw-bold text-ink mb-2"><i class="bi bi-wallet2 me-1 text-teal"></i> Payment Mode</label>
                <div class="payment-chips-grid d-flex flex-wrap gap-2 mb-3">
                    <input type="radio" class="btn-check" name="paymentMode" id="payCash" value="Cash" checked onchange="togglePaymentInputs()" />
                    <label class="btn btn-outline-teal flex-fill py-2 fw-semibold" for="payCash">
                        <i class="bi bi-cash-stack me-1"></i> Cash
                    </label>

                    <input type="radio" class="btn-check" name="paymentMode" id="payUpi" value="UPI" onchange="togglePaymentInputs()" />
                    <label class="btn btn-outline-teal flex-fill py-2 fw-semibold" for="payUpi">
                        <i class="bi bi-qr-code-scan me-1"></i> UPI
                    </label>

                    <input type="radio" class="btn-check" name="paymentMode" id="payCard" value="Card" onchange="togglePaymentInputs()" />
                    <label class="btn btn-outline-teal flex-fill py-2 fw-semibold" for="payCard">
                        <i class="bi bi-credit-card me-1"></i> Card
                    </label>

                    <input type="radio" class="btn-check" name="paymentMode" id="paySplit" value="Split" onchange="togglePaymentInputs()" />
                    <label class="btn btn-outline-teal flex-fill py-2 fw-semibold" for="paySplit">
                        <i class="bi bi-pie-chart me-1"></i> Split
                    </label>

                    @if (Model.EnableCreditPayment)
                    {
                        <input type="radio" class="btn-check" name="paymentMode" id="payUdhari" value="Credit" onchange="togglePaymentInputs()" />
                        <label class="btn btn-outline-chili flex-fill py-2 fw-semibold" for="payUdhari">
                            <i class="bi bi-journal-bookmark me-1"></i> Udhari (Credit)
                        </label>
                    }
                </div>

                <!-- Udhari / Split Details Section -->
                <div id="creditDetailsSection" class="border rounded-3 p-3 bg-light" style="display: none;">
                    <div class="alert alert-warning p-2 small mb-2">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Credit bill will be posted to customer ledger. Customer must have full name, 10-digit mobile, and address.
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Paid Now (Cash/UPI)</label>
                            <input type="number" name="paidAmount" id="paidAmountInput" class="form-control form-control-sm" value="0" min="0" oninput="recalculateCreditSplit()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Udhari Amount</label>
                            <input type="number" name="creditAmount" id="creditAmountInput" class="form-control form-control-sm fw-bold text-chili" value="@Model.Order.TotalAmount" readonly />
                        </div>
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Due Date / Reference Note</label>
                        <input type="text" name="creditNote" class="form-control form-control-sm" placeholder="e.g. Next month 5th or Bill memo" />
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary px-3 py-2 fw-semibold" onclick="handleHoldBill()">
                    <i class="bi bi-pause-circle me-1"></i> Hold
                </button>
                <button type="button" class="btn btn-outline-plum px-3 py-2 fw-semibold" onclick="openThermalBillPreview()" title="Preview bill in 80 mm / 50 mm thermal roll">
                    <i class="bi bi-printer me-1 text-saffron"></i> Preview (80/50mm)
                </button>
                <button type="button" class="btn btn-teal text-white flex-grow-1 py-3 fw-bold fs-5 shadow-sm" onclick="settleBillWithReceipt()">
                    <i class="bi bi-check-circle me-2"></i> Settle &amp; Print <span class="badge bg-white text-teal ms-2 fs-6">F10</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Browse Dishes Modal -->
<div class="modal fade" id="browseDishesModal" tabindex="-1" aria-labelledby="browseDishesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-plum text-white py-2 px-3">
                <h5 class="modal-title h6 mb-0 fw-bold" id="browseDishesModalLabel"><i class="bi bi-egg-fried me-2 text-saffron"></i>Browse Menu Dishes</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="row g-2" id="browseDishesGrid">
                    <!-- Dishes loaded dynamically via JS -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Inline Quick Add Customer Modal with Mandatory Address -->
<div class="modal fade" id="quickAddCustomerModal" tabindex="-1" aria-labelledby="quickAddCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-plum text-white py-2 px-3">
                <h5 class="modal-title h6 mb-0 fw-bold" id="quickAddCustomerModalLabel"><i class="bi bi-person-plus-fill me-2 text-saffron"></i>Quick Add Customer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="mb-2">
                    <label class="form-label small fw-bold text-ink mb-1">Customer Full Name <span class="text-danger">*</span></label>
                    <input type="text" id="quickCustName" class="form-control" placeholder="e.g. Ramesh Patil" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-bold text-ink mb-1">Mobile Number (10 digits) <span class="text-danger">*</span></label>
                    <input type="tel" id="quickCustPhone" class="form-control font-monospace" placeholder="e.g. 9822112233" maxlength="10" required />
                    <small class="text-muted" style="font-size: 0.72rem;">Required for sending WhatsApp receipts &amp; Udhari</small>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-bold text-ink mb-1">Physical Address <span class="text-danger">*</span></label>
                    <textarea id="quickCustAddress" class="form-control" rows="2" placeholder="e.g. 14 Shivaji Nagar, Pune - 411005" required></textarea>
                    <small class="text-muted" style="font-size: 0.72rem;">Mandatory legal address for credit/udhari accounts</small>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-bold text-ink mb-1">Udhari Credit Limit (₹)</label>
                    <input type="number" id="quickCustLimit" class="form-control font-monospace" value="10000" min="0" step="500" />
                </div>
            </div>
            <div class="modal-footer py-2 px-3 bg-light">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-plum btn-sm fw-bold px-3" onclick="saveAndSelectQuickCustomer()">
                    <i class="bi bi-check-lg me-1"></i> Save &amp; Select
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Thermal Print Preview & WhatsApp Modal -->
<partial name="_ThermalBillModal" />

<script>
// Menu Catalog with Short Codes
const menuCatalog = [
    { code: "101", name: "Paneer Butter Masala", price: 280, cat: "Main Course" },
    { code: "102", name: "Chicken Biryani", price: 320, cat: "Biryani" },
    { code: "103", name: "Veg Biryani", price: 220, cat: "Biryani" },
    { code: "104", name: "Egg Biryani", price: 240, cat: "Biryani" },
    { code: "105", name: "Butter Naan", price: 45, cat: "Breads" },
    { code: "106", name: "Tandoori Roti", price: 25, cat: "Breads" },
    { code: "107", name: "Masala Dosa", price: 90, cat: "South Indian" },
    { code: "108", name: "Idli Sambar", price: 60, cat: "South Indian" },
    { code: "109", name: "Sweet Lassi", price: 80, cat: "Beverages" },
    { code: "110", name: "Dal Tadka", price: 180, cat: "Main Course" },
    { code: "111", name: "Jeera Rice", price: 140, cat: "Rice" },
    { code: "112", name: "Egg Curry", price: 210, cat: "Main Course" },
    { code: "113", name: "Chicken Tikka", price: 290, cat: "Starters" }
];

// Customer Directory for Search & Autocomplete
let localCustomers = [
    { id: 1, name: "Ramesh Patil", phone: "9876543210", address: "14 Shivaji Nagar, Pune - 411005", outstanding: 0, limit: 10000 },
    { id: 2, name: "Sunita Shinde", phone: "9765432109", address: "25 Kothrud, Pune - 411038", outstanding: 0, limit: 5000 },
    { id: 3, name: "Amit Deshmukh", phone: "9823456789", address: "8 FC Road, Deccan, Pune - 411004", outstanding: 0, limit: 8000 },
    { id: 4, name: "Vijay Shrestha", phone: "9922334455", address: "102 Viman Nagar, Pune - 411014", outstanding: 0, limit: 5000 },
    { id: 5, name: "Ganesh Joshi", phone: "9811223344", address: "55 Deccan Gymkhana, Pune - 411004", outstanding: 0, limit: 0 }
];

let currentSelectedCustomer = {
    name: "Walk-in Customer",
    phone: "",
    address: "",
    outstanding: 0,
    limit: 10000
};

function changeOrderType(type) {
    document.getElementById('hiddenOrderType').value = type;
    const tableWrapper = document.getElementById('tableSelectWrapper');
    if (type === 'Dine-in') {
        tableWrapper.style.display = 'flex';
    } else {
        tableWrapper.style.display = 'none';
        document.getElementById('hiddenTableCode').value = type;
    }
}

function switchBillingTable(tableCode) {
    document.getElementById('hiddenTableCode').value = tableCode;
    window.location.href = '/Billing?table=' + encodeURIComponent(tableCode);
}

function handleQuickItemKeyDown(e) {
    if (e.key === 'Enter') {
        e.preventDefault();
        const query = e.target.value.trim().toLowerCase();
        if (!query) return;

        const match = menuCatalog.find(m => m.code === query || m.name.toLowerCase().includes(query));
        if (match) {
            addItemToBillingTable(match.name, match.price);
            e.target.value = '';
        } else {
            if (window.Swal) {
                Swal.fire({ icon: 'info', text: 'Item not found. Try codes 101 to 113 or click Browse Dishes.' });
            } else {
                alert('Item not found. Try codes 101 to 113.');
            }
        }
    }
}

function addItemToBillingTable(name, rate) {
    const tbody = document.getElementById('billingItemsBody');
    const existingRow = tbody.querySelector(`tr[data-name="${name}"]`);

    if (existingRow) {
        const qtyInput = existingRow.querySelector('.input-qty');
        qtyInput.value = parseInt(qtyInput.value) + 1;
        recalcBillingRow(qtyInput);
    } else {
        const rowCount = tbody.querySelectorAll('tr').length + 1;
        const tr = document.createElement('tr');
        tr.setAttribute('data-rate', rate);
        tr.setAttribute('data-name', name);
        tr.innerHTML = `
            <td class="text-muted small row-num">${rowCount}</td>
            <td>
                <div class="fw-semibold text-ink">${name}</div>
            </td>
            <td>
                <div class="input-group input-group-sm quantity-input-group justify-content-center">
                    <button class="btn btn-outline-secondary btn-qty-minus py-0 px-2" type="button" onclick="updateItemQty(this, -1)">-</button>
                    <input type="number" class="form-control text-center input-qty py-0 px-1" style="max-width: 48px;" value="1" min="1" max="99" onchange="recalcBillingRow(this)" />
                    <button class="btn btn-outline-secondary btn-qty-plus py-0 px-2" type="button" onclick="updateItemQty(this, 1)">+</button>
                </div>
            </td>
            <td class="text-end font-monospace">₹${rate.toFixed(2)}</td>
            <td class="text-end fw-bold font-monospace text-ink item-total">₹${rate.toFixed(2)}</td>
            <td class="text-center">
                <button type="button" class="btn btn-link text-chili p-0" onclick="removeBillingRow(this)" title="Remove item">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;
        tbody.appendChild(tr);
        recalculateTotals();
    }

    document.getElementById('emptyBillingItemsMsg').classList.add('d-none');
}

function updateItemQty(btn, change) {
    const input = btn.closest('.quantity-input-group').querySelector('.input-qty');
    const cur = parseInt(input.value) || 1;
    input.value = Math.max(1, cur + change);
    recalcBillingRow(input);
}

function recalcBillingRow(input) {
    const row = input.closest('tr');
    const rate = parseFloat(row.getAttribute('data-rate')) || 0;
    const qty = parseInt(input.value) || 1;
    const total = rate * qty;
    row.querySelector('.item-total').textContent = '₹' + total.toFixed(2);
    recalculateTotals();
}

function removeBillingRow(btn) {
    btn.closest('tr').remove();
    const rows = document.querySelectorAll('#billingItemsBody tr');
    rows.forEach((r, idx) => {
        r.querySelector('.row-num').textContent = (idx + 1);
    });

    if (rows.length === 0) {
        document.getElementById('emptyBillingItemsMsg').classList.remove('d-none');
    }
    recalculateTotals();
}

function recalculateTotals() {
    let subtotal = 0;
    document.querySelectorAll('#billingItemsBody tr').forEach(row => {
        const rate = parseFloat(row.getAttribute('data-rate')) || 0;
        const qty = parseInt(row.querySelector('.input-qty').value) || 1;
        subtotal += (rate * qty);
    });

    const cgst = subtotal * 0.025;
    const sgst = subtotal * 0.025;
    const discount = parseFloat(document.getElementById('discountInput').value) || 0;
    const rawTotal = subtotal + cgst + sgst - discount;
    const grandTotal = Math.max(0, Math.round(rawTotal));
    const roundOff = grandTotal - rawTotal;

    document.getElementById('summarySubtotal').textContent = '₹' + subtotal.toFixed(2);
    document.getElementById('summaryCgst').textContent = '₹' + cgst.toFixed(2);
    document.getElementById('summarySgst').textContent = '₹' + sgst.toFixed(2);
    document.getElementById('summaryRoundOff').textContent = '₹' + roundOff.toFixed(2);
    document.getElementById('summaryGrandTotal').textContent = '₹' + grandTotal.toFixed(2);
    document.getElementById('hiddenGrandTotal').value = grandTotal;

    recalculateCreditSplit();
}

function searchBillingCustomer(query) {
    const dropdown = document.getElementById('billingCustomerResults');
    if (!query || query.trim().length === 0) {
        dropdown.style.display = 'none';
        return;
    }

    const q = query.toLowerCase().trim();
    const matches = localCustomers.filter(c => c.name.toLowerCase().includes(q) || c.phone.includes(q));

    if (matches.length === 0) {
        dropdown.innerHTML = `<div class="p-2 text-muted small text-center">No customer found. <button type="button" class="btn btn-link btn-sm p-0 fw-bold text-plum" onclick="openQuickAddFromSearch('${query}')">+ Add as New</button></div>`;
        dropdown.style.display = 'block';
        return;
    }

    dropdown.innerHTML = matches.map(c => `
        <a href="javascript:void(0)" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-3" onclick="selectBillingCustomer(${c.id})">
            <div>
                <div class="fw-bold text-ink">${c.name}</div>
                <small class="text-muted font-monospace"><i class="bi bi-telephone me-1"></i>${c.phone}</small>
                <div class="small text-muted text-truncate" style="max-width: 250px;">${c.address || 'No address'}</div>
            </div>
            <div class="text-end">
                <span class="badge ${c.outstanding > 0 ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success'}">Bal: ₹${c.outstanding}</span>
                <div class="small text-muted font-monospace">Limit: ₹${c.limit}</div>
            </div>
        </a>
    `).join('');
    dropdown.style.display = 'block';
}

function selectBillingCustomer(id) {
    const customer = localCustomers.find(c => c.id === id);
    if (!customer) return;

    currentSelectedCustomer = customer;
    document.getElementById('selectedCustomerName').textContent = customer.name;
    document.getElementById('selectedCustomerPhone').textContent = customer.phone;
    document.getElementById('selectedCustomerAddress').textContent = customer.address || 'No address';
    document.getElementById('customerCreditBadge').textContent = 'Outstanding: ₹' + customer.outstanding.toLocaleString();
    document.getElementById('customerLimitDisplay').textContent = 'Limit: ₹' + customer.limit.toLocaleString();
    document.getElementById('billingCustomerSearch').value = customer.name + ' (' + customer.phone + ')';
    document.getElementById('billingCustomerResults').style.display = 'none';

    document.getElementById('hiddenCustomerName').value = customer.name;
    document.getElementById('hiddenCustomerPhone').value = customer.phone;
    document.getElementById('hiddenCustomerAddress').value = customer.address || '';

    document.getElementById('billingCustomerCard').classList.remove('border', 'border-danger');
}

function clearCustomerSearch() {
    currentSelectedCustomer = { name: "Walk-in Customer", phone: "", address: "", outstanding: 0, limit: 10000 };
    document.getElementById('selectedCustomerName').textContent = "Walk-in Customer";
    document.getElementById('selectedCustomerPhone').textContent = "No mobile linked";
    document.getElementById('selectedCustomerAddress').textContent = "No address linked";
    document.getElementById('customerCreditBadge').textContent = 'Outstanding: ₹0';
    document.getElementById('customerLimitDisplay').textContent = 'Limit: ₹10,000';
    document.getElementById('billingCustomerSearch').value = '';
    document.getElementById('billingCustomerResults').style.display = 'none';

    document.getElementById('hiddenCustomerName').value = "Walk-in Customer";
    document.getElementById('hiddenCustomerPhone').value = "";
    document.getElementById('hiddenCustomerAddress').value = "";
}

function openQuickAddFromSearch(query) {
    document.getElementById('billingCustomerResults').style.display = 'none';
    if (/^\d+$/.test(query)) {
        document.getElementById('quickCustPhone').value = query;
        document.getElementById('quickCustName').value = '';
    } else {
        document.getElementById('quickCustName').value = query;
        document.getElementById('quickCustPhone').value = '';
    }
    bootstrap.Modal.getOrCreateInstance(document.getElementById('quickAddCustomerModal')).show();
}

function saveAndSelectQuickCustomer() {
    const name = document.getElementById('quickCustName').value.trim();
    const phone = document.getElementById('quickCustPhone').value.trim();
    const address = document.getElementById('quickCustAddress').value.trim();
    const limit = parseFloat(document.getElementById('quickCustLimit').value) || 10000;

    if (!name) {
        if (window.Swal) Swal.fire({ icon: 'warning', text: 'Customer name is required.' });
        else alert('Customer name is required.');
        return;
    }

    if (!phone || !/^[6-9]\d{9}$/.test(phone)) {
        if (window.Swal) Swal.fire({ icon: 'warning', text: 'Please enter a valid 10-digit Indian mobile number.' });
        else alert('Please enter a valid 10-digit mobile number.');
        return;
    }

    if (!address || address.length < 4) {
        if (window.Swal) Swal.fire({ icon: 'warning', text: 'Customer physical address is required for credit/udhari accounts.' });
        else alert('Customer physical address is required.');
        return;
    }

    const newCust = { id: Date.now(), name: name, phone: phone, address: address, outstanding: 0, limit: limit };
    localCustomers.push(newCust);
    selectBillingCustomer(newCust.id);

    bootstrap.Modal.getInstance(document.getElementById('quickAddCustomerModal')).hide();
    document.getElementById('quickCustName').value = '';
    document.getElementById('quickCustPhone').value = '';
    document.getElementById('quickCustAddress').value = '';

    if (window.Swal) {
        Swal.fire({ icon: 'success', title: 'Customer Linked!', text: `${name} (${phone}) selected with address.`, timer: 2000, showConfirmButton: false });
    }
}

function togglePaymentInputs() {
    const isCredit = document.getElementById('payUdhari') && document.getElementById('payUdhari').checked;
    const creditSection = document.getElementById('creditDetailsSection');
    const customerCard = document.getElementById('billingCustomerCard');
    const mandatoryBadge = document.getElementById('udhariMandatoryBadge');

    if (creditSection) {
        creditSection.style.display = isCredit ? 'block' : 'none';
    }
    if (mandatoryBadge) {
        mandatoryBadge.style.display = isCredit ? 'inline-block' : 'none';
    }

    if (isCredit) {
        customerCard.classList.add('border', 'border-warning', 'bg-warning-subtle');
        if (currentSelectedCustomer.name === 'Walk-in Customer') {
            document.getElementById('billingCustomerSearch').focus();
        }
    } else {
        customerCard.classList.remove('border', 'border-warning', 'bg-warning-subtle');
    }
    recalculateCreditSplit();
}

function recalculateCreditSplit() {
    const grandTotal = parseFloat(document.getElementById('hiddenGrandTotal').value) || 0;
    const paidInput = document.getElementById('paidAmountInput');
    const creditInput = document.getElementById('creditAmountInput');
    if (paidInput && creditInput) {
        const paid = parseFloat(paidInput.value) || 0;
        creditInput.value = Math.max(0, grandTotal - paid).toFixed(2);
    }
}

function handleHoldBill() {
    const grandTotal = document.getElementById('summaryGrandTotal').textContent;
    if (window.Swal) {
        Swal.fire({
            icon: 'info',
            title: 'Bill Held',
            text: `Active ticket with total ${grandTotal} has been put on hold. You can resume it anytime.`
        });
    } else {
        alert(`Bill held with total ${grandTotal}.`);
    }
}

function settleBillWithReceipt() {
    const isCredit = document.getElementById('payUdhari') && document.getElementById('payUdhari').checked;
    const itemsCount = document.querySelectorAll('#billingItemsBody tr').length;

    if (itemsCount === 0) {
        if (window.Swal) {
            Swal.fire({ icon: 'warning', title: 'Empty Bill', text: 'Please add at least one item to settle this bill.' });
        } else {
            alert('Please add at least one item to settle this bill.');
        }
        return;
    }

    // MANDATORY UDHARI VALIDATION
    if (isCredit) {
        if (!currentSelectedCustomer.name || currentSelectedCustomer.name === 'Walk-in Customer') {
            document.getElementById('billingCustomerCard').classList.add('border', 'border-danger');
            if (window.Swal) {
                Swal.fire({
                    icon: 'error',
                    title: 'Customer Mandatory for Udhari',
                    text: 'When selecting Udhari (Credit), customer selection is strictly mandatory. Please search an existing customer or click "+ Quick Add Customer".'
                });
            } else {
                alert('Customer selection is mandatory for Udhari.');
            }
            document.getElementById('billingCustomerSearch').focus();
            return;
        }

        if (!currentSelectedCustomer.phone || currentSelectedCustomer.phone.length < 10) {
            document.getElementById('billingCustomerCard').classList.add('border', 'border-danger');
            if (window.Swal) {
                Swal.fire({
                    icon: 'error',
                    title: 'Valid Mobile Number Mandatory',
                    text: 'Selected customer must have a valid 10-digit mobile number for Udhari billing.'
                });
            } else {
                alert('Valid 10-digit mobile number is mandatory for Udhari.');
            }
            return;
        }

        if (!currentSelectedCustomer.address || currentSelectedCustomer.address.trim().length < 4) {
            document.getElementById('billingCustomerCard').classList.add('border', 'border-danger');
            if (window.Swal) {
                Swal.fire({
                    icon: 'error',
                    title: 'Customer Address Mandatory',
                    text: 'Customer physical address is mandatory for Udhari (Credit) accounts.'
                });
            } else {
                alert('Customer physical address is mandatory for Udhari.');
            }
            return;
        }
    }

    // Populate thermal preview
    populateThermalBillData();

    // Confirm and submit
    if (window.Swal) {
        const payMode = isCredit ? 'UDHARI (Credit)' : document.querySelector('input[name="paymentMode"]:checked')?.value || 'Cash';
        const total = document.getElementById('summaryGrandTotal').textContent;

        Swal.fire({
            title: `Settle Bill for ${total}?`,
            text: `Payment Mode: ${payMode} | Customer: ${currentSelectedCustomer.name}`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0B7A70',
            cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="bi bi-printer me-1"></i> Yes, Settle & Submit',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('settlementForm').submit();
            }
        });
    } else {
        if (confirm('Settle bill and submit?')) {
            document.getElementById('settlementForm').submit();
        }
    }
}

function openThermalBillPreview() {
    populateThermalBillData();
    bootstrap.Modal.getOrCreateInstance(document.getElementById('thermalBillModal')).show();
}

function populateThermalBillData() {
    const grandTotal = document.getElementById('summaryGrandTotal')?.textContent || '₹0.00';
    const subtotal = document.getElementById('summarySubtotal')?.textContent || '₹0.00';
    const cgst = document.getElementById('summaryCgst')?.textContent || '₹0.00';
    const sgst = document.getElementById('summarySgst')?.textContent || '₹0.00';
    const discount = document.getElementById('discountInput')?.value || '0';

    document.getElementById('printGrandTotal').textContent = grandTotal;
    document.getElementById('printSubtotal').textContent = subtotal;
    document.getElementById('printCgst').textContent = cgst;
    document.getElementById('printSgst').textContent = sgst;
    document.getElementById('printDiscount').textContent = '- ₹' + parseFloat(discount).toFixed(2);

    const isCredit = document.getElementById('payUdhari') && document.getElementById('payUdhari').checked;
    const isUpi = document.getElementById('payUpi') && document.getElementById('payUpi').checked;
    const isCard = document.getElementById('payCard') && document.getElementById('payCard').checked;
    const isSplit = document.getElementById('paySplit') && document.getElementById('paySplit').checked;
    const payMode = isCredit ? 'UDHARI (Credit)' : isSplit ? 'Split (Cash + UPI)' : isUpi ? 'UPI Online' : isCard ? 'Credit/Debit Card' : 'Cash';

    document.getElementById('printPayMode').textContent = payMode;
    document.getElementById('printCustomerName').textContent = currentSelectedCustomer.name || 'Walk-in Customer';
    document.getElementById('printCustomerMobile').textContent = currentSelectedCustomer.phone || '-';

    // Populate Items
    const printTbody = document.getElementById('printItemsTbody');
    if (printTbody) {
        printTbody.innerHTML = '';
        document.querySelectorAll('#billingItemsBody tr').forEach(row => {
            const name = row.getAttribute('data-name') || 'Dish';
            const rate = parseFloat(row.getAttribute('data-rate')) || 0;
            const qty = parseInt(row.querySelector('.input-qty').value) || 1;
            const amt = rate * qty;

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="text-start py-1">${name}</td>
                <td class="text-center py-1">${qty}</td>
                <td class="text-end py-1">${rate.toFixed(2)}</td>
                <td class="text-end py-1">${amt.toFixed(2)}</td>
            `;
            printTbody.appendChild(tr);
        });
    }

    const udhariRow = document.getElementById('printUdhariBalanceRow');
    if (isCredit) {
        if (udhariRow) udhariRow.style.display = 'block';
        document.getElementById('printPrevOutstanding').textContent = '₹' + currentSelectedCustomer.outstanding.toFixed(2);
        const billVal = parseFloat(grandTotal.replace(/[^0-9.]/g, '')) || 0;
        document.getElementById('printTotalUdhari').textContent = '₹' + (currentSelectedCustomer.outstanding + billVal).toFixed(2);
        document.getElementById('printPayStatus').textContent = 'CREDIT (DUE)';
        document.getElementById('printPayStatus').className = 'fw-bold text-danger';
    } else {
        if (udhariRow) udhariRow.style.display = 'none';
        document.getElementById('printPayStatus').textContent = 'PAID';
        document.getElementById('printPayStatus').className = 'fw-bold text-success';
    }
}

// Render Browse Dishes Grid
document.addEventListener('DOMContentLoaded', function() {
    const grid = document.getElementById('browseDishesGrid');
    if (grid) {
        grid.innerHTML = menuCatalog.map(m => `
            <div class="col-6 col-md-4">
                <div class="card h-100 p-2 border border-light-subtle shadow-sm cursor-pointer hover-shadow" onclick="addItemToBillingTable('${m.name}', ${m.price})" style="cursor: pointer;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="badge bg-secondary-subtle text-dark font-monospace">${m.code}</span>
                        <span class="badge bg-plum-subtle text-plum small">${m.cat}</span>
                    </div>
                    <div class="fw-bold text-ink small text-truncate">${m.name}</div>
                    <div class="fw-bold text-teal font-monospace mt-1">₹${m.price}</div>
                </div>
            </div>
        `).join('');
    }
});

// Close search dropdown on outside click
document.addEventListener('click', function(e) {
    const results = document.getElementById('billingCustomerResults');
    const search = document.getElementById('billingCustomerSearch');
    if (results && !results.contains(e.target) && e.target !== search) {
        results.style.display = 'none';
    }
});
</script>
