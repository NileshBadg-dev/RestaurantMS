@using System.Text.Json
@using RestaurantMS.Application.Common.Models.UiData
@model RestaurantMS.Web.Models.BillingPanelModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<RestaurantMS.Web.SharedResource> Localizer
@{
    var tables = ViewBag.AvailableTables as IReadOnlyList<TableItemDto> ?? [];
    var isDineIn = !Model.Order.OrderType.Equals("Parcel", StringComparison.OrdinalIgnoreCase)
                   && !Model.Order.OrderType.Equals("Delivery", StringComparison.OrdinalIgnoreCase);

    var billingConfig = new
    {
        settleUrl = Model.SettleActionUrl,
        calculateUrl = Model.CalculateActionUrl,
        previewDraftUrl = Model.PrintActionUrl,
        searchCustomersUrl = Url.Action("SearchCustomers", "Billing") ?? "/Billing/SearchCustomers",
        quickAddCustomerUrl = Url.Action("QuickAddCustomer", "Billing") ?? "/Billing/QuickAddCustomer",
        upiQrUrl = Url.Action("UpiQrSvg", "Receipt") ?? "/Receipt/UpiQrSvg",
        hotelName = Model.HotelName,
        hotelUpiId = Model.HotelUpiId,
        upiReferenceRequired = Model.UpiReferenceRequired,
        cardDetailsRequired = Model.CardDetailsRequired,
        autoPrintOnSettle = Model.AutoPrintOnSettle,
        paperSize = Model.PaperSize,
        canOverrideCreditLimit = Model.CanOverrideCreditLimit,
        gstPercent = Model.Order.GstPercent,
        orderType = Model.Order.OrderType,
        tableCode = Model.Order.TableCode,
        messages = new
        {
            cashUnderpaid = Localizer["Billing_Err_CashUnderpaid"].Value,
            upiRefRequired = Localizer["Billing_Err_UpiRefRequired"].Value,
            upiConfirmRequired = Localizer["Billing_Err_UpiConfirmRequired"].Value,
            cardLast4Required = Localizer["Billing_Err_CardLast4Required"].Value,
            cardApprovalRequired = Localizer["Billing_Err_CardApprovalRequired"].Value,
            splitMismatch = Localizer["Billing_Err_SplitMismatch"].Value,
            udhariCustomerRequired = Localizer["Billing_Err_UdhariCustomerRequired"].Value,
            creditLimitExceeded = Localizer["Billing_Err_CreditLimitExceeded"].Value,
            creditDisabled = Localizer["Billing_Err_CreditDisabled"].Value,
            overrideReasonRequired = Localizer["Billing_Err_OverrideReasonRequired"].Value,
            emptyItems = Localizer["Billing_Err_EmptyItems"].Value,
            balanceDue = Localizer["Billing_BalanceDue"].Value,
            changeToReturn = Localizer["Billing_ChangeToReturn"].Value
        }
    };

    var initialItems = Model.Order.Items.Select(i => new
    {
        itemName = i.ItemName,
        marathiName = (string?)null,
        quantity = i.Quantity,
        rate = i.Rate,
        notes = i.Notes
    });

    var catalogPayload = Model.MenuCatalog.Select((m, idx) => new
    {
        id = m.Id,
        shortCode = $"M{m.Id:D2}",
        name = m.Name,
        marathiName = m.MarathiName,
        category = m.CategoryName,
        price = m.Price,
        isVeg = m.IsVegetarian,
        imageUrl = m.ImageUrl
    });

    var customersPayload = Model.Customers.Select(c => new
    {
        id = c.Id,
        name = c.Name,
        mobile = c.Mobile,
        address = c.Address ?? "",
        creditAllowed = c.CreditAllowed,
        creditLimit = c.CreditLimit,
        outstandingBalance = c.OutstandingBalance
    });

    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

<div class="billing-panel-root" id="billingPanelRoot">
    @Html.AntiForgeryToken()

    <script type="application/json" id="billingConfigJson">@Html.Raw(JsonSerializer.Serialize(billingConfig, jsonOptions))</script>
    <script type="application/json" id="billingInitialItemsJson">@Html.Raw(JsonSerializer.Serialize(initialItems, jsonOptions))</script>
    <script type="application/json" id="billingMenuCatalogJson">@Html.Raw(JsonSerializer.Serialize(catalogPayload, jsonOptions))</script>
    <script type="application/json" id="billingCustomersJson">@Html.Raw(JsonSerializer.Serialize(customersPayload, jsonOptions))</script>

    <div class="row g-3">
        <!-- LEFT COLUMN: Order Details, Items, Quick Add, Discount & Packing -->
        <div class="col-12 col-xl-7">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-white border-bottom py-3 px-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <!-- Order Type Segmented Switch -->
                        <div class="btn-group btn-group-sm" role="group" aria-label="Order Type">
                            <input type="radio" class="btn-check" name="billingOrderType" id="orderTypeDineIn" value="Dine-in" @(isDineIn ? "checked" : "") autocomplete="off" />
                            <label class="btn btn-outline-plum px-3" for="orderTypeDineIn">
                                <i class="bi bi-shop"></i> @Localizer["OrderType_DineIn"]
                            </label>

                            <input type="radio" class="btn-check" name="billingOrderType" id="orderTypeParcel" value="Parcel" @(Model.Order.OrderType.Equals("Parcel", StringComparison.OrdinalIgnoreCase) ? "checked" : "") autocomplete="off" />
                            <label class="btn btn-outline-plum px-3" for="orderTypeParcel">
                                <i class="bi bi-bag"></i> @Localizer["OrderType_Parcel"]
                            </label>

                            <input type="radio" class="btn-check" name="billingOrderType" id="orderTypeDelivery" value="Delivery" @(Model.Order.OrderType.Equals("Delivery", StringComparison.OrdinalIgnoreCase) ? "checked" : "") autocomplete="off" />
                            <label class="btn btn-outline-plum px-3" for="orderTypeDelivery">
                                <i class="bi bi-bicycle"></i> @Localizer["OrderType_Delivery"]
                            </label>
                        </div>

                        <!-- Table Selector (Hidden for Parcel / Delivery) -->
                        <div class="d-flex align-items-center gap-2 @(isDineIn ? "" : "d-none")" id="billingTableSelectorWrap">
                            <label for="billingTableSelect" class="small fw-semibold text-muted mb-0">@Localizer["Billing_Table"]:</label>
                            <select id="billingTableSelect" class="form-select form-select-sm" style="width: 150px;">
                                @if (tables.Count == 0)
                                {
                                    <option value="@Model.Order.TableCode" selected>@Model.Order.TableCode</option>
                                }
                                else
                                {
                                    @foreach (var t in tables)
                                    {
                                        if (t.TableCode.Equals(Model.Order.TableCode, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@t.TableCode" selected>@t.TableCode (@t.Section)</option>
                                        }
                                        else
                                        {
                                            <option value="@t.TableCode">@t.TableCode (@t.Section)</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <!-- Parcel Token Badge (Shown for Parcel / Delivery) -->
                        <div class="badge bg-saffron-subtle text-dark px-3 py-2 @(isDineIn ? "d-none" : "")" id="billingParcelBadge">
                            <i class="bi bi-ticket-perforated me-1"></i> @Localizer["Billing_NoTableRequired"]
                        </div>
                    </div>
                </div>

                <div class="card-body p-3 d-flex flex-column gap-3">
                    <!-- Quick Add by Short Code or Browse Dishes -->
                    <div class="d-flex flex-wrap gap-2 align-items-center bg-cream p-2 rounded border">
                        <div class="input-group input-group-sm flex-grow-1" style="min-width: 210px;">
                            <span class="input-group-text bg-white"><i class="bi bi-upc-scan text-plum"></i></span>
                            <input type="text"
                                   id="billingShortCodeInput"
                                   class="form-control"
                                   placeholder="@Localizer["Billing_ShortCodePlaceholder"]"
                                   autocomplete="off" />
                            <button type="button" class="btn btn-plum" id="btnAddByShortCode">
                                <i class="bi bi-plus-lg"></i> @Localizer["Btn_Add"]
                            </button>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-plum" data-bs-toggle="modal" data-bs-target="#billingCatalogModal">
                            <i class="bi bi-grid-3x3-gap"></i> @Localizer["Billing_BrowseMenu"]
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPreviewDraftBill">
                            <i class="bi bi-eye"></i> @Localizer["Billing_PreviewBill"]
                        </button>
                    </div>

                    <!-- Order Items Table -->
                    <div class="table-responsive border rounded">
                        <table class="table table-sm table-hover align-middle mb-0" id="billingItemsTable">
                            <thead class="table-light small text-muted text-uppercase">
                                <tr>
                                    <th>@Localizer["Billing_Item"]</th>
                                    <th class="text-center" style="width: 115px;">@Localizer["Billing_Qty"]</th>
                                    <th class="text-end" style="width: 90px;">@Localizer["Billing_Rate"]</th>
                                    <th class="text-end" style="width: 100px;">@Localizer["Billing_Amount"]</th>
                                    <th class="text-center" style="width: 44px;"></th>
                                </tr>
                            </thead>
                            <tbody id="billingItemsBody">
                                <!-- Rendered by billing.js -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Discount, Packing Charge & GST Controls -->
                    <div class="row g-2 bg-light p-2 rounded border">
                        <div class="col-6 col-md-4">
                            <label for="billingDiscountInput" class="form-label small fw-semibold text-muted mb-1">
                                <i class="bi bi-tag me-1"></i> @Localizer["Billing_Discount"] (₹)
                            </label>
                            <input type="number" id="billingDiscountInput" class="form-control form-control-sm font-monospace" value="0" min="0" step="1" />
                        </div>
                        <div class="col-6 col-md-4">
                            <label for="billingPackingInput" class="form-label small fw-semibold text-muted mb-1">
                                <i class="bi bi-box-seam me-1"></i> @Localizer["Billing_PackingCharge"] (₹)
                            </label>
                            <input type="number" id="billingPackingInput" class="form-control form-control-sm font-monospace" value="0" min="0" step="5" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="billingGstSelect" class="form-label small fw-semibold text-muted mb-1">
                                <i class="bi bi-percent me-1"></i> @Localizer["Billing_GstRate"]
                            </label>
                            <select id="billingGstSelect" class="form-select form-select-sm font-monospace">
                                <option value="0">0% (Exempt)</option>
                                <option value="5" selected>5% (2.5% + 2.5%)</option>
                                <option value="12">12% (6% + 6%)</option>
                                <option value="18">18% (9% + 9%)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Customer Picker (Always available, highlighted when Udhari selected) -->
                    @if (Model.ShowCustomerPicker)
                    {
                        <div id="billingCustomerSection">
                            <partial name="_CustomerPicker" model='new RestaurantMS.Web.Models.CustomerPickerModel { FieldName = "CustomerId" }' />
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Totals Card + 5 Payment Modes + Settle Action -->
        <div class="col-12 col-xl-5">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-body p-3 d-flex flex-column gap-3">
                    <!-- Live Totals Panel -->
                    <div class="p-3 rounded-3 bg-cream border">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>@Localizer["Billing_Subtotal"]</span>
                            <span class="font-monospace" id="summarySubtotal">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between small text-chili mb-1 d-none" id="summaryDiscountRow">
                            <span>@Localizer["Billing_Discount"]</span>
                            <span class="font-monospace" id="summaryDiscount">- ₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-1 d-none" id="summaryPackingRow">
                            <span>@Localizer["Billing_PackingCharge"]</span>
                            <span class="font-monospace" id="summaryPacking">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span id="summaryTaxLabel">GST (CGST + SGST)</span>
                            <span class="font-monospace" id="summaryTax">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-2 d-none" id="summaryRoundOffRow">
                            <span>@Localizer["Billing_RoundOff"]</span>
                            <span class="font-monospace" id="summaryRoundOff">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="fw-bold text-ink fs-6">@Localizer["Billing_PayableTotal"]</span>
                            <span class="fw-bold text-plum font-monospace fs-3" id="summaryGrandTotal">₹0.00</span>
                        </div>
                    </div>

                    <!-- Payment Mode Selector Chips -->
                    <div>
                        <label class="form-label small fw-bold text-uppercase text-muted mb-2">
                            <i class="bi bi-wallet2 me-1"></i> @Localizer["Billing_PaymentMode"]
                        </label>
                        <div class="row g-2" id="paymentModeGroup" role="radiogroup" aria-label="Payment Mode">
                            <div class="col-4">
                                <input type="radio" class="btn-check" name="paymentMode" id="payModeCash" value="Cash" checked autocomplete="off" />
                                <label class="btn btn-outline-teal w-100 payment-mode-chip" for="payModeCash">
                                    <i class="bi bi-cash-stack"></i> @Localizer["PayMode_Cash"]
                                </label>
                            </div>
                            <div class="col-4">
                                <input type="radio" class="btn-check" name="paymentMode" id="payModeUpi" value="UPI" autocomplete="off" />
                                <label class="btn btn-outline-plum w-100 payment-mode-chip" for="payModeUpi">
                                    <i class="bi bi-qr-code-scan"></i> @Localizer["PayMode_UPI"]
                                </label>
                            </div>
                            <div class="col-4">
                                <input type="radio" class="btn-check" name="paymentMode" id="payModeCard" value="Card" autocomplete="off" />
                                <label class="btn btn-outline-plum w-100 payment-mode-chip" for="payModeCard">
                                    <i class="bi bi-credit-card"></i> @Localizer["PayMode_Card"]
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="paymentMode" id="payModeSplit" value="Split" autocomplete="off" />
                                <label class="btn btn-outline-saffron w-100 payment-mode-chip" for="payModeSplit">
                                    <i class="bi bi-pie-chart"></i> @Localizer["PayMode_Split"]
                                </label>
                            </div>
                            @if (Model.EnableCreditPayment)
                            {
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="paymentMode" id="payModeUdhari" value="Udhari" autocomplete="off" />
                                    <label class="btn btn-outline-chili w-100 payment-mode-chip" for="payModeUdhari">
                                        <i class="bi bi-journal-bookmark"></i> @Localizer["PayMode_Udhari"]
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- MODE 1: CASH PANEL -->
                    <div class="billing-mode-panel" id="panelCash" data-mode-panel="Cash">
                        <label for="cashReceivedInput" class="form-label small fw-semibold text-ink mb-1">
                            @Localizer["Billing_AmountReceived"] (₹)
                        </label>
                        <div class="input-group mb-2">
                            <span class="input-group-text bg-white fw-bold">₹</span>
                            <input type="number" id="cashReceivedInput" class="form-control font-monospace fw-bold fs-5" min="0" step="1" value="0" />
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="button" class="btn btn-sm btn-outline-teal cash-quick-btn" data-cash-action="exact">@Localizer["Billing_Exact"]</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary cash-quick-btn" data-cash-add="100">+100</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary cash-quick-btn" data-cash-add="500">+500</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary cash-quick-btn" data-cash-add="2000">+2000</button>
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-2 rounded bg-white border" id="cashStatusBox">
                            <span class="small fw-semibold" id="cashStatusLabel">@Localizer["Billing_ChangeToReturn"]</span>
                            <strong class="font-monospace fs-5 text-teal" id="cashStatusAmount">₹0.00</strong>
                        </div>
                    </div>

                    <!-- MODE 2: UPI PANEL -->
                    <div class="billing-mode-panel d-none" id="panelUpi" data-mode-panel="UPI">
                        <div class="d-flex gap-3 align-items-center mb-2">
                            <div class="bg-white border rounded p-2 text-center" style="min-width: 120px;">
                                <img id="upiQrImg" src="" alt="UPI QR" style="width: 108px; height: 108px;" />
                                <div class="small text-muted font-monospace mt-1" id="upiIdDisplay">@Model.HotelUpiId</div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="small text-muted mb-1">@Localizer["Billing_UpiPayExact"]:</div>
                                <div class="fs-5 fw-bold text-plum font-monospace mb-2" id="upiAmountDisplay">₹0.00</div>
                                <label for="upiRefInput" class="form-label small fw-semibold mb-1">
                                    @Localizer["Billing_UpiRefLabel"]
                                    @if (Model.UpiReferenceRequired)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <input type="text" id="upiRefInput" class="form-control form-control-sm font-monospace mb-2" placeholder="e.g. 432198765432" />
                                <button type="button" class="btn btn-sm btn-outline-teal w-100" id="btnUpiPaymentReceived">
                                    <i class="bi bi-check2-circle"></i> @Localizer["Billing_UpiPaymentReceived"]
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- MODE 3: CARD PANEL -->
                    <div class="billing-mode-panel d-none" id="panelCard" data-mode-panel="Card">
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="cardLast4Input" class="form-label small fw-semibold mb-1">
                                    @Localizer["Billing_CardLast4"]
                                    @if (Model.CardDetailsRequired)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <input type="text" id="cardLast4Input" class="form-control form-control-sm font-monospace" maxlength="4" inputmode="numeric" placeholder="1234" />
                            </div>
                            <div class="col-6">
                                <label for="cardApprovalInput" class="form-label small fw-semibold mb-1">
                                    @Localizer["Billing_CardApprovalCode"]
                                    @if (Model.CardDetailsRequired)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <input type="text" id="cardApprovalInput" class="form-control form-control-sm font-monospace" maxlength="20" placeholder="e.g. AUTH9821" />
                            </div>
                            <div class="col-12">
                                <label for="cardBankInput" class="form-label small fw-semibold mb-1">
                                    @Localizer["Billing_CardBankMachine"]
                                </label>
                                <input type="text" id="cardBankInput" class="form-control form-control-sm" placeholder="e.g. HDFC POS / Pine Labs" />
                            </div>
                        </div>
                    </div>

                    <!-- MODE 4: SPLIT PANEL -->
                    <div class="billing-mode-panel d-none" id="panelSplit" data-mode-panel="Split">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-semibold text-ink">@Localizer["Billing_SplitRowsTitle"]</span>
                            <button type="button" class="btn btn-sm btn-outline-plum py-0 px-2" id="btnAddSplitRow">
                                <i class="bi bi-plus-circle"></i> @Localizer["Billing_AddRow"]
                            </button>
                        </div>
                        <div id="splitRowsContainer" class="d-flex flex-column gap-2 mb-2">
                            <!-- Split rows rendered by billing.js -->
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-2 rounded bg-white border small">
                            <span>@Localizer["Billing_Paid"]: <strong class="font-monospace" id="splitPaidTotal">₹0.00</strong></span>
                            <span id="splitRemainingWrap">@Localizer["Billing_Remaining"]: <strong class="font-monospace text-chili" id="splitRemainingTotal">₹0.00</strong></span>
                        </div>
                    </div>

                    <!-- MODE 5: UDHARI (CREDIT) PANEL -->
                    <div class="billing-mode-panel d-none" id="panelUdhari" data-mode-panel="Udhari">
                        <div class="alert alert-light border small py-2 px-2 mb-2" id="udhariCustomerHint">
                            <i class="bi bi-info-circle text-plum me-1"></i> @Localizer["Billing_UdhariSelectCustomerHint"]
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label for="udhariCreditAmountInput" class="form-label small fw-semibold mb-1">
                                    @Localizer["Billing_CreditAmount"] (₹)
                                </label>
                                <input type="number" id="udhariCreditAmountInput" class="form-control form-control-sm font-monospace fw-bold" min="0" step="1" value="0" />
                            </div>
                            <div class="col-6">
                                <label for="udhariBalanceModeSelect" class="form-label small fw-semibold mb-1">
                                    @Localizer["Billing_BalancePayMode"]
                                </label>
                                <select id="udhariBalanceModeSelect" class="form-select form-select-sm">
                                    <option value="Cash">Cash</option>
                                    <option value="UPI">UPI</option>
                                    <option value="Card">Card</option>
                                </select>
                            </div>
                        </div>
                        <div class="small text-muted mb-2 d-none" id="udhariPartPaySummary">
                            @Localizer["Billing_RemainingPayNow"]: <strong class="font-monospace text-teal" id="udhariPartPayAmount">₹0.00</strong>
                        </div>

                        <!-- Manager Override for Over-Limit Credit -->
                        <div class="border border-danger rounded p-2 bg-white d-none" id="udhariOverrideBox">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="udhariManagerOverrideCheck" />
                                <label class="form-check-label small fw-semibold text-chili" for="udhariManagerOverrideCheck">
                                    <i class="bi bi-shield-exclamation me-1"></i> @Localizer["Billing_ManagerOverride"]
                                </label>
                            </div>
                            <input type="text" id="udhariOverrideReasonInput" class="form-control form-control-sm d-none" placeholder="@Localizer["Billing_ManagerOverrideReasonPlaceholder"]" />
                        </div>

                        <div class="mt-2">
                            <input type="text" id="udhariNoteInput" class="form-control form-control-sm" placeholder="@Localizer["Billing_CreditNotePlaceholder"]" />
                        </div>
                    </div>

                    <!-- Live Inline Validation Message -->
                    <div class="alert alert-danger py-2 px-3 small mb-0 d-none" id="billingValidationAlert" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>
                        <span id="billingValidationText"></span>
                    </div>

                    <!-- Settle & Print CTA -->
                    <div class="mt-auto d-flex flex-column gap-2">
                        <button type="button" class="btn btn-teal btn-lg w-100 fw-bold py-2" id="btnSettleBill" disabled>
                            <i class="bi bi-check2-circle"></i>
                            <span id="btnSettleBillText">@Localizer["Billing_SettleAndPrint"]</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Browse Menu Catalog Modal -->
    <div class="modal fade" id="billingCatalogModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-plum text-white py-2">
                    <h6 class="modal-title fw-bold mb-0"><i class="bi bi-grid-3x3-gap me-1"></i> @Localizer["Billing_BrowseMenu"]</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <input type="text" id="catalogSearchInput" class="form-control form-control-sm mb-3" placeholder="@Localizer["Billing_SearchDishesPlaceholder"]" />
                    <div class="row g-2" id="billingCatalogGrid">
                        <!-- Rendered by billing.js -->
                    </div>
