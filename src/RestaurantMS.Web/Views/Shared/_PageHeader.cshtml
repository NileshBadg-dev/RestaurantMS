@model (string Title, string? Subtitle, string? ActionText, string? ActionUrl, string? ActionPermission, string? ActionIcon)

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1">@Model.Title</h2>
        @if (!string.IsNullOrEmpty(Model.Subtitle))
        {
            <p class="text-muted small mb-0">@Model.Subtitle</p>
        }
    </div>
    @if (!string.IsNullOrEmpty(Model.ActionText) && !string.IsNullOrEmpty(Model.ActionUrl))
    {
        <div>
            @if (!string.IsNullOrEmpty(Model.ActionPermission))
            {
                <a href="@Model.ActionUrl" class="btn btn-primary btn-sm px-3 shadow-sm" permission="@Model.ActionPermission">
                    @if (!string.IsNullOrEmpty(Model.ActionIcon))
                    {
                        <i class="bi @Model.ActionIcon me-1"></i>
                    }
                    @Model.ActionText
                </a>
            }
            else
            {
                <a href="@Model.ActionUrl" class="btn btn-primary btn-sm px-3 shadow-sm">
                    @if (!string.IsNullOrEmpty(Model.ActionIcon))
                    {
                        <i class="bi @Model.ActionIcon me-1"></i>
                    }
                    @Model.ActionText
                </a>
            }
        </div>
    }
</div>
