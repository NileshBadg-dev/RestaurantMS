@model RestaurantMS.Web.Models.FormLayoutModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<RestaurantMS.Web.SharedResource> Localizer

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="app-card shadow-sm">
            @if (!string.IsNullOrEmpty(Model.Title))
            {
                <div class="app-card-header mb-4">
                    <div>
                        <h4 class="app-card-title">@Model.Title</h4>
                        @if (!string.IsNullOrEmpty(Model.Subtitle))
                        {
                            <p class="text-muted small mb-0 mt-1">@Model.Subtitle</p>
                        }
                    </div>
                </div>
            }

            <form action="@Model.ActionUrl" method="post" enctype="@(Model.IsMultipart ? "multipart/form-data" : "application/x-www-form-urlencoded")" id="mainForm">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    @RenderBody()
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 pt-4 mt-4 border-top">
                    <a href="@Model.CancelUrl" class="btn btn-outline-secondary px-4">
                        @Localizer[Model.CancelButtonText]
                    </a>
                    @if (Model.ShowSaveAndNew)
                    {
                        <button type="submit" name="submitAction" value="saveAndNew" class="btn btn-teal px-4">
                            <i class="bi bi-plus-circle me-1"></i> @Localizer[Model.SaveAndNewButtonText]
                        </button>
                    }
                    <button type="submit" name="submitAction" value="save" class="btn btn-plum px-4">
                        <i class="bi bi-check2-circle me-1"></i> @Localizer[Model.SaveButtonText]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
