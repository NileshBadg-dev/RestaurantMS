@using Microsoft.AspNetCore.Localization
@{
    var cultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = cultureFeature?.RequestCulture.Culture.Name ?? "en-US";
    var isMarathi = currentCulture.StartsWith("mr", StringComparison.OrdinalIgnoreCase);

    var hotelName = isMarathi
        ? await SettingService.GetSettingAsync("HotelNameMr", "भव्य रेस्टॉरंट")
        : await SettingService.GetSettingAsync("HotelNameEn", "Grand Restaurant");

    var logoUrl = await SettingService.GetSettingAsync("LogoUrl", "/images/logo.png");
}
<!DOCTYPE html>
<html lang="@(isMarathi ? "mr" : "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - {hotelName}" : hotelName)</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- App Navbar -->
        <header class="app-navbar d-flex align-items-center justify-content-between px-3 sticky-top shadow-sm">
            <div class="d-flex align-items-center">
                <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center text-decoration-none text-dark me-3">
                    @if (!string.IsNullOrEmpty(logoUrl))
                    {
                        <img src="@logoUrl" alt="@hotelName" class="hotel-logo me-2" onerror="this.style.display='none'" />
                    }
                    <span class="fs-5 fw-bold text-primary">@hotelName</span>
                </a>
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- Language Toggle -->
                <form asp-controller="Language" asp-action="SetLanguage" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    @if (isMarathi)
                    {
                        <input type="hidden" name="culture" value="en-US" />
                        <button type="submit" class="btn btn-outline-primary btn-sm px-2 py-1">
                            <i class="bi bi-translate me-1"></i> English
                        </button>
                    }
                    else
                    {
                        <input type="hidden" name="culture" value="mr-IN" />
                        <button type="submit" class="btn btn-outline-primary btn-sm px-2 py-1">
                            <i class="bi bi-translate me-1"></i> मराठी
                        </button>
                    }
                </form>

                <!-- User Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-light btn-sm dropdown-toggle d-flex align-items-center gap-2 border" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle fs-5 text-secondary"></i>
                        <span class="fw-semibold">@CurrentUser.UserName</span>
                        <span class="badge bg-secondary-subtle text-secondary small">@(CurrentUser.Roles.FirstOrDefault() ?? "Staff")</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li>
                            <a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword">
                                <i class="bi bi-key me-2 text-primary"></i> @Localizer["Nav_ChangePassword"]
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger py-2 rounded">
                                    <i class="bi bi-box-arrow-right me-2"></i> @Localizer["Nav_Logout"]
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="d-flex">
            <!-- Sidebar -->
            <nav class="sidebar p-3 d-none d-md-block">
                @await Component.InvokeAsync("NavMenu")
            </nav>

            <!-- Main Content Area -->
            <main class="main-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <!-- Unauthenticated Fullpage Container (e.g. Login page) -->
        <main>
            @RenderBody()
        </main>
    }

    <partial name="_ConfirmModal" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
